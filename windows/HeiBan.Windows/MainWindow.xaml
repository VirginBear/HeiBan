<Window x:Class="HeiBan.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml" xmlns:views="using:HeiBan.Windows.Views" Title="HeiBan 黑板 · Windows">
 <Grid x:Name="Root" Background="#F2F4EF" RequestedTheme="Light" KeyDown="Root_KeyDown">
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Padding="12,0,140,0" Background="#F2F4EF">
   <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <Image Source="Assets/AppIcon.png" Width="20" Height="20"/>
    <TextBlock Text="黑板" VerticalAlignment="Center" FontWeight="SemiBold"/>
    <TextBlock x:Name="PortableBadge" Text="免安裝版" FontSize="11" VerticalAlignment="Center" Foreground="#39735A" Visibility="Collapsed"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="HomePanel" Grid.Row="1" Background="#FAFBF9">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibrarySidebarColumn" Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid x:Name="LibrarySidebar" Background="#ECF0E9" Padding="16,24,16,16" BorderBrush="#D7DFD4" BorderThickness="0,0,1,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="8">
     <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16"><Button x:Name="SidebarToggleButton" Style="{StaticResource ToolButtonStyle}" Click="SidebarToggle_Click" ToolTipService.ToolTip="收合／展開作品庫側欄"/><TextBlock x:Name="SidebarTitle" Text="作品庫" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <Button x:Name="AllLibraryButton" Tag="all" Click="LibrarySection_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent" Padding="8,10"><StackPanel Orientation="Horizontal" Spacing="10"><ContentControl x:Name="AllLibraryIcon"/><TextBlock x:Name="AllLibraryLabel" Text="所有作品"/></StackPanel></Button>
     <Button x:Name="FavoriteLibraryButton" Tag="favorites" Click="LibrarySection_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent" Padding="8,10"><StackPanel Orientation="Horizontal" Spacing="10"><ContentControl x:Name="FavoriteLibraryIcon"/><TextBlock x:Name="FavoriteLibraryLabel" Text="收藏"/></StackPanel></Button>
     <Button x:Name="TrashLibraryButton" Tag="trash" Click="LibrarySection_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent" Padding="8,10"><StackPanel Orientation="Horizontal" Spacing="10"><ContentControl x:Name="TrashLibraryIcon"/><TextBlock x:Name="TrashLibraryLabel" Text="垃圾桶"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="6">
     <Button x:Name="HomeScreenButton" Click="ScreenCanvas_Click" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,10" ToolTipService.ToolTip="我的螢幕就是我的畫布"><StackPanel Orientation="Horizontal" Spacing="10"><ContentControl x:Name="HomeScreenIcon"/><TextBlock x:Name="HomeScreenLabel" Text="螢幕畫布"/></StackPanel></Button>
     <Button x:Name="HomeGuideButton" Click="HomeGuide_Click" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,10"><StackPanel Orientation="Horizontal" Spacing="10"><ContentControl x:Name="HomeGuideIcon"/><TextBlock x:Name="HomeGuideLabel" Text="使用說明"/></StackPanel></Button>
     <Button x:Name="HomeAboutButton" Click="About_Click" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,10"><StackPanel Orientation="Horizontal" Spacing="10"><ContentControl x:Name="HomeAboutIcon"/><TextBlock x:Name="HomeAboutLabel" Text="關於黑板"/></StackPanel></Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Column="1" Padding="24" RowSpacing="18">
    <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
     <Image Source="Assets/Wordmark.png" Width="112" Height="60" HorizontalAlignment="Left" AutomationProperties.Name="黑板：手寫筆記 Logo"/>
     <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button x:Name="LibraryMultiButton" Click="LibraryMulti_Click" ToolTipService.ToolTip="選取多份作品" Style="{StaticResource ToolButtonStyle}"/>
      <Button Content="匯入" Click="Import_Click"/>
      <Button x:Name="HomeNewButton" Content="＋" Click="New_Click" Style="{StaticResource AccentButtonStyle}" Background="#39735A" BorderBrush="#39735A" ToolTipService.ToolTip="新增筆記或黑板"/>
      <TextBox x:Name="SearchBox" PlaceholderText="搜尋作品" Width="200" TextChanged="Search_Changed"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock x:Name="LibraryHeading" Text="我的作品" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="LibraryCount" FontSize="13" Foreground="#748075" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <ComboBox x:Name="LibraryFormatBox" Width="132" SelectedIndex="0" SelectionChanged="LibraryFilter_Changed" ToolTipService.ToolTip="格式篩選"><ComboBoxItem Content="全部格式"/><ComboBoxItem Content="筆記本"/><ComboBoxItem Content="無邊界筆記"/><ComboBoxItem Content="有邊界黑板"/></ComboBox>
      <ComboBox x:Name="LibrarySortBox" Width="112" SelectedIndex="0" SelectionChanged="LibraryFilter_Changed" ToolTipService.ToolTip="作品排序"><ComboBoxItem Content="最近修改"/><ComboBoxItem Content="建立日期"/><ComboBoxItem Content="名稱"/></ComboBox>
      <Button x:Name="LibrarySizeButton" Style="{StaticResource ToolButtonStyle}" Click="LibrarySize_Click" ToolTipService.ToolTip="縮圖大小"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="8"><TextBlock x:Name="LibraryTrashHint" Text="作品仍保留筆跡、圖片與頁面；點選作品可還原。" FontSize="12" Foreground="#748075" Visibility="Collapsed"/>
     <Border x:Name="LibrarySelectionBar" Visibility="Collapsed" Padding="10" CornerRadius="10" Background="#1739735A"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock x:Name="LibrarySelectedCount" Text="已選 0 份" VerticalAlignment="Center"/><Button Content="全選目前結果" Click="LibrarySelectAll_Click"/><Button x:Name="LibraryTrashSelectedButton" Content="移到垃圾桶" Click="LibraryTrashSelected_Click" IsEnabled="False"/><Button Content="完成" Click="LibraryMulti_Click"/></StackPanel></Border>
    </StackPanel>
    <Grid Grid.Row="3">
     <ListView x:Name="LibraryList" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False" SelectionChanged="LibrarySelection_Changed" IsItemClickEnabled="False" DoubleTapped="Library_DoubleTapped" ContextRequested="Library_ContextRequested" Padding="0">
      <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="12"/></ItemsPanelTemplate></ListView.ItemsPanel>
      <ListView.ItemTemplate><DataTemplate>
       <StackPanel Width="{Binding CardWidth}" Margin="0,0,16,20" Spacing="8">
        <Border CornerRadius="12" BorderThickness="1" BorderBrush="#D7DFD4"><Grid Height="{Binding ThumbnailHeight}" Background="{Binding Background}"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
         <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#EAF3F6EA" CornerRadius="8" Padding="6,3" Margin="7"><StackPanel Orientation="Horizontal" Spacing="4"><ContentControl Content="{Binding FormatIcon}"/><TextBlock Text="{Binding Format}" FontSize="11" Foreground="#285541" VerticalAlignment="Center"/></StackPanel></Border>
         <Button Content="{Binding FavoriteGlyph}" Tag="{Binding Board.Id}" Click="LibraryFavorite_Click" IsEnabled="{Binding CanFavorite}" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="14" Background="#EAF3F6EA" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" ToolTipService.ToolTip="加入／取消收藏"/>
        </Grid></Border>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentControl Content="{Binding SelectionMark}" Visibility="{Binding SelectionVisibility}"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="2" Content="⋯" Style="{StaticResource ToolButtonStyle}" Width="28" Height="24" Padding="0" Click="LibraryCardMenu_Click" ToolTipService.ToolTip="作品更多動作"/></Grid>
        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#748075" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
     <StackPanel x:Name="LibraryEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><TextBlock x:Name="LibraryEmptyTitle" Text="第一份作品，從這裡開始" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="使用搜尋或格式篩選，或按上方 ＋ 建立作品。" FontSize="13" Foreground="#748075"/></StackPanel>
    </Grid>
   </Grid>
  </Grid>
  <Grid x:Name="Workspace" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
   <Grid>

    <Grid x:Name="DrawingArea" SizeChanged="DrawingArea_SizeChanged" AllowDrop="True" DragOver="DrawingArea_DragOver" Drop="DrawingArea_Drop">
     <canvas:CanvasControl x:Name="CanvasSurface" Draw="CanvasSurface_Draw" CreateResources="CanvasSurface_CreateResources"
      PointerPressed="CanvasSurface_PointerPressed" PointerMoved="CanvasSurface_PointerMoved" PointerReleased="CanvasSurface_PointerReleased"
      PointerCanceled="CanvasSurface_PointerCanceled" PointerCaptureLost="CanvasSurface_PointerCanceled" PointerExited="CanvasSurface_PointerExited" PointerWheelChanged="CanvasSurface_PointerWheelChanged" DoubleTapped="CanvasSurface_DoubleTapped"/>
     <Canvas x:Name="TextOverlay" IsHitTestVisible="False"/>
     <Border x:Name="ToolBorder" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16" Padding="8" CornerRadius="16" Background="#FCFCFA" BorderThickness="1" BorderBrush="#D4DBD1">
      <StackPanel x:Name="ToolShell" Orientation="Horizontal" Spacing="8">
       <Border x:Name="ToolbarGrip" Width="24" Height="40" Background="Transparent" CornerRadius="6" ToolTipService.ToolTip="拖曳工具列；左右直排、上下橫排" PointerPressed="ToolbarGrip_Pressed" PointerMoved="ToolbarGrip_Moved" PointerReleased="ToolbarGrip_Released" PointerCanceled="ToolbarGrip_Canceled" PointerCaptureLost="ToolbarGrip_Canceled">
        <TextBlock Text="⋮⋮" Foreground="#829080" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <ScrollViewer x:Name="ToolScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
        <StackPanel x:Name="Tools" Orientation="Horizontal" Spacing="4"/>
       </ScrollViewer>
      </StackPanel>
     </Border>
     <Border x:Name="DockHint" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="12" Background="#2239735A" BorderBrush="#39735A" BorderThickness="2" Width="76" Height="180" Margin="12"><TextBlock x:Name="DockHintText" Text="直排" Foreground="#39735A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <Border x:Name="SelectionBar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="12" Background="#FCFCFA" BorderBrush="#D4DBD1" BorderThickness="1" Padding="4">
      <Border.RenderTransform><TranslateTransform x:Name="SelectionBarTransform"/></Border.RenderTransform>
      <StackPanel x:Name="SelectionBarTools" Orientation="Horizontal" Spacing="4"/>
     </Border>
     <Border x:Name="HUDOverlay" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="8" Background="#EBF1EA" BorderBrush="#39735A" BorderThickness="1" Padding="8,4">
      <Border.RenderTransform><TranslateTransform x:Name="HUDTransform"/></Border.RenderTransform>
      <TextBlock x:Name="HUDText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#26372F"/>
     </Border>
     <Button x:Name="InspectorBookmark" Click="Properties_Click" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12,0,0,12" Background="#FCFCFA" BorderBrush="#D4DBD1" Padding="9,14" ToolTipService.ToolTip="展開屬性檢查器"/>
    </Grid>
    <Border x:Name="Inspector" Visibility="Collapsed" Width="304" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="16" BorderBrush="#D4DBD1" BorderThickness="1" Background="#FCFCFA">
     <Grid RowSpacing="10" Padding="14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="Transparent" PointerPressed="InspectorGrip_Pressed" PointerMoved="InspectorGrip_Moved" PointerReleased="InspectorGrip_Released" PointerCanceled="InspectorGrip_Canceled" PointerCaptureLost="InspectorGrip_Canceled" ToolTipService.ToolTip="拖曳到上下左右停靠"><TextBlock Text="═  屬性" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>
       <Button Grid.Column="1" Content="停靠" Click="InspectorDock_Click" Padding="6,2"/><Button Grid.Column="2" x:Name="CloseInspectorButton" Click="Properties_Click" ToolTipService.ToolTip="收起屬性"/>
      </Grid>
      <TextBlock Grid.Row="1" x:Name="SelectionSummary" FontSize="12" Foreground="#68756C" TextWrapping="Wrap"/>
      <ScrollViewer Grid.Row="2" x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel x:Name="InspectorSections" Spacing="16">
        <StackPanel x:Name="StrokeSection" Spacing="8"><TextBlock Text="線條／文字色彩" FontWeight="SemiBold"/><StackPanel x:Name="StrokePalette" Orientation="Horizontal" Spacing="5"/><Button x:Name="StrokeColorButton" Click="StrokeColor_Click" HorizontalAlignment="Stretch"/></StackPanel>
        <StackPanel x:Name="LineSection" Spacing="8"><Slider x:Name="WidthSlider" Header="線條粗細" Minimum="0.5" Maximum="128" Value="4" StepFrequency="0.5"/><TextBlock x:Name="WidthValueText" FontSize="12"/><ComboBox x:Name="DashBox" Header="線條樣式" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="實線"/><ComboBoxItem Content="虛線"/><ComboBoxItem Content="點線"/><ComboBoxItem Content="點劃線"/></ComboBox></StackPanel>
        <StackPanel x:Name="FillSection" Spacing="8"><TextBlock Text="填色" FontWeight="SemiBold"/><StackPanel x:Name="FillPalette" Orientation="Horizontal" Spacing="5"/><Button x:Name="FillColorButton" Click="FillColor_Click" HorizontalAlignment="Stretch"/><CheckBox x:Name="FillToggle" Content="填滿圖形"/><Slider x:Name="FillOpacitySlider" Header="填色透明度" Minimum="0" Maximum="1" Value="1" StepFrequency="0.01" ValueChanged="FillOpacity_Changed"/><Button Content="填色漸層…" Click="FillGradient_Click"/></StackPanel>
        <StackPanel x:Name="ObjectSection" Spacing="8"><Slider x:Name="OpacitySlider" Header="透明度" Minimum="0" Maximum="1" Value="1" StepFrequency="0.01"/><NumberBox x:Name="RotationBox" Header="物件旋轉角度" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Inline"/><NumberBox x:Name="FontSizeBox" Header="字體大小" Value="18" Minimum="8" Maximum="200" SpinButtonPlacementMode="Inline"/></StackPanel>
        <StackPanel x:Name="EraserSection" Spacing="8"><TextBlock Text="橡皮擦" FontWeight="SemiBold"/><ComboBox x:Name="EraserModeBox" SelectedIndex="0"><ComboBoxItem Content="物件擦除"/><ComboBoxItem Content="局部筆跡擦除"/></ComboBox><Slider x:Name="EraserSizeSlider" Header="橡皮擦直徑" Minimum="4" Maximum="160" Value="32"/></StackPanel>
        <StackPanel x:Name="RulerSection" Spacing="8"><TextBlock Text="尺規" FontWeight="SemiBold"/><NumberBox x:Name="RulerAngleBox" Header="角度（0.1°）" Value="0" SmallChange="0.1" ValueChanged="RulerAngle_Changed" SpinButtonPlacementMode="Inline"/><Button Content="角度、尺寸與配色…" Click="RulerSettings_Click"/></StackPanel>
        <StackPanel x:Name="ExtendedSection" Spacing="8"/>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Border>
    <Border x:Name="LayersPanel" Visibility="Collapsed" Width="304" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="16" BorderBrush="#D4DBD1" BorderThickness="1" Background="#FCFCFA">
     <StackPanel Padding="14" Spacing="10"><Button Content="收起物件圖層" Click="Layers_Click"/>
       <TextBlock Text="圖層（上層在前）" FontWeight="SemiBold"/>
       <Grid>
       <ListView x:Name="LayerList" SelectionChanged="Layer_Changed" MaxHeight="420" SelectionMode="Extended">
        <ListView.ItemTemplate><DataTemplate>
         <Grid ColumnSpacing="8" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="22" Background="Transparent" PointerPressed="LayerGrip_Pressed" PointerMoved="LayerGrip_Moved" PointerReleased="LayerGrip_Released" PointerCanceled="LayerGrip_Canceled" PointerCaptureLost="LayerGrip_Canceled" ToolTipService.ToolTip="拖曳灰色雙槓調整圖層"><TextBlock Text="═" FontSize="16" Foreground="#909890" VerticalAlignment="Center"/></Border><ContentControl Grid.Column="1" Content="{Binding Icon}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="#68756C"/></StackPanel>
         </Grid>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>
       <Canvas x:Name="LayerDragOverlay" IsHitTestVisible="False"/>
       </Grid>
       <Button x:Name="RenameLayerButton" Content="重新命名圖層…" Click="RenameLayer_Click" IsEnabled="False"/>
       <StackPanel Orientation="Horizontal" Spacing="4"><Button Content="上移" Click="Raise_Click"/><Button Content="下移" Click="Lower_Click"/><Button Content="鎖定" Click="Lock_Click"/></StackPanel><Button Content="顯示／隱藏" Click="Visibility_Click"/>
       <Button Content="刪除物件" Click="Delete_Click"/>
     <TextBlock x:Name="LayerDragHint" FontSize="12" Foreground="#39735A" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </Grid>
   <Border x:Name="WorkspaceHeader" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0" Padding="8,4" CornerRadius="20" Background="#FCFCFA" BorderBrush="#D4DBD1" BorderThickness="1" PointerEntered="WorkspaceHeader_Entered" PointerExited="WorkspaceHeader_Exited">
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
     <Button x:Name="HomeButton" Click="Home_Click" ToolTipService.ToolTip="回到作品庫"/>
     <Border Width="1" Height="16" Background="#D4DBD1" Margin="2,0"/>
     <Button x:Name="ReadingModeButton" Click="ReadingMode_Click" ToolTipService.ToolTip="閱讀模式：拖曳移動畫布，不會畫線"/>
     <Button x:Name="ScreenCanvasButton" Click="ScreenCanvas_Click" ToolTipService.ToolTip="我的螢幕就是我的畫布（Ctrl+Alt+A）"/>
     <Button x:Name="PinNavButton" Click="Pin_Click" ToolTipService.ToolTip="圖釘"/>
     <Button x:Name="InsertNavButton" Click="InsertNav_Click" ToolTipService.ToolTip="＋ 插入內容與輔助工具"/>
     <Button x:Name="MoreNavButton" Click="MoreNav_Click" ToolTipService.ToolTip="⋯ 更多：筆記資訊、背景、圖層、匯出"/>
     <Border Width="1" Height="16" Background="#D4DBD1" Margin="2,0"/>
     <ContentControl x:Name="SaveStatusDot" Width="20" Height="20" Margin="2,0" ToolTipService.ToolTip="本機已存"/>
     <Button x:Name="HeaderPinButton" Content="固定" Click="HeaderPin_Click" ToolTipService.ToolTip="固定右上導覽列；再次點擊恢復自動收合"/>

     <!-- 保留既有元素引用以保證程式碼相容與無損升級 -->
     <StackPanel x:Name="LegacyHeaderActions" Visibility="Collapsed" Orientation="Horizontal">
      <TextBox x:Name="TitleBox" LostFocus="Title_LostFocus"/>
      <TextBlock x:Name="CanvasFormatText"/>
      <Button x:Name="BackgroundButton" Click="Background_Click"/>
      <Button x:Name="ExportButton" Click="Export_Click"/>
      <Button x:Name="SaveButton" Click="Save_Click"/>
      <Button x:Name="LayersButton" Click="Layers_Click"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <Button x:Name="HeaderReveal" Content="⌄" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,24,0" Height="20" Width="48" Padding="0" Background="#E9EEE6" CornerRadius="0,0,8,8" Click="HeaderReveal_Click" PointerEntered="WorkspaceHeader_Entered" PointerExited="WorkspaceHeader_Exited" ToolTipService.ToolTip="展開右上導覽膠囊"/>
   <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Padding="12,8" CornerRadius="24" Background="#EEFCFCFA" BorderBrush="#D4DBD1" BorderThickness="1">
    <StackPanel Orientation="Horizontal" Spacing="6">
     <Button Style="{StaticResource ToolButtonStyle}" Width="28" Height="28" Content="−" Click="ZoomOut_Click"/><Button Width="48" Height="28" MinHeight="0" Padding="0" BorderThickness="0" Background="Transparent" Click="ZoomMenu_Click"><TextBlock x:Name="ZoomText" Text="100%" FontSize="12" FontFamily="Consolas"/></Button><Button Style="{StaticResource ToolButtonStyle}" Width="28" Height="28" Content="＋" Click="ZoomIn_Click"/>
     <Border Width="1" Height="18" Background="#D4DBD1" Margin="4,0"/>
     <Button x:Name="NavigationLockButton" Style="{StaticResource ToolButtonStyle}" Width="28" Height="28" Click="NavigationLock_Click"/><Button x:Name="NavigationReadingButton" Style="{StaticResource ToolButtonStyle}" Width="28" Height="28" Click="ReadingMode_Click"/>
     <StackPanel Orientation="Horizontal" Spacing="4" x:Name="PagesBar" Visibility="Collapsed"><Border Width="1" Height="18" Background="#D4DBD1" Margin="4,0"/><Button Style="{StaticResource ToolButtonStyle}" Width="28" Height="28" Content="‹" Click="PreviousPage_Click"/><Button Height="28" MinHeight="0" Background="Transparent" BorderThickness="0" Padding="4,0" Click="PagesMenu_Click"><TextBlock x:Name="PageText" FontSize="11"/></Button><Button Style="{StaticResource ToolButtonStyle}" Width="28" Height="28" Content="›" Click="NextPage_Click"/><Button Style="{StaticResource ToolButtonStyle}" Width="28" Height="28" Content="＋" Click="AddPage_Click"/></StackPanel>
    </StackPanel>
   </Border>
   <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Padding="8,4" CornerRadius="10" Background="#DDFCFCFA"><TextBlock x:Name="StatusText" Text="本機已存" MaxWidth="260" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#68756C"/></Border>
  </Grid>
 </Grid>
</Window>
