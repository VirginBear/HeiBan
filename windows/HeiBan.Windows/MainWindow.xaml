<Window x:Class="HeiBan.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml" xmlns:views="using:HeiBan.Windows.Views" Title="HeiBan 黑板 · Windows">
 <Grid x:Name="Root" Background="#F2F4EF" RequestedTheme="Light" KeyDown="Root_KeyDown">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Padding="16,0,140,0" Background="#F2F4EF">
   <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <Image Source="Assets/AppIcon.png" Width="28" Height="28"/>
    <TextBlock Text="黑板" VerticalAlignment="Center" FontWeight="SemiBold"/>
    <TextBlock x:Name="PortableBadge" Text="免安裝版" VerticalAlignment="Center" Foreground="#39735A" Visibility="Collapsed"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="HomePanel" Grid.Row="1" Padding="28" RowSpacing="20">
   <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid>
    <Image Source="Assets/Wordmark.png" Width="138" Height="72" HorizontalAlignment="Left" AutomationProperties.Name="黑板：手寫筆記 Logo"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Content="我的螢幕就是我的畫布" Click="ScreenCanvas_Click" ToolTipService.ToolTip="在真實桌面、簡報與影片上註記"/><Button Content="垃圾桶" Click="Trash_Click"/><Button Content="開啟文件" Click="Import_Click"/><Button Content="關於" Click="About_Click"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <TextBlock Text="我的作品" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
     <TextBox x:Name="SearchBox" PlaceholderText="搜尋作品" Width="220" TextChanged="Search_Changed"/>
     <Button Content="＋ 新增" Click="New_Click" Style="{StaticResource AccentButtonStyle}"/>
    </StackPanel>
   </Grid>
   <ListView x:Name="LibraryList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Library_ItemClick" ContextRequested="Library_ContextRequested">
    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/></ItemsPanelTemplate></ListView.ItemsPanel>
    <ListView.ItemTemplate><DataTemplate>
     <Border Width="264" Padding="12" Margin="0,0,8,12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="10">
       <Grid Height="140" Background="#f0f3ed"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#eff4ed" CornerRadius="10" Padding="8,3"><StackPanel Orientation="Horizontal" Spacing="5"><ContentControl Content="{Binding FormatIcon}"/><TextBlock Text="{Binding Format}" Foreground="#285541" VerticalAlignment="Center"/></StackPanel></Border></Grid>
       <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65"/>
      </StackPanel>
     </Border>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
  </Grid>
  <Grid x:Name="Workspace" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Grid>

    <Grid x:Name="DrawingArea" SizeChanged="DrawingArea_SizeChanged" AllowDrop="True" DragOver="DrawingArea_DragOver" Drop="DrawingArea_Drop">
     <canvas:CanvasControl x:Name="CanvasSurface" Draw="CanvasSurface_Draw" CreateResources="CanvasSurface_CreateResources"
      PointerPressed="CanvasSurface_PointerPressed" PointerMoved="CanvasSurface_PointerMoved" PointerReleased="CanvasSurface_PointerReleased"
      PointerCanceled="CanvasSurface_PointerCanceled" PointerCaptureLost="CanvasSurface_PointerCanceled" PointerExited="CanvasSurface_PointerExited" PointerWheelChanged="CanvasSurface_PointerWheelChanged" DoubleTapped="CanvasSurface_DoubleTapped"/>
     <Canvas x:Name="TextOverlay" IsHitTestVisible="False"/>
     <Border x:Name="ToolBorder" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16" Padding="8" CornerRadius="16" Background="#FCFCFA" BorderThickness="1" BorderBrush="#D4DBD1">
      <StackPanel x:Name="ToolShell" Orientation="Horizontal" Spacing="8">
       <Border x:Name="ToolbarGrip" Width="24" Height="40" Background="Transparent" CornerRadius="6" ToolTipService.ToolTip="拖曳工具列；左右直排、上下橫排" PointerPressed="ToolbarGrip_Pressed" PointerMoved="ToolbarGrip_Moved" PointerReleased="ToolbarGrip_Released" PointerCanceled="ToolbarGrip_Canceled" PointerCaptureLost="ToolbarGrip_Canceled">
        <TextBlock Text="⋮⋮" Foreground="#829080" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <ScrollViewer x:Name="ToolScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
        <StackPanel x:Name="Tools" Orientation="Horizontal" Spacing="4"/>
       </ScrollViewer>
      </StackPanel>
     </Border>
     <Border x:Name="DockHint" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="12" Background="#2239735A" BorderBrush="#39735A" BorderThickness="2" Width="76" Height="180" Margin="12"><TextBlock x:Name="DockHintText" Text="直排" Foreground="#39735A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <Border x:Name="SelectionBar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="12" Background="#FCFCFA" BorderBrush="#D4DBD1" BorderThickness="1" Padding="4">
      <Border.RenderTransform><TranslateTransform x:Name="SelectionBarTransform"/></Border.RenderTransform>
      <StackPanel x:Name="SelectionBarTools" Orientation="Horizontal" Spacing="4"/>
     </Border>
     <Border x:Name="HUDOverlay" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="8" Background="#EBF1EA" BorderBrush="#39735A" BorderThickness="1" Padding="8,4">
      <Border.RenderTransform><TranslateTransform x:Name="HUDTransform"/></Border.RenderTransform>
      <TextBlock x:Name="HUDText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#26372F"/>
     </Border>
     <Button x:Name="InspectorBookmark" Click="Properties_Click" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12,0,0,12" Background="#FCFCFA" BorderBrush="#D4DBD1" Padding="9,14" ToolTipService.ToolTip="展開屬性檢查器"/>
    </Grid>
    <Border x:Name="Inspector" Visibility="Collapsed" Width="304" MaxHeight="800" Margin="0,12,16,12" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="16" BorderBrush="#D4DBD1" BorderThickness="1" Background="#FCFCFA">
     <ScrollViewer Padding="18" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
       <Grid><TextBlock Text="屬性檢查器" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CloseInspectorButton" Click="Properties_Click" HorizontalAlignment="Right" ToolTipService.ToolTip="收起屬性"/></Grid>
       <TextBlock x:Name="SelectionSummary" Text="目前畫筆 · 設定即時生效" FontSize="12" Foreground="#68756C" TextWrapping="Wrap"/>
       <TextBlock Text="線條／文字色彩" FontSize="12" FontWeight="SemiBold"/>
       <StackPanel x:Name="StrokePalette" Orientation="Horizontal" Spacing="5"/>
       <Button x:Name="StrokeColorButton" Click="StrokeColor_Click" HorizontalAlignment="Stretch"/>
       <Slider x:Name="WidthSlider" Header="線條粗細" Minimum="0.5" Maximum="128" Value="4" StepFrequency="0.5"/>
       <TextBlock x:Name="WidthValueText" FontSize="12" Foreground="#68756C"/>
       <TextBlock Text="填色" FontSize="12" FontWeight="SemiBold"/>
       <StackPanel x:Name="FillPalette" Orientation="Horizontal" Spacing="5"/>
       <Button x:Name="FillColorButton" Click="FillColor_Click" HorizontalAlignment="Stretch"/><CheckBox x:Name="FillToggle" Content="填滿圖形"/>
       <Slider x:Name="OpacitySlider" Header="透明度" Minimum="0" Maximum="1" Value="1" StepFrequency="0.01"/>
       <ComboBox x:Name="DashBox" Header="線條樣式" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="實線"/><ComboBoxItem Content="虛線"/><ComboBoxItem Content="點線"/><ComboBoxItem Content="點劃線"/></ComboBox>
       <NumberBox x:Name="RotationBox" Header="物件旋轉角度" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Inline"/>
       <NumberBox x:Name="FontSizeBox" Header="字體大小" Value="18" Minimum="8" Maximum="200" SpinButtonPlacementMode="Inline"/>
       <TextBlock Text="橡皮擦" FontWeight="SemiBold"/>
       <ComboBox x:Name="EraserModeBox" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="物件擦除"/><ComboBoxItem Content="局部筆跡擦除"/></ComboBox>
       <Slider x:Name="EraserSizeSlider" Header="橡皮擦直徑" Minimum="4" Maximum="160" Value="32"/>
       <TextBlock Text="尺規" FontWeight="SemiBold"/><NumberBox x:Name="RulerAngleBox" Header="角度（0.1°）" Value="0" SmallChange="0.1" ValueChanged="RulerAngle_Changed" SpinButtonPlacementMode="Inline"/>
       <Button Content="角度、尺寸與配色…" Click="RulerSettings_Click"/>
       <TextBlock Text="圖層（上層在前）" FontWeight="SemiBold"/>
       <ListView x:Name="LayerList" SelectionChanged="Layer_Changed" MaxHeight="220" SelectionMode="Single">
        <ListView.ItemTemplate><DataTemplate>
         <Grid ColumnSpacing="8" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ContentControl Content="{Binding Icon}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="#68756C"/></StackPanel>
         </Grid>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>
       <Button x:Name="RenameLayerButton" Content="重新命名圖層…" Click="RenameLayer_Click" IsEnabled="False"/>
       <StackPanel Orientation="Horizontal" Spacing="4"><Button Content="上移" Click="Raise_Click"/><Button Content="下移" Click="Lower_Click"/><Button Content="鎖定" Click="Lock_Click"/></StackPanel>
       <Button Content="刪除物件" Click="Delete_Click"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>
   <Border x:Name="WorkspaceHeader" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0" Padding="8,4" CornerRadius="20" Background="#FCFCFA" BorderBrush="#D4DBD1" BorderThickness="1" PointerEntered="WorkspaceHeader_Entered" PointerExited="WorkspaceHeader_Exited">
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
     <Button x:Name="HomeButton" Click="Home_Click" ToolTipService.ToolTip="回到作品庫"/>
     <Border Width="1" Height="16" Background="#D4DBD1" Margin="2,0"/>
     <Button x:Name="ReadingModeButton" Click="ReadingMode_Click" ToolTipService.ToolTip="閱讀模式：拖曳移動畫布，不會畫線"/>
     <Button x:Name="ScreenCanvasButton" Click="ScreenCanvas_Click" ToolTipService.ToolTip="我的螢幕就是我的畫布（Ctrl+Alt+A）"/>
     <Button x:Name="PinNavButton" Click="Pin_Click" ToolTipService.ToolTip="圖釘視角導航"/>
     <Button x:Name="InsertNavButton" Click="InsertNav_Click" ToolTipService.ToolTip="＋ 插入內容與輔助工具"/>
     <Button x:Name="MoreNavButton" Click="MoreNav_Click" ToolTipService.ToolTip="⋯ 更多：筆記資訊、背景、圖層、匯出"/>
     <Border Width="1" Height="16" Background="#D4DBD1" Margin="2,0"/>
     <Ellipse x:Name="SaveStatusDot" Width="8" Height="8" Fill="#39735A" Margin="2,0" ToolTipService.ToolTip="本機已存"/>
     <Button x:Name="HeaderPinButton" Content="固定" Click="HeaderPin_Click" ToolTipService.ToolTip="固定右上導覽列；再次點擊恢復自動收合"/>

     <!-- 保留既有元素引用以保證程式碼相容與無損升級 -->
     <StackPanel x:Name="LegacyHeaderActions" Visibility="Collapsed" Orientation="Horizontal">
      <TextBox x:Name="TitleBox" LostFocus="Title_LostFocus"/>
      <TextBlock x:Name="CanvasFormatText"/>
      <Button x:Name="BackgroundButton" Click="Background_Click"/>
      <Button x:Name="ExportButton" Click="Export_Click"/>
      <Button x:Name="SaveButton" Click="Save_Click"/>
      <Button x:Name="LayersButton" Click="Layers_Click"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <Button x:Name="HeaderReveal" Content="⌄" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,24,0" Height="20" Width="48" Padding="0" Background="#E9EEE6" CornerRadius="0,0,8,8" Click="HeaderReveal_Click" PointerEntered="WorkspaceHeader_Entered" PointerExited="WorkspaceHeader_Exited" ToolTipService.ToolTip="展開右上導覽膠囊"/>
   <Grid Grid.Row="1" Padding="16,0" Background="#F2F4EF">
    <TextBlock x:Name="StatusText" Text="本機已存" Width="240" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#68756C" VerticalAlignment="Center"/>
    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8" x:Name="PagesBar" Visibility="Collapsed">
     <Button Content="‹" Click="PreviousPage_Click"/><TextBlock x:Name="PageText" VerticalAlignment="Center"/><Button Content="›" Click="NextPage_Click"/><Button Content="＋頁" Click="AddPage_Click"/>
    </StackPanel>
    <TextBlock x:Name="ZoomText" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
