<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HeiBan.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling Condition="'$(HeiBanStoreBuild)' != 'true'">false</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishAot>false</PublishAot>

    <!-- 產品與版本中繼資料 -->
    <AssemblyName>HeiBan</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Product>HeiBan 黑板</Product>
    <Version>1.0.12-preview.6</Version>
    <FileVersion>1.0.12.6</FileVersion>
    <AssemblyVersion>1.0.12.6</AssemblyVersion>
    <Company>HeiBan Team</Company>
    <Copyright>© 2026 HeiBan Team. All rights reserved.</Copyright>
    <Description>HeiBan 黑板 — Windows 原生開發預覽：向量手寫板與多頁筆記系統</Description>

    <!-- Store is an explicit build mode so existing EXE/Portable builds keep their own initialization and PRI contract. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    
    <!-- 效能與體積最佳化 -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release' and '$(PublishAot)' == 'true'">true</PublishTrimmed>
    <TieredCompilation>true</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HeiBanStoreBuild)' == 'true'">
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackage>true</AppxPackage>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageExtension>.msix</AppxPackageExtension>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>

  <ItemGroup Condition="'$(HeiBanStoreBuild)' == 'true'">
    <AppxManifest Include="Packaging\Store\Package.appxmanifest" />
    <Content Include="Packaging\Store\Assets\**\*.png" Link="Assets\Store\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Licenses\**" Link="Licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Packaging\Store\README-Store.zh-TW.md" Link="README-Store.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- License version numbers are filenames, not scale/language qualifiers. Keep the
       original files in the package, but omit these plain documents from PRI indexing.
       Restore the SDK's exclusion list before it assembles the actual package payload. -->
  <Target Name="ExcludeHeiBanStoreDocumentsFromPri" BeforeTargets="_GenerateProjectPriConfigurationFiles"
          Condition="'$(HeiBanStoreBuild)' == 'true'">
    <ItemGroup>
      <_HeiBanStorePlainDocuments Include="@(PackagingOutputs)"
        Condition="$([System.String]::Copy('%(PackagingOutputs.TargetPath)').Replace('/', '\').StartsWith('Licenses\')) or '%(PackagingOutputs.Filename)' == 'README-Store.zh-TW'" />
      <_AppxLayoutAssetPackageFiles Include="@(_HeiBanStorePlainDocuments)" />
    </ItemGroup>
  </Target>
  <Target Name="RestoreHeiBanStoreDocumentPayload" AfterTargets="_GenerateProjectPriConfigurationFiles"
          Condition="'$(HeiBanStoreBuild)' == 'true'">
    <ItemGroup><_AppxLayoutAssetPackageFiles Remove="@(_HeiBanStorePlainDocuments)" /></ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Windows App SDK & Fluent Design 核心庫 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />

    <!-- Win2D Direct2D 硬體加速渲染庫 (GPU 加速) -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <ProjectReference Include="..\HeiBan.Windows.Core\HeiBan.Windows.Core.csproj" />
  </ItemGroup>

  <!-- 資源檔案包含 -->
  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Unpackaged MRT Core builds generate the app PRI but do not publish it.
       XAML is embedded in this index; runtime PRIs cannot replace it.
       See microsoft/WindowsAppSDK#6720. Keep this in the project so every
       dotnet publish consumer (installer, portable, CI) receives the file. -->
  <Target Name="IncludeHeiBanPriInPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)"
          Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')"
           Text="HeiBan XAML resource index was not generated: $(ProjectPriFullPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Remove="$(ProjectPriFullPath)" />
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
