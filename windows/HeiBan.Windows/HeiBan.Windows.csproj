<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HeiBan.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>

    <!-- 產品與版本中繼資料 -->
    <AssemblyName>HeiBan</AssemblyName>
    <Product>HeiBan 黑板</Product>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <Company>HeiBan Team</Company>
    <Copyright>© 2026 HeiBan Team. All rights reserved.</Copyright>
    <Description>HeiBan 黑板 — 專為 Windows 打造的極致效能向量手寫板與多頁筆記系統</Description>

    <!-- 雙發行模式設定：支援 MSIX (安裝版) 與 Unpackaged (免安裝綠色版) -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    
    <!-- 效能與體積最佳化 -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release' and '$(PublishAot)' == 'true'">true</PublishTrimmed>
    <TieredCompilation>true</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK & Fluent Design 核心庫 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />

    <!-- Win2D Direct2D 硬體加速渲染庫 (GPU 加速) -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.1" />

    <!-- 現代 MVVM 架構與高效能 JSON -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <!-- 資源檔案包含 -->
  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
