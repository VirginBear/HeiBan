":460,\"y\":4473.207212095665,\"pressure\":1},{\"x\":470,\"y\":4469.83968333666,\"pressure\":1},{\"x\":480,\"y\":4466.979523543928,\"pressure\":1},{\"x\":490,\"y\":4464.804563600425,\"pressure\":1},{\"x\":500,\"y\":4463.45003198119,\"pressure\":1},{\"x\":510,\"y\":4463.00014690174,\"pressure\":1},{\"x\":520,\"y\":4463.482880037331,\"pressure\":1},{\"x\":530,\"y\":4464.868217379673,\"pressure\":1},{\"x\":540,\"y\":4467.070025362593,\"pressure\":1},{\"x\":550,\"y\":4469.951406229993,\"pressure\":1},{\"x\":560,\"y\":4473.333209675283,\"pressure\":1},{\"x\":570,\"y\":4477.005171539732,\"pressure\":1},{\"x\":580,\"y\":4480.7389870194675,\"pressure\":1},{\"x\":590,\"y\":4484.302505552399,\"pressure\":1},{\"x\":600,\"y\":4487.474164815773,\"pressure\":1},{\"x\":610,\"y\":4490.056766398275,\"pressure\":1},{\"x\":620,\"y\":4491.88973664213,\"pressure\":1},{\"x\":630,\"y\":4492.859110335423,\"pressure\":1},{\"x\":640,\"y\":4492.904616516991,\"pressure\":1},{\"x\":650,\"y\":4492.02342583287,\"pressure\":1},{\"x\":660,\"y\":4490.27032645182,\"pressure\":1}]"
    },
    {
      "id": "quickstart-zh-CN-38",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 4513,
      "width": 610,
      "height": 42,
      "zIndex": 37,
      "strokeColor": "#4189c7",
      "strokeWidth": 6,
      "fillColor": "none",
