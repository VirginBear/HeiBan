      "text": "25 · 图层顺序与操作回馈",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-CN-118",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12858,
      "width": 900,
      "height": 50,
      "zIndex": 117,
      "strokeColor": "#57816c",
