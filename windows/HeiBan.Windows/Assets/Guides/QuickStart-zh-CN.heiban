      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "05 · 平移、缩放与视角锁定",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-CN-17",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 2050,
