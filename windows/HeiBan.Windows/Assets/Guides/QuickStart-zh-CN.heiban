    },
    {
      "id": "quickstart-zh-CN-76",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 8896,
      "width": 610,
      "height": 42,
      "zIndex": 75,
      "strokeColor": "#d79126",
      "strokeWidth": 8,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
