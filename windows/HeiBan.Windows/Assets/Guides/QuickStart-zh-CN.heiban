ssure\":1},{\"x\":460,\"y\":3763.207212095666,\"pressure\":1},{\"x\":470,\"y\":3759.8396833366596,\"pressure\":1},{\"x\":480,\"y\":3756.9795235439283,\"pressure\":1},{\"x\":490,\"y\":3754.804563600425,\"pressure\":1},{\"x\":500,\"y\":3753.45003198119,\"pressure\":1},{\"x\":510,\"y\":3753.0001469017393,\"pressure\":1},{\"x\":520,\"y\":3753.482880037331,\"pressure\":1},{\"x\":530,\"y\":3754.8682173796738,\"pressure\":1},{\"x\":540,\"y\":3757.0700253625923,\"pressure\":1},{\"x\":550,\"y\":3759.9514062299936,\"pressure\":1},{\"x\":560,\"y\":3763.333209675283,\"pressure\":1},{\"x\":570,\"y\":3767.005171539732,\"pressure\":1},{\"x\":580,\"y\":3770.738987019467,\"pressure\":1},{\"x\":590,\"y\":3774.3025055523995,\"pressure\":1},{\"x\":600,\"y\":3777.4741648157737,\"pressure\":1},{\"x\":610,\"y\":3780.0567663982742,\"pressure\":1},{\"x\":620,\"y\":3781.8897366421293,\"pressure\":1},{\"x\":630,\"y\":3782.859110335423,\"pressure\":1},{\"x\":640,\"y\":3782.9046165169916,\"pressure\":1},{\"x\":650,\"y\":3782.02342583287,\"pressure\":1},{\"x\":660,\"y\":3780.2703264518204,\"pressure\":1}]"
    },
    {
      "id": "quickstart-zh-CN-33",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
