":460,\"y\":6469.207212095665,\"pressure\":1},{\"x\":470,\"y\":6465.83968333666,\"pressure\":1},{\"x\":480,\"y\":6462.979523543928,\"pressure\":1},{\"x\":490,\"y\":6460.804563600425,\"pressure\":1},{\"x\":500,\"y\":6459.45003198119,\"pressure\":1},{\"x\":510,\"y\":6459.00014690174,\"pressure\":1},{\"x\":520,\"y\":6459.482880037331,\"pressure\":1},{\"x\":530,\"y\":6460.868217379673,\"pressure\":1},{\"x\":540,\"y\":6463.070025362593,\"pressure\":1},{\"x\":550,\"y\":6465.951406229993,\"pressure\":1},{\"x\":560,\"y\":6469.333209675283,\"pressure\":1},{\"x\":570,\"y\":6473.005171539732,\"pressure\":1},{\"x\":580,\"y\":6476.7389870194675,\"pressure\":1},{\"x\":590,\"y\":6480.302505552399,\"pressure\":1},{\"x\":600,\"y\":6483.474164815773,\"pressure\":1},{\"x\":610,\"y\":6486.056766398275,\"pressure\":1},{\"x\":620,\"y\":6487.88973664213,\"pressure\":1},{\"x\":630,\"y\":6488.859110335423,\"pressure\":1},{\"x\":640,\"y\":6488.904616516991,\"pressure\":1},{\"x\":650,\"y\":6488.02342583287,\"pressure\":1},{\"x\":660,\"y\":6486.27032645182,\"pressure\":1}]"
    },
    {
      "id": "quickstart-zh-CN-62",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 6509,
      "width": 610,
      "height": 42,
      "zIndex": 61,
