    },
    {
      "id": "quickstart-zh-TW-76",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 8896,
      "width": 610,
      "height": 42,
      "zIndex": 75,
      "strokeColor": "#d79126",
      "strokeWidth": 8,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "points": "[{\"x\":70,\"y\":8916.0,\"pressure\":1},{\"x\":80,\"y\":8919.711059388817,\"pressure\":1},{\"x\":90,\"y\":8923.191383079064,\"pressure\":1},{\"x\":100,\"y\":8926.22458140035,\"pressure\":1},{\"x\":110,\"y\":8928.622064772118,\"pressure\":1},{\"x\":120,\"y\":8930.234769290333,\"pressure\":1},{\"x\":130,\"y\":8930.962424799061,\"pressure\":1},{\"x\":140,\"y\":8930.75978920311,\"pressure\":1},{\"x\":150,\"y\":8929.639461402385,\"pressure\":1},{\"x\":160,\"y\":8927.671097953318,\"pressure\":1},{\"x\":170,\"y\":8924.97708216156,\"pressure\":1},{\"x\":180,\"y\":8921.724914880784,\"pressure\":1},{\"x\":190,\"y\":8918.116800120899,\"pressure\":1},{\"x\":200,\"y\":8914.377072982048,\"pressure\":1},{\"x\":210,\"y\":8910.738251584657,\"pressure\":1},{\"x\":220,\"y\":8907.426580218866,\"pressure\":1},{\"x\":230,\"y\":8904.647962570381,\"pressure\":1},{\"x\":240,\"y\":8902.57515962657,\"pressure\":1},{\"x\":250,\"y\":8901.337048235024,\"pressure\":1},{\"x\":260,\"y\":8901.010608165368,\"pressure\":1},{\"x\":270,\"y\":8901.616135880053,\"pressure\":1},{\"x\":280,\"y\":8903.115982598601,\"pressure\":1},{\"x\":290,\"y\":8905.416895116445,\"pressure\":1},{\"x\":300,\"y\":8908.37581383751,\"pressure\":1},{\"x\":310,\"y\":8911.808767527016,\"pressure\":1},{\"x\":320,\"y\":8915.502311751787,\"pressure\":1},{\"x\":330,\"y\":8919.226799821317,\"pressure\":1},{\"x\":340,\"y\":8922.75066110671,\"pressure\":1},{\"x\":350,\"y\":8925.854798980781,\"pressure\":1},{\"x\":360,\"y\":8928.346213185172,\"pressure\":1},{\"x\":370,\"y\":8930.069999651621,\"pressure\":1},{\"x\":380,\"y\":8930.918981686667,\"pressure\":1},{\"x\":390,\"y\":8930.840373699351,\"pressure\":1},{\"x\":400,\"y\":8929.83906315359,\"pressure\":1},{\"x\":410,\"y\":8927.977306689352,\"pressure\":1},{\"x\":420,\"y\":8925.370859306313,\"pressure\":1},{\"x\":430,\"y\":8922.181777278627,\"pressure\":1},{\"x\":440,\"y\":8918.608342280706,\"pressure\":1},{\"x\":450,\"y\":8914.872733193073,\"pressure\":1},{\"x\":460,\"y\":8911.207212095665,\"pressure\":1},{\"x\":470,\"y\":8907.839683336659,\"pressure\":1},{\"x\":480,\"y\":8904.979523543929,\"pressure\":1},{\"x\":490,\"y\":8902.804563600424,\"pressure\":1},{\"x\":500,\"y\":8901.45003198119,\"pressure\":1},{\"x\":510,\"y\":8901.000146901739,\"pressure\":1},{\"x\":520,\"y\":8901.48288003733,\"pressure\":1},{\"x\":530,\"y\":8902.868217379673,\"pressure\":1},{\"x\":540,\"y\":8905.070025362593,\"pressure\":1},{\"x\":550,\"y\":8907.951406229993,\"pressure\":1},{\"x\":560,\"y\":8911.333209675284,\"pressure\":1},{\"x\":570,\"y\":8915.005171539731,\"pressure\":1},{\"x\":580,\"y\":8918.738987019467,\"pressure\":1},{\"x\":590,\"y\":8922.3025055524,\"pressure\":1},{\"x\":600,\"y\":8925.474164815774,\"pressure\":1},{\"x\":610,\"y\":8928.056766398275,\"pressure\":1},{\"x\":620,\"y\":8929.88973664213,\"pressure\":1},{\"x\":630,\"y\":8930.859110335423,\"pressure\":1},{\"x\":640,\"y\":8930.904616516991,\"pressure\":1},{\"x\":650,\"y\":8930.023425832871,\"pressure\":1},{\"x\":660,\"y\":8928.27032645182,\"pressure\":1}]"
    },
    {
      "id": "quickstart-zh-TW-77",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "highlighter",
      "x": 700,
      "y": 8814,
      "width": 160,
      "height": 20,
      "zIndex": 76,
      "strokeColor": "#d9b927",
      "strokeWidth": 20,
      "fillColor": "none",
      "opacity": 0.45,
      "isLocked": false,
      "points": "[{\"x\": 710, \"y\": 8824}, {\"x\": 850, \"y\": 8824}]"
    },
    {
      "id": "quickstart-zh-TW-78",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9072,
      "width": 900,
      "height": 50,
      "zIndex": 77,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "14 · 尺規",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-79",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9134,
      "width": 900,
      "height": 50,
      "zIndex": 78,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "螢幕尺",
      "fontSize": 17
    },
    {
      "id": "quickstart-zh-TW-80",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9196,
      "width": 900,
      "height": 80,
      "zIndex": 79,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "啟用尺，拖尺身移動，拖端點旋轉；金色支點可移到上下劃線邊或兩端，旋轉固定該支點。右鍵尺或尺設定可調邊、0–100%支點位置、0.1°角度、透明度及長度。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-81",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9288,
      "width": 900,
      "height": 80,
      "zIndex": 80,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "兩種畫布的尺共用同一個長度與高度，以顯示單位 DIP 計算。從尺身最左或最右的雙線拖曳可伸縮，另一端固定。尺規設定也能調長度。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-82",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9380,
      "width": 900,
      "height": 50,
      "zIndex": 81,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "螢幕畫布的更多 → 螢幕尺可顯示、隱藏或移回目前螢幕。從尺邊開始的筆畫會沿該邊延伸。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-83",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9498,
      "width": 900,
      "height": 50,
      "zIndex": 82,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "15 · 圓規：準備、鎖定、畫弧",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-84",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9560,
      "width": 900,
      "height": 50,
      "zIndex": 83,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "圓規",
      "fontSize": 17
    },
    {
      "id": "quickstart-zh-TW-85",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9622,
      "width": 900,
      "height": 80,
      "zIndex": 84,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "準備時拖圓心、半徑與筆尖調位置、半徑和起角，不产生物件。點圓心變亮橘色，鎖定圓心與半徑。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-86",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9714,
      "width": 900,
      "height": 80,
      "zIndex": 85,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "拖筆尖沿圓周預覽有向弧線，跨0°連續計算；放開生成一個可編輯圓弧及一筆Undo。靜止點擊不產生無效物件；完成弧可等比縮放、旋轉與調起訖角。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-87",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9806,
      "width": 900,
      "height": 80,
      "zIndex": 86,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "螢幕畫布圓規設定可置中、調半徑與角度、切換準備／鎖定作畫，以及生成整圓或重設。拖筆尖預覽圓弧，放開才提交可編輯物件。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-88",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9954,
      "width": 900,
      "height": 50,
      "zIndex": 87,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "16 · 教學提醒：雷射與藤條",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-89",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10016,
      "width": 900,
      "height": 50,
      "zIndex": 88,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "雷射 · 藤條",
      "fontSize": 17
    },
    {
      "id": "quickstart-zh-TW-90",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10078,
      "width": 900,
      "height": 290,
      "zIndex": 89,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "工具列或更多工具選雷射，再點目前雷射開設定：光點、短尾跡或線條、顏色、直徑、粗細、消退時間與白色光芯。螢幕畫布同樣提供設定。 按住滑鼠左鍵才顯示雷射，放開、取消或離開畫布即清除光點與尾跡；單純移動不發光。雷射模式不選取物件，雙擊、右鍵與圖層點選也不切換成物件編輯；要編輯請先選「選取（V）」。 雷射設定也提供與筆刷共用的常用色：調色後按＋新增、管理中移除或還原預設，會保存並同步兩種畫布。選取、雷射、藤條固定相鄰顯示於每個分頁，自訂工具列不能隱藏或拆開；更多只保留顯示藤條來控制右下快捷，不重複列出藤條工具。也可點板擦旁藤條圖直接選用，右鍵隱藏後從更多恢復。選用後持續跟隨游標，右下握點、45°休止、75°揚起回45°並保留小幅回彈；左鍵每次單次取樣揮擊，不增作品物件或復原紀錄。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-91",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10380,
      "width": 900,
      "height": 50,
      "zIndex": 90,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "按住時尾跡依設定消退，停住仍保留當前光點；雷射不寫入永久物件或Undo。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-92",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10442,
      "width": 900,
      "height": 80,
      "zIndex": 91,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "工具列「更多 → 藤條靜音」可關閉音效，也可由右下藤條的右鍵選單切換；一般與螢幕畫布共用設定，重新開啟仍保留，揮動動畫不受影響。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-93",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10534,
      "width": 900,
      "height": 170,
      "zIndex": 92,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "先選用藤條，再點一次工具列的藤條，即可開啟「藤條靜音」；兩種畫布都支援。 同一畫面區域約36 DIP內，1.2秒連敲三下藤條，尖端會出現短暫裂紋並淡出，搭配破裂音。這是視覺效果，不修改作品；藤條靜音也關閉破裂音。換工具／模式或離開會重置連敲。 連敲音效依序使用兩種攻擊聲，第三擊使用保留碎裂尾音的破壞聲。裂紋縮小並伴隨少量旋轉、下墜及淡出的細碎屑，仍是短暫效果。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-94",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10716,
      "width": 900,
      "height": 80,
      "zIndex": 93,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "雷射可指向整個畫布視窗，包括紙張以外的區域。每次藤條揮動先播放揮聲，接觸時播放擊打聲，第三下的裂紋與破碎聲一起出現。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-95",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10864,
      "width": 900,
      "height": 50,
      "zIndex": 94,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "17 · 計算機與計時器",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-96",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10926,
      "width": 900,
      "height": 50,
      "zIndex": 95,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "計算機 · 計時器",
      "fontSize": 17
    },
    {
      "id": "quickstart-zh-TW-97",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10988,
      "width": 900,
      "height": 80,
      "zIndex": 96,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "上方＋開計算機或計時器，拖標題移動或收合。計算機提供括號、科學函數、π、e、Ans與鍵盤／Enter，按插入算式才新增文字物件。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-98",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11080,
      "width": 900,
      "height": 80,
      "zIndex": 97,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "計時器有碼表、5／15／25分鐘倒數及自訂秒數；關閉面板仍計時，到時通知，重新開啟保留目前狀態。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-99",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11172,
      "width": 900,
      "height": 110,
      "zIndex": 98,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "螢幕畫布計算機與計時器使用獨立浮動視窗；拖標題移動，−收合／展開，×關閉。計算機可插入算式，計時器可插入時間；插入會先完成剛放開的擦除，再建立獨立復原紀錄。離開螢幕畫布會停止視窗更新並暫停計時。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-100",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11350,
      "width": 900,
      "height": 50,
      "zIndex": 99,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "18 · 圖片、截圖與裁切",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-101",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11412,
      "width": 900,
      "height": 50,
      "zIndex": 100,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "匯入圖片 · 截圖 · 畫布範圍截圖",
      "fontSize": 17
    },
    {
      "id": "quickstart-zh-TW-102",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11474,
      "width": 900,
      "height": 80,
      "zIndex": 101,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "＋或工具列選截圖後框選區域，Esc／右鍵取消；切作品／頁面與逾時也取消。結果依原比例置入目前視野中心，不另存截圖資料夾。Win+Shift+S圖片可用Ctrl+V貼上。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-103",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11566,
      "width": 900,
      "height": 80,
      "zIndex": 102,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "可從檔案總管拖PNG／JPG／BMP到畫布，移動、缩放、旋轉。選圖片後色圓內裁切圖片／恢復原圖，以原圖像素範圍裁切並保留來源。內建截圖只使用此次結果，不讀無關剪貼簿圖。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-104",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11658,
      "width": 900,
      "height": 140,
      "zIndex": 103,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "管理分頁的「畫布範圍截圖」可直接複製圖片：A4／有邊界黑板擷取目前整頁，包含視窗外內容；無邊界筆記則拖曳框選，放開即複製，Esc或右鍵取消。圖片含紙張背景與格線、當頁可見物件，不含工具列、選取框及暫時工具；可直接貼到其他軟體。可用自訂工具列加入常用。與「截圖置入」擷取桌面再插入作品的用途不同。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-105",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11810,
      "width": 900,
      "height": 80,
      "zIndex": 104,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "畫布圖片成功複製後，畫面中央顯示「畫布已截圖」約兩秒，不會擋住操作；取消或失敗不會顯示成功。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-106",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11958,
      "width": 900,
      "height": 50,
      "zIndex": 105,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "19 · 圖釘與配色",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-107",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12020,
      "width": 900,
      "height": 50,
      "zIndex": 106,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "圖釘",
      "fontSize": 17
    },
    {
      "id": "quickstart-zh-TW-108",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12082,
      "width": 900,
      "height": 80,
      "zIndex": 107,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "上方圖釘儲存目前視野中心與倍率，點清單返回該視角。雙擊圖釘或名稱改名，Enter／點其他處保存、Esc取消；名稱右鍵也可改名，支援Undo。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-109",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12174,
      "width": 900,
      "height": 80,
      "zIndex": 108,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "右鍵圖釘的圖釘與文字配色，或圖釘清單的配色，可分別改本體及文字。Windows保存可選配色，舊Mac版本重存作品可能移除此欄位。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-110",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12266,
      "width": 900,
      "height": 80,
      "zIndex": 109,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "開啟圖釘清單時先顯示新增欄位並聚焦名稱，下面才是搜尋與既有圖釘。清單使用與畫布相同的圖釘繪製及各自本體／文字顏色，方便依外觀找到位置。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-111",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12358,
      "width": 900,
      "height": 50,
      "zIndex": 110,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "在一般畫布使用選取工具，右鍵選新建圖釘，即可在該位置放下預設圖釘。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-112",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12476,
      "width": 900,
      "height": 50,
      "zIndex": 111,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "20 · 螢幕畫布",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-113",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12538,
      "width": 900,
      "height": 230,
      "zIndex": 112,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "首頁側欄、螢幕圖示、更多工具或Ctrl+Alt+A啟動，先存作品後隱藏主視窗；即時桌面上為獨立透明註記層。握把拖四邊停靠，僅圖示模式不顯示捲軸，工作區不足換行／換列；圖文分頁模式維持單行／單列並用箭頭換組，清空與關閉保持可見。色圓、圖層與調色盤有入口；圖形填色請從「圖形」選單設定，橡皮擦／雷射再點開設定。 螢幕畫布支援的共用工具沿用一般工具列的顯示設定與順序；不提供圖釘與視角鎖定。「圖形」選單包含相同的九種圖形。 使用鋼筆畫出近似直線並停住0.5秒，預覽會吸附成直線；移動超過12 pt會恢復自由筆跡。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-114",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12780,
      "width": 900,
      "height": 140,
      "zIndex": 113,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "作畫／操作或Ctrl+Alt+D切換註記與下層App操作。物件右鍵改樣式、複製、副本、刪除、鎖定與層級，已多選物件保持整組；空白右鍵只取消未完成手勢。Shift點擊／拖框追加，左右框選依包含／碰到規則；套索可圈選相交物件；可移動、縮放、旋轉、調端點，Shift限制線段／箭頭水平、垂直或45°／135°。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-115",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12932,
      "width": 900,
      "height": 110,
      "zIndex": 114,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "T後點位置輸入，Enter換行、Ctrl+Enter／完成提交、Esc取消；雙擊文字或更多→選取物件→編輯文字。換工具／操作模式、截圖、另存、結束前提交草稿。樣式只修改未鎖定物件與有更動的欄位，連續滑桿調整可一次Undo。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-116",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13054,
      "width": 900,
      "height": 140,
      "zIndex": 115,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "截圖或Ctrl+Alt+S將含註記區域成為原螢幕位置圖片，不另存截圖資料夾。更多→另存註記匯出透明PNG或.heiban，更多→儲存註記手動保存。×或Ctrl+Alt+Q保存獨立註記並恢復主視窗，下次可繼續；垃圾桶或Ctrl+Alt+K直接清空，可Undo。快捷鍵被占用時用工具列；螢幕註記不自動合併到主作品。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-117",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13206,
      "width": 900,
      "height": 140,
      "zIndex": 116,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "在螢幕畫布，從更多選「開啟 OBS 擷取視窗」。在 OBS 加入「視窗擷取」，選 HeiBan · OBS，視窗比對優先順序設為視窗標題必須相符。此視窗即時顯示白底註記。若要播出底下的程式及桌面合成效果，請在 OBS 用顯示器擷取加裁切，並在直播前檢查預覽。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-118",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13414,
      "width": 900,
      "height": 50,
      "zIndex": 117,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "21 · 保存、資料與匯出",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-119",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13476,
      "width": 900,
      "height": 110,
      "zIndex": 118,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "首頁設定或更多→設定控制自動存檔，預設關閉，成功保存後沿用。開啟時一般約15秒、螢幕修改停止約1秒保存，手勢未完延後；關閉停止定期作品保存。Ctrl+S手動存一般作品，螢幕更多→儲存註記手動存。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-120",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13598,
      "width": 900,
      "height": 80,
      "zIndex": 119,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "回首頁、切作品／螢幕與正常退出都保存並等待，顯示旋轉進度；保存失敗保持視窗與內容。關閉自動存檔後，當機、斷電或強制結束可能遺失未保存變更。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-121",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13690,
      "width": 900,
      "height": 140,
      "zIndex": 120,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "匯出先選目前頁全部內容、選取物件或視野，再選.heiban、JSON、PNG、SVG、PDF、HTML。原稿／JSON保留所有頁；圖片與閱讀格式依範圍。PNG用畫布renderer，SVG含向量／圖片且富文字foreignObject需閱讀器支援，PDF需Edge WebView2並附原稿，HTML可離線且含JSON。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-122",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13842,
      "width": 900,
      "height": 110,
      "zIndex": 121,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "安裝版資料在%LOCALAPPDATA%\\HeiBan\\Windows\\，Portable在程式旁Data/，Store使用自身App資料位置。遷移前正常關閉並備份完整資料夾，包括作品、垃圾桶及設定；Portable保留整個資料夾，不從ZIP內啟動。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-123",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13964,
      "width": 900,
      "height": 110,
      "zIndex": 122,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "首頁「匯入」可選 PDF、PPTX 或 PPT。每頁轉為一張鎖定背景圖片並建立筆記頁面，可在上方註記。可選起訖頁，一次最多 200 頁、圖片總量最多 100 MB；取消不建立半份作品。原文字與形狀不會轉成可編輯元素。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-124",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14086,
      "width": 900,
      "height": 140,
      "zIndex": 123,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "PPT/PPTX 需要本機桌面版 PowerPoint；沒有時請先轉為 PDF。缺少字型可能改變版面，動畫、影片、轉場與互動不會保留；加密或損壞檔案可能無法轉換。匯出 PDF 時，選「目前頁面／全部內容」並勾選「PDF 匯出全部頁面」即可輸出整本筆記；選取物件或目前視野則依該範圍輸出。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-125",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14294,
      "width": 900,
      "height": 50,
      "zIndex": 124,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "22 · 快捷鍵速查",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-126",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14356,
      "width": 900,
      "height": 50,
      "zIndex": 125,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "復原 · 重做 · 清除本頁",
      "fontSize": 17
    },
    {
      "id": "quickstart-zh-TW-127",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14418,
      "width": 900,
      "height": 110,
      "zIndex": 126,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Ctrl+S保存；Ctrl+N新增；Ctrl+Z／Ctrl+Y復原／重做；Ctrl+C／Ctrl+V複製選取／貼物件或圖片；Delete刪選取；Esc取消手勢、截圖與未完成形狀。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-128",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14540,
      "width": 900,
      "height": 110,
      "zIndex": 127,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "空白鍵+拖曳／中鍵拖曳平移；滾輪／Ctrl+滾輪縮放；V／P／E／T選取／畫筆／橡皮擦／文字；Win+Shift+S後Ctrl+V剪取貼上。螢幕快捷鍵均加Ctrl+Alt：A啟動、D作畫／操作、S截圖、K清空、Q結束；其他App占用時用工具列。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-129",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14662,
      "width": 900,
      "height": 80,
      "zIndex": 128,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "復原與重做逐步還原／重新套用操作；清除本頁會先要求確認，清除目前頁物件，可復原，其他頁不受影響。選取後Delete只刪除選取物件。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-130",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14754,
      "width": 900,
      "height": 110,
      "zIndex": 129,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "一般畫布及螢幕畫布可從「更多」選「清除筆跡」。只清除目前頁面的未鎖定手寫筆跡（含螢光筆、油漆筆刷及新版鋼筆吸直線），圖片、背景、圖形與文字方塊都會保留。多頁筆記會保留其他頁及共用物件。可一次復原。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-131",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14932,
      "width": 900,
      "height": 50,
      "zIndex": 130,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "23 · 程式更新",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-132",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14994,
      "width": 900,
      "height": 50,
      "zIndex": 131,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Microsoft Store 安裝的黑板由商店提供更新。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-133",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15056,
      "width": 900,
      "height": 50,
      "zIndex": 132,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "免安裝試用版請開啟最新試用資料夾；接續作品前先正常關閉舊版並備份 Data。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-134",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15174,
      "width": 900,
      "height": 50,
      "zIndex": 133,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "24 · 功能範圍與已知限制",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-135",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15236,
      "width": 900,
      "height": 80,
      "zIndex": 134,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "本套件版本為 Windows 1.1.4。Microsoft Store 的提供狀態以商店頁面為準。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-136",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15328,
      "width": 900,
      "height": 110,
      "zIndex": 135,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "雲端／Google同步、協作、專用心智圖、表格、公式、畫框及外部PDF／SVG原稿編輯尚未交付。文件未知JSON欄位保留；.heiban使用者文字維持原語言，介面切換不翻譯作品。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-137",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15506,
      "width": 900,
      "height": 50,
      "zIndex": 136,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "25 · 背景設定操作要點",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-138",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15568,
      "width": 900,
      "height": 80,
      "zIndex": 137,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "新增先選格式，再選適用尺寸與背景；無邊界不需尺寸，有邊界先16:9仍可改。空白、橫線、點、方格與五線譜可新增時或之後從畫布背景選取。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-139",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15660,
      "width": 900,
      "height": 50,
      "zIndex": 138,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "既有作品套用才提交、取消保留，可Undo；改背景只改紙面，不會改已有筆畫與文字顏色。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-140",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15778,
      "width": 900,
      "height": 50,
      "zIndex": 139,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "26 · 圖層順序與操作回饋",
      "fontSize": 28
    },
    {
      "id": "quickstart-zh-TW-141",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15840,
      "width": 900,
      "height": 50,
      "zIndex": 140,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "物件圖層",
      "fontSize": 17
    },
    {
      "id": "quickstart-zh-TW-142",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15902,
      "width": 900,
      "height": 80,
      "zIndex": 141,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "工具列或更多開物件圖層，上層列在前。按圖示左灰色雙槓拖到另一列上半／下半，放開插其上／下；原列淡化、圖示名稱跟隨、綠線指示位置。改名不改物件身份，空白名稱恢復自動命名。",
      "fontSize": 18
    },
    {
      "id": "quickstart-zh-TW-143",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15994,
      "width": 900,
      "height": 80,
      "zIndex": 142,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "隱藏物件保留在面板，鎖定防批次移動／刪除，屬性與圖層為不同面板。方向／旋轉游標、已存／待存圖示、多選勾圈与橡皮擦範圍表示目前動作；試用遇到異常請回報後再核准正式更新。",
      "fontSize": 18
    }
  ]
}