  "objects": [
    {
      "id": "quickstart-zh-TW-1",
      "boardId": "heiban-windows-quickstart-v1",
      "pageId": "quickstart-1",
      "type": "text",
      "x": 32,
      "y": 24,
      "width": 890,
      "height": 64,
      "zIndex": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "畫筆與筆刷",
      "fontSize": 26
    },
    {
      "id": "quickstart-zh-TW-2",
      "boardId": "heiban-windows-quickstart-v1",
      "pageId": "quickstart-1",
      "type": "text",
      "x": 32,
      "y": 92,
      "width": 890,
      "height": 140,
      "zIndex": 1,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "選畫筆，再點色圓調顏色、粗細、透明度及種類：向量筆、鋼筆、鉛筆、水彩、螢光筆、蠟筆、書法、油漆。偏好會保存；筆跡為平滑向量，筆刷名稱不代表物理材質模擬，完成後可移動或改色。",
      "fontSize": 17
    },
    {
      "id": "quickstart-zh-TW-3",
      "boardId": "heiban-windows-quickstart-v1",
      "pageId": "quickstart-2",
      "type": "text",
      "x": 32,
      "y": 24,
      "width": 890,
      "height": 64,
      "zIndex": 2,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "線段、箭頭、形狀與曲線",
      "fontSize": 26
    },
    {
      "id": "quickstart-zh-TW-4",
      "boardId": "heiban-windows-quickstart-v1",
      "pageId": "quickstart-2",
      "type": "text",
      "x": 32,
      "y": 92,
      "width": 890,
      "height": 140,
      "zIndex": 3,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "線段／箭頭拖曳或先點A再點B建立，線身整體移動、兩端獨立調整。屬性可選線段、向A／B或雙向延伸而不改原端點；箭頭頭部長寬獨立，線條粗細也調整頭部輪廓。",
      "fontSize": 17
    },
    {
      "id": "quickstart-zh-TW-5",
      "boardId": "heiban-windows-quickstart-v1",
      "pageId": "quickstart-3",
      "type": "text",
      "x": 32,
      "y": 24,
      "width": 890,
      "height": 64,
      "zIndex": 4,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "橡皮擦",
      "fontSize": 26
    },
    {
      "id": "quickstart-zh-TW-6",
      "boardId": "heiban-windows-quickstart-v1",
      "pageId": "quickstart-3",
      "type": "text",
      "x": 32,
      "y": 92,
      "width": 890,
      "height": 140,
      "zIndex": 5,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "選橡皮擦，再點目前工具開設定，選物件擦除／局部筆跡擦除及直徑；一般與螢幕畫布均以半透明圓顯示範圍。",
      "fontSize": 17
    },
