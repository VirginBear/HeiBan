":460,\"y\":4227.207212095665,\"pressure\":1},{\"x\":470,\"y\":4223.83968333666,\"pressure\":1},{\"x\":480,\"y\":4220.979523543928,\"pressure\":1},{\"x\":490,\"y\":4218.804563600425,\"pressure\":1},{\"x\":500,\"y\":4217.45003198119,\"pressure\":1},{\"x\":510,\"y\":4217.00014690174,\"pressure\":1},{\"x\":520,\"y\":4217.482880037331,\"pressure\":1},{\"x\":530,\"y\":4218.868217379673,\"pressure\":1},{\"x\":540,\"y\":4221.070025362593,\"pressure\":1},{\"x\":550,\"y\":4223.951406229993,\"pressure\":1},{\"x\":560,\"y\":4227.333209675283,\"pressure\":1},{\"x\":570,\"y\":4231.005171539732,\"pressure\":1},{\"x\":580,\"y\":4234.7389870194675,\"pressure\":1},{\"x\":590,\"y\":4238.302505552399,\"pressure\":1},{\"x\":600,\"y\":4241.474164815773,\"pressure\":1},{\"x\":610,\"y\":4244.056766398275,\"pressure\":1},{\"x\":620,\"y\":4245.88973664213,\"pressure\":1},{\"x\":630,\"y\":4246.859110335423,\"pressure\":1},{\"x\":640,\"y\":4246.904616516991,\"pressure\":1},{\"x\":650,\"y\":4246.02342583287,\"pressure\":1},{\"x\":660,\"y\":4244.27032645182,\"pressure\":1}]"
    },
    {
      "id": "quickstart-zh-TW-35",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 4267,
      "width": 610,
      "height": 42,
      "zIndex": 34,
      "strokeColor": "#4189c7",
      "strokeWidth": 6,
      "fillColor": "none",
      "opacity": 1,
