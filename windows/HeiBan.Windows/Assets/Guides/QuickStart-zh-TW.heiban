    {
      "id": "quickstart-zh-TW-11",
      "boardId": "heiban-windows-quickstart-v1",
      "pageId": "quickstart-1",
      "type": "text",
      "x": 32,
      "y": 475,
      "width": 890,
      "height": 140,
      "zIndex": 10,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "V選取，Ctrl+點擊增減物件，套索沿範圍選取。空白處拖框左往右為藍實線，只選完全包含；右往左綠虛線，選碰到的物件；Ctrl／Shift拖框追加。多選可整組移動、複製、貼上、改樣式與刪除。",
      "fontSize": 17
    },
