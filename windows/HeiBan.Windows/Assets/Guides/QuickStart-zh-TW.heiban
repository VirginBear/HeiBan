    },
    {
      "id": "quickstart-zh-TW-16",
      "boardId": "heiban-windows-quickstart-v1",
      "pageId": "quickstart-2",
      "type": "text",
      "x": 32,
      "y": 455,
      "width": 890,
      "height": 140,
      "zIndex": 15,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "屬性面板只顯示所選物件適用項目，可調線色、粗細、適用的填色／漸層／透明度、文字與幾何數值。實線、虛線、點線、點劃線提供樣本，工具列顯示目前樣式；可先設繪圖偏好，修改選取物件也更新後續繪圖設定。",
      "fontSize": 17
    },
