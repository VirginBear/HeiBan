      "y": 12070,
      "width": 170,
      "height": 110,
      "zIndex": 46,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "#dcebdd",
      "opacity": 1,
      "isLocked": false
    },
