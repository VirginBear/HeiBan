33193073,\"pressure\":1},{\"x\":460,\"y\":10135.207212095665,\"pressure\":1},{\"x\":470,\"y\":10131.839683336659,\"pressure\":1},{\"x\":480,\"y\":10128.979523543929,\"pressure\":1},{\"x\":490,\"y\":10126.804563600424,\"pressure\":1},{\"x\":500,\"y\":10125.45003198119,\"pressure\":1},{\"x\":510,\"y\":10125.000146901739,\"pressure\":1},{\"x\":520,\"y\":10125.48288003733,\"pressure\":1},{\"x\":530,\"y\":10126.868217379673,\"pressure\":1},{\"x\":540,\"y\":10129.070025362593,\"pressure\":1},{\"x\":550,\"y\":10131.951406229993,\"pressure\":1},{\"x\":560,\"y\":10135.333209675284,\"pressure\":1},{\"x\":570,\"y\":10139.005171539731,\"pressure\":1},{\"x\":580,\"y\":10142.738987019467,\"pressure\":1},{\"x\":590,\"y\":10146.3025055524,\"pressure\":1},{\"x\":600,\"y\":10149.474164815774,\"pressure\":1},{\"x\":610,\"y\":10152.056766398275,\"pressure\":1},{\"x\":620,\"y\":10153.88973664213,\"pressure\":1},{\"x\":630,\"y\":10154.859110335423,\"pressure\":1},{\"x\":640,\"y\":10154.904616516991,\"pressure\":1},{\"x\":650,\"y\":10154.023425832871,\"pressure\":1},{\"x\":660,\"y\":10152.27032645182,\"pressure\":1}]"
