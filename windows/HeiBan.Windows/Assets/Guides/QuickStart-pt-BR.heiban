33193073,\"pressure\":1},{\"x\":460,\"y\":11441.207212095665,\"pressure\":1},{\"x\":470,\"y\":11437.839683336659,\"pressure\":1},{\"x\":480,\"y\":11434.979523543929,\"pressure\":1},{\"x\":490,\"y\":11432.804563600424,\"pressure\":1},{\"x\":500,\"y\":11431.45003198119,\"pressure\":1},{\"x\":510,\"y\":11431.000146901739,\"pressure\":1},{\"x\":520,\"y\":11431.48288003733,\"pressure\":1},{\"x\":530,\"y\":11432.868217379673,\"pressure\":1},{\"x\":540,\"y\":11435.070025362593,\"pressure\":1},{\"x\":550,\"y\":11437.951406229993,\"pressure\":1},{\"x\":560,\"y\":11441.333209675284,\"pressure\":1},{\"x\":570,\"y\":11445.005171539731,\"pressure\":1},{\"x\":580,\"y\":11448.738987019467,\"pressure\":1},{\"x\":590,\"y\":11452.3025055524,\"pressure\":1},{\"x\":600,\"y\":11455.474164815774,\"pressure\":1},{\"x\":610,\"y\":11458.056766398275,\"pressure\":1},{\"x\":620,\"y\":11459.88973664213,\"pressure\":1},{\"x\":630,\"y\":11460.859110335423,\"pressure\":1},{\"x\":640,\"y\":11460.904616516991,\"pressure\":1},{\"x\":650,\"y\":11460.023425832871,\"pressure\":1},{\"x\":660,\"y\":11458.27032645182,\"pressure\":1}]"
    },
    {
      "id": "quickstart-pt-BR-42",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 11481,
      "width": 610,
      "height": 42,
      "zIndex": 41,
      "strokeColor": "#4189c7",
      "strokeWidth": 6,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
