      "points": "[{\"x\": 554, \"y\": 9418}, {\"x\": 474, \"y\": 9528}, {\"x\": 634, \"y\": 9528}]"
    },
    {
      "id": "quickstart-pt-BR-42",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "arrow",
      "x": 690,
      "y": 9418,
      "width": 150,
      "height": 100,
      "zIndex": 41,
      "strokeColor": "#ba652b",
