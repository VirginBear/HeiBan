33193073,\"pressure\":1},{\"x\":460,\"y\":11337.207212095665,\"pressure\":1},{\"x\":470,\"y\":11333.839683336659,\"pressure\":1},{\"x\":480,\"y\":11330.979523543929,\"pressure\":1},{\"x\":490,\"y\":11328.804563600424,\"pressure\":1},{\"x\":500,\"y\":11327.45003198119,\"pressure\":1},{\"x\":510,\"y\":11327.000146901739,\"pressure\":1},{\"x\":520,\"y\":11327.48288003733,\"pressure\":1},{\"x\":530,\"y\":11328.868217379673,\"pressure\":1},{\"x\":540,\"y\":11331.070025362593,\"pressure\":1},{\"x\":550,\"y\":11333.951406229993,\"pressure\":1},{\"x\":560,\"y\":11337.333209675284,\"pressure\":1},{\"x\":570,\"y\":11341.005171539731,\"pressure\":1},{\"x\":580,\"y\":11344.738987019467,\"pressure\":1},{\"x\":590,\"y\":11348.3025055524,\"pressure\":1},{\"x\":600,\"y\":11351.474164815774,\"pressure\":1},{\"x\":610,\"y\":11354.056766398275,\"pressure\":1},{\"x\":620,\"y\":11355.88973664213,\"pressure\":1},{\"x\":630,\"y\":11356.859110335423,\"pressure\":1},{\"x\":640,\"y\":11356.904616516991,\"pressure\":1},{\"x\":650,\"y\":11356.023425832871,\"pressure\":1},{\"x\":660,\"y\":11354.27032645182,\"pressure\":1}]"
