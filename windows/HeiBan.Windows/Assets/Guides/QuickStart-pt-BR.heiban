33193073,\"pressure\":1},{\"x\":460,\"y\":10945.207212095665,\"pressure\":1},{\"x\":470,\"y\":10941.839683336659,\"pressure\":1},{\"x\":480,\"y\":10938.979523543929,\"pressure\":1},{\"x\":490,\"y\":10936.804563600424,\"pressure\":1},{\"x\":500,\"y\":10935.45003198119,\"pressure\":1},{\"x\":510,\"y\":10935.000146901739,\"pressure\":1},{\"x\":520,\"y\":10935.48288003733,\"pressure\":1},{\"x\":530,\"y\":10936.868217379673,\"pressure\":1},{\"x\":540,\"y\":10939.070025362593,\"pressure\":1},{\"x\":550,\"y\":10941.951406229993,\"pressure\":1},{\"x\":560,\"y\":10945.333209675284,\"pressure\":1},{\"x\":570,\"y\":10949.005171539731,\"pressure\":1},{\"x\":580,\"y\":10952.738987019467,\"pressure\":1},{\"x\":590,\"y\":10956.3025055524,\"pressure\":1},{\"x\":600,\"y\":10959.474164815774,\"pressure\":1},{\"x\":610,\"y\":10962.056766398275,\"pressure\":1},{\"x\":620,\"y\":10963.88973664213,\"pressure\":1},{\"x\":630,\"y\":10964.859110335423,\"pressure\":1},{\"x\":640,\"y\":10964.904616516991,\"pressure\":1},{\"x\":650,\"y\":10964.023425832871,\"pressure\":1},{\"x\":660,\"y\":10962.27032645182,\"pressure\":1}]"
