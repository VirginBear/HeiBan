    },
    {
      "id": "quickstart-pt-BR-39",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 10995,
      "width": 610,
      "height": 42,
      "zIndex": 38,
      "strokeColor": "#4189c7",
      "strokeWidth": 6,
      "fillColor": "none",
      "opacity": 1,
