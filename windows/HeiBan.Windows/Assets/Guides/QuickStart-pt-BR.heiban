33193073,\"pressure\":1},{\"x\":460,\"y\":10765.207212095665,\"pressure\":1},{\"x\":470,\"y\":10761.839683336659,\"pressure\":1},{\"x\":480,\"y\":10758.979523543929,\"pressure\":1},{\"x\":490,\"y\":10756.804563600424,\"pressure\":1},{\"x\":500,\"y\":10755.45003198119,\"pressure\":1},{\"x\":510,\"y\":10755.000146901739,\"pressure\":1},{\"x\":520,\"y\":10755.48288003733,\"pressure\":1},{\"x\":530,\"y\":10756.868217379673,\"pressure\":1},{\"x\":540,\"y\":10759.070025362593,\"pressure\":1},{\"x\":550,\"y\":10761.951406229993,\"pressure\":1},{\"x\":560,\"y\":10765.333209675284,\"pressure\":1},{\"x\":570,\"y\":10769.005171539731,\"pressure\":1},{\"x\":580,\"y\":10772.738987019467,\"pressure\":1},{\"x\":590,\"y\":10776.3025055524,\"pressure\":1},{\"x\":600,\"y\":10779.474164815774,\"pressure\":1},{\"x\":610,\"y\":10782.056766398275,\"pressure\":1},{\"x\":620,\"y\":10783.88973664213,\"pressure\":1},{\"x\":630,\"y\":10784.859110335423,\"pressure\":1},{\"x\":640,\"y\":10784.904616516991,\"pressure\":1},{\"x\":650,\"y\":10784.023425832871,\"pressure\":1},{\"x\":660,\"y\":10782.27032645182,\"pressure\":1}]"
