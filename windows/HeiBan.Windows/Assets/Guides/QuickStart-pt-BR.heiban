      "height": 110,
      "zIndex": 46,
      "strokeColor": "#4189c7",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false
    },
    {
      "id": "quickstart-pt-BR-48",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
