33193073,\"pressure\":1},{\"x\":460,\"y\":12969.207212095665,\"pressure\":1},{\"x\":470,\"y\":12965.839683336659,\"pressure\":1},{\"x\":480,\"y\":12962.979523543929,\"pressure\":1},{\"x\":490,\"y\":12960.804563600424,\"pressure\":1},{\"x\":500,\"y\":12959.45003198119,\"pressure\":1},{\"x\":510,\"y\":12959.000146901739,\"pressure\":1},{\"x\":520,\"y\":12959.48288003733,\"pressure\":1},{\"x\":530,\"y\":12960.868217379673,\"pressure\":1},{\"x\":540,\"y\":12963.070025362593,\"pressure\":1},{\"x\":550,\"y\":12965.951406229993,\"pressure\":1},{\"x\":560,\"y\":12969.333209675284,\"pressure\":1},{\"x\":570,\"y\":12973.005171539731,\"pressure\":1},{\"x\":580,\"y\":12976.738987019467,\"pressure\":1},{\"x\":590,\"y\":12980.3025055524,\"pressure\":1},{\"x\":600,\"y\":12983.474164815774,\"pressure\":1},{\"x\":610,\"y\":12986.056766398275,\"pressure\":1},{\"x\":620,\"y\":12987.88973664213,\"pressure\":1},{\"x\":630,\"y\":12988.859110335423,\"pressure\":1},{\"x\":640,\"y\":12988.904616516991,\"pressure\":1},{\"x\":650,\"y\":12988.023425832871,\"pressure\":1},{\"x\":660,\"y\":12986.27032645182,\"pressure\":1}]"
