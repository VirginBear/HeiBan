    {
      "id": "quickstart-pt-BR-64",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "highlighter",
      "x": 700,
      "y": 12782,
      "width": 160,
      "height": 20,
      "zIndex": 63,
      "strokeColor": "#d9b927",
