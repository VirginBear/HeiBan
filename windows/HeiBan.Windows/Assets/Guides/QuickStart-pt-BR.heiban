    {
      "id": "quickstart-pt-BR-39",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 9218,
      "width": 610,
      "height": 42,
      "zIndex": 38,
      "strokeColor": "#d79126",
      "strokeWidth": 8,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
