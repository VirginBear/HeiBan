33193073,\"pressure\":1},{\"x\":460,\"y\":10495.207212095665,\"pressure\":1},{\"x\":470,\"y\":10491.839683336659,\"pressure\":1},{\"x\":480,\"y\":10488.979523543929,\"pressure\":1},{\"x\":490,\"y\":10486.804563600424,\"pressure\":1},{\"x\":500,\"y\":10485.45003198119,\"pressure\":1},{\"x\":510,\"y\":10485.000146901739,\"pressure\":1},{\"x\":520,\"y\":10485.48288003733,\"pressure\":1},{\"x\":530,\"y\":10486.868217379673,\"pressure\":1},{\"x\":540,\"y\":10489.070025362593,\"pressure\":1},{\"x\":550,\"y\":10491.951406229993,\"pressure\":1},{\"x\":560,\"y\":10495.333209675284,\"pressure\":1},{\"x\":570,\"y\":10499.005171539731,\"pressure\":1},{\"x\":580,\"y\":10502.738987019467,\"pressure\":1},{\"x\":590,\"y\":10506.3025055524,\"pressure\":1},{\"x\":600,\"y\":10509.474164815774,\"pressure\":1},{\"x\":610,\"y\":10512.056766398275,\"pressure\":1},{\"x\":620,\"y\":10513.88973664213,\"pressure\":1},{\"x\":630,\"y\":10514.859110335423,\"pressure\":1},{\"x\":640,\"y\":10514.904616516991,\"pressure\":1},{\"x\":650,\"y\":10514.023425832871,\"pressure\":1},{\"x\":660,\"y\":10512.27032645182,\"pressure\":1}]"
