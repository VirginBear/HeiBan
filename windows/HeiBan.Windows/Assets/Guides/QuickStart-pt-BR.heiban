\":8987.207212095665,\"pressure\":1},{\"x\":470,\"y\":8983.839683336659,\"pressure\":1},{\"x\":480,\"y\":8980.979523543929,\"pressure\":1},{\"x\":490,\"y\":8978.804563600424,\"pressure\":1},{\"x\":500,\"y\":8977.45003198119,\"pressure\":1},{\"x\":510,\"y\":8977.000146901739,\"pressure\":1},{\"x\":520,\"y\":8977.48288003733,\"pressure\":1},{\"x\":530,\"y\":8978.868217379673,\"pressure\":1},{\"x\":540,\"y\":8981.070025362593,\"pressure\":1},{\"x\":550,\"y\":8983.951406229993,\"pressure\":1},{\"x\":560,\"y\":8987.333209675284,\"pressure\":1},{\"x\":570,\"y\":8991.005171539731,\"pressure\":1},{\"x\":580,\"y\":8994.738987019467,\"pressure\":1},{\"x\":590,\"y\":8998.3025055524,\"pressure\":1},{\"x\":600,\"y\":9001.474164815774,\"pressure\":1},{\"x\":610,\"y\":9004.056766398275,\"pressure\":1},{\"x\":620,\"y\":9005.88973664213,\"pressure\":1},{\"x\":630,\"y\":9006.859110335423,\"pressure\":1},{\"x\":640,\"y\":9006.904616516991,\"pressure\":1},{\"x\":650,\"y\":9006.023425832871,\"pressure\":1},{\"x\":660,\"y\":9004.27032645182,\"pressure\":1}]"
    },
    {
      "id": "quickstart-pt-BR-37",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
