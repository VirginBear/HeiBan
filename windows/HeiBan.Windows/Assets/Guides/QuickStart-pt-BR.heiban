\":9233.207212095665,\"pressure\":1},{\"x\":470,\"y\":9229.839683336659,\"pressure\":1},{\"x\":480,\"y\":9226.979523543929,\"pressure\":1},{\"x\":490,\"y\":9224.804563600424,\"pressure\":1},{\"x\":500,\"y\":9223.45003198119,\"pressure\":1},{\"x\":510,\"y\":9223.000146901739,\"pressure\":1},{\"x\":520,\"y\":9223.48288003733,\"pressure\":1},{\"x\":530,\"y\":9224.868217379673,\"pressure\":1},{\"x\":540,\"y\":9227.070025362593,\"pressure\":1},{\"x\":550,\"y\":9229.951406229993,\"pressure\":1},{\"x\":560,\"y\":9233.333209675284,\"pressure\":1},{\"x\":570,\"y\":9237.005171539731,\"pressure\":1},{\"x\":580,\"y\":9240.738987019467,\"pressure\":1},{\"x\":590,\"y\":9244.3025055524,\"pressure\":1},{\"x\":600,\"y\":9247.474164815774,\"pressure\":1},{\"x\":610,\"y\":9250.056766398275,\"pressure\":1},{\"x\":620,\"y\":9251.88973664213,\"pressure\":1},{\"x\":630,\"y\":9252.859110335423,\"pressure\":1},{\"x\":640,\"y\":9252.904616516991,\"pressure\":1},{\"x\":650,\"y\":9252.023425832871,\"pressure\":1},{\"x\":660,\"y\":9250.27032645182,\"pressure\":1}]"
    },
    {
      "id": "quickstart-pt-BR-40",
      "boardId": "heiban-windows-quickstart-v2",
