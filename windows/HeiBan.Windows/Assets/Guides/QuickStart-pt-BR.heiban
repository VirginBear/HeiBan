      "opacity": 1,
      "isLocked": false,
      "points": "[{\"x\": 554, \"y\": 10532}, {\"x\": 474, \"y\": 10642}, {\"x\": 634, \"y\": 10642}]"
    },
    {
      "id": "quickstart-pt-BR-46",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "arrow",
      "x": 690,
