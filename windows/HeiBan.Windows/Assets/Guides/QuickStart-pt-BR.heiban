33193073,\"pressure\":1},{\"x\":460,\"y\":10525.207212095665,\"pressure\":1},{\"x\":470,\"y\":10521.839683336659,\"pressure\":1},{\"x\":480,\"y\":10518.979523543929,\"pressure\":1},{\"x\":490,\"y\":10516.804563600424,\"pressure\":1},{\"x\":500,\"y\":10515.45003198119,\"pressure\":1},{\"x\":510,\"y\":10515.000146901739,\"pressure\":1},{\"x\":520,\"y\":10515.48288003733,\"pressure\":1},{\"x\":530,\"y\":10516.868217379673,\"pressure\":1},{\"x\":540,\"y\":10519.070025362593,\"pressure\":1},{\"x\":550,\"y\":10521.951406229993,\"pressure\":1},{\"x\":560,\"y\":10525.333209675284,\"pressure\":1},{\"x\":570,\"y\":10529.005171539731,\"pressure\":1},{\"x\":580,\"y\":10532.738987019467,\"pressure\":1},{\"x\":590,\"y\":10536.3025055524,\"pressure\":1},{\"x\":600,\"y\":10539.474164815774,\"pressure\":1},{\"x\":610,\"y\":10542.056766398275,\"pressure\":1},{\"x\":620,\"y\":10543.88973664213,\"pressure\":1},{\"x\":630,\"y\":10544.859110335423,\"pressure\":1},{\"x\":640,\"y\":10544.904616516991,\"pressure\":1},{\"x\":650,\"y\":10544.023425832871,\"pressure\":1},{\"x\":660,\"y\":10542.27032645182,\"pressure\":1}]"
