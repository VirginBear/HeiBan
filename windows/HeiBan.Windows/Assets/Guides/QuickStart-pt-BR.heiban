33193073,\"pressure\":1},{\"x\":460,\"y\":11065.207212095665,\"pressure\":1},{\"x\":470,\"y\":11061.839683336659,\"pressure\":1},{\"x\":480,\"y\":11058.979523543929,\"pressure\":1},{\"x\":490,\"y\":11056.804563600424,\"pressure\":1},{\"x\":500,\"y\":11055.45003198119,\"pressure\":1},{\"x\":510,\"y\":11055.000146901739,\"pressure\":1},{\"x\":520,\"y\":11055.48288003733,\"pressure\":1},{\"x\":530,\"y\":11056.868217379673,\"pressure\":1},{\"x\":540,\"y\":11059.070025362593,\"pressure\":1},{\"x\":550,\"y\":11061.951406229993,\"pressure\":1},{\"x\":560,\"y\":11065.333209675284,\"pressure\":1},{\"x\":570,\"y\":11069.005171539731,\"pressure\":1},{\"x\":580,\"y\":11072.738987019467,\"pressure\":1},{\"x\":590,\"y\":11076.3025055524,\"pressure\":1},{\"x\":600,\"y\":11079.474164815774,\"pressure\":1},{\"x\":610,\"y\":11082.056766398275,\"pressure\":1},{\"x\":620,\"y\":11083.88973664213,\"pressure\":1},{\"x\":630,\"y\":11084.859110335423,\"pressure\":1},{\"x\":640,\"y\":11084.904616516991,\"pressure\":1},{\"x\":650,\"y\":11084.023425832871,\"pressure\":1},{\"x\":660,\"y\":11082.27032645182,\"pressure\":1}]"
