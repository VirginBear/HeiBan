      "height": 110,
      "zIndex": 45,
      "strokeColor": "#4189c7",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false
    },
    {
      "id": "quickstart-pt-BR-47",
      "boardId": "heiban-windows-quickstart-v2",
