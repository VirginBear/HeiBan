    },
    {
      "id": "quickstart-pt-BR-40",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 11267,
      "width": 610,
      "height": 42,
      "zIndex": 39,
      "strokeColor": "#4189c7",
      "strokeWidth": 6,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
