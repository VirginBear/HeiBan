      "y": 13002,
      "width": 170,
      "height": 110,
      "zIndex": 47,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "#dcebdd",
      "opacity": 1,
      "isLocked": false
    },
    {
      "id": "quickstart-pt-BR-49",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
