      "isLocked": false,
      "points": "[{\"x\": 554, \"y\": 13062}, {\"x\": 474, \"y\": 13172}, {\"x\": 634, \"y\": 13172}]"
    },
    {
      "id": "quickstart-pt-BR-51",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "arrow",
      "x": 690,
      "y": 13062,
      "width": 150,
      "height": 100,
      "zIndex": 50,
