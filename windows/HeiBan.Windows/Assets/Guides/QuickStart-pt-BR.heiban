      "x": 300,
      "y": 10532,
      "width": 110,
      "height": 110,
      "zIndex": 43,
      "strokeColor": "#4189c7",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false
    },
    {
      "id": "quickstart-pt-BR-45",
      "boardId": "heiban-windows-quickstart-v2",
