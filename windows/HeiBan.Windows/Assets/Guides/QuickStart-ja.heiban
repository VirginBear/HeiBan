      "fillColor": "#fff0ab",
      "opacity": 1,
      "isLocked": false,
      "points": "[{\"x\": 554, \"y\": 5278}, {\"x\": 474, \"y\": 5388}, {\"x\": 634, \"y\": 5388}]"
    },
    {
      "id": "quickstart-ja-42",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "arrow",
      "x": 690,
