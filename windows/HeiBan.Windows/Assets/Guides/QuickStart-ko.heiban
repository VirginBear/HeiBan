      "y": 8874,
      "width": 610,
      "height": 42,
      "zIndex": 62,
      "strokeColor": "#d79126",
      "strokeWidth": 8,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "points": "[{\"x\":70,\"y\":8894.0,\"pressure\":1},{\"x\":80,\"y\":8897.711059388817,\"pressure\":1},{\"x\":90,\"y\":8901.191383079064,\"pressure\":1},{\"x\":100,\"y\":8904.22458140035,\"pressure\":1},{\"x\":110,\"y\":8906.622064772118,\"pressure\":1},{\"x\":120,\"y\":8908.234769290333,\"pressure\":1},{\"x\":130,\"y\":8908.962424799061,\"pressure\":1},{\"x\":140,\"y\":8908.75978920311,\"pressure\":1},{\"x\":150,\"y\":8907.639461402385,\"pressure\":1},{\"x\":160,\"y\":8905.671097953318,\"pressure\":1},{\"x\":170,\"y\":8902.97708216156,\"pressure\":1},{\"x\":180,\"y\":8899.724914880784,\"pressure\":1},{\"x\":190,\"y\":8896.116800120899,\"pressure\":1},{\"x\":200,\"y\":8892.377072982048,\"pressure\":1},{\"x\":210,\"y\":8888.738251584657,\"pressure\":1},{\"x\":220,\"y\":8885.426580218866,\"pressure\":1},{\"x\":230,\"y\":8882.647962570381,\"pressure\":1},{\"x\":240,\"y\":8880.57515962657,\"pressure\":1},{\"x\":250,\"y\":8879.337048235024,\"pressure\":1},{\"x\":260,\"y\":8879.010608165368,\"pressure\":1},{\"x\":270,\"y\":8879.616135880053,\"pressure\":1},{\"x\":280,\"y\":8881.115982598601,\"pressure\":1},{\"x\":290,\"y\":8883.416895116445,\"pressure\":1},{\"x\":300,\"y\":8886.37581383751,\"pressure\":1},{\"x\":310,\"y\":8889.808767527016,\"pressure\":1},{\"x\":320,\"y\":8893.502311751787,\"pressure\":1},{\"x\":330,\"y\":8897.226799821317,\"pressure\":1},{\"x\":340,\"y\":8900.75066110671,\"pressure\":1},{\"x\":350,\"y\":8903.854798980781,\"pressure\":1},{\"x\":360,\"y\":8906.346213185172,\"pressure\":1},{\"x\":370,\"y\":8908.069999651621,\"pressure\":1},{\"x\":380,\"y\":8908.918981686667,\"pressure\":1},{\"x\":390,\"y\":8908.840373699351,\"pressure\":1},{\"x\":400,\"y\":8907.83906315359,\"pressure\":1},{\"x\":410,\"y\":8905.977306689352,\"pressure\":1},{\"x\":420,\"y\":8903.370859306313,\"pressure\":1},{\"x\":430,\"y\":8900.181777278627,\"pressure\":1},{\"x\":440,\"y\":8896.608342280706,\"pressure\":1},{\"x\":450,\"y\":8892.872733193073,\"pressure\":1},{\"x\":460,\"y\":8889.207212095665,\"pressure\":1},{\"x\":470,\"y\":8885.839683336659,\"pressure\":1},{\"x\":480,\"y\":8882.979523543929,\"pressure\":1},{\"x\":490,\"y\":8880.804563600424,\"pressure\":1},{\"x\":500,\"y\":8879.45003198119,\"pressure\":1},{\"x\":510,\"y\":8879.000146901739,\"pressure\":1},{\"x\":520,\"y\":8879.48288003733,\"pressure\":1},{\"x\":530,\"y\":8880.868217379673,\"pressure\":1},{\"x\":540,\"y\":8883.070025362593,\"pressure\":1},{\"x\":550,\"y\":8885.951406229993,\"pressure\":1},{\"x\":560,\"y\":8889.333209675284,\"pressure\":1},{\"x\":570,\"y\":8893.005171539731,\"pressure\":1},{\"x\":580,\"y\":8896.738987019467,\"pressure\":1},{\"x\":590,\"y\":8900.3025055524,\"pressure\":1},{\"x\":600,\"y\":8903.474164815774,\"pressure\":1},{\"x\":610,\"y\":8906.056766398275,\"pressure\":1},{\"x\":620,\"y\":8907.88973664213,\"pressure\":1},{\"x\":630,\"y\":8908.859110335423,\"pressure\":1},{\"x\":640,\"y\":8908.904616516991,\"pressure\":1},{\"x\":650,\"y\":8908.023425832871,\"pressure\":1},{\"x\":660,\"y\":8906.27032645182,\"pressure\":1}]"
    },
    {
      "id": "quickstart-ko-64",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "highlighter",
      "x": 700,
      "y": 8792,
      "width": 160,
      "height": 20,
      "zIndex": 63,
      "strokeColor": "#d9b927",
      "strokeWidth": 20,
      "fillColor": "none",
      "opacity": 0.45,
      "isLocked": false,
      "points": "[{\"x\": 710, \"y\": 8802}, {\"x\": 850, \"y\": 8802}]"
    },
    {
      "id": "quickstart-ko-65",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9050,
      "width": 900,
      "height": 50,
      "zIndex": 64,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "13 · 자",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-66",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9112,
      "width": 900,
      "height": 50,
      "zIndex": 65,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "자",
      "fontSize": 17
    },
    {
      "id": "quickstart-ko-67",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9174,
      "width": 900,
      "height": 140,
      "zIndex": 66,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "자 몸통을 끌어 이동하고 끝 핸들로 회전합니다. 금색 축을 위아래 그리기 가장자리나 양 끝으로 옮기면 그 축을 중심으로 회전합니다. 오른쪽 클릭/설정으로 가장자리, 0–100% 축 위치, 0.1° 각도, 불투명도와 길이를 조절합니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-68",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9326,
      "width": 900,
      "height": 110,
      "zIndex": 67,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "길이는 캔버스 폭의 20–150%, 기본 90%이며 창 크기에 맞춥니다. 가장자리 근처에서 시작한 펜은 획 전체를 직선으로 맞추며 자 바깥에서도 같은 축을 따릅니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-69",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9504,
      "width": 900,
      "height": 50,
      "zIndex": 68,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "14 · 컴퍼스: 준비, 잠금, 호",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-70",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9566,
      "width": 900,
      "height": 50,
      "zIndex": 69,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "컴퍼스",
      "fontSize": 17
    },
    {
      "id": "quickstart-ko-71",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9628,
      "width": 900,
      "height": 110,
      "zIndex": 70,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "중심, 반지름 핸들, 펜 끝을 끌어 위치/반지름/시작 각도를 준비합니다. 이때 개체는 만들지 않습니다. 중심을 클릭하면 밝은 주황색으로 변하며 중심과 반지름을 잠급니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-72",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9750,
      "width": 900,
      "height": 140,
      "zIndex": 71,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "끝을 원둘레 따라 끌면 방향 있는 호를 미리 보고 0°를 넘어도 이어집니다. 놓으면 편집 가능한 호와 한 번의 실행 취소를 만듭니다. 움직임 없는 클릭은 만들지 않으며 완성된 호는 비율 크기 조절, 회전, 시작/끝 각도 조정이 가능합니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-73",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9958,
      "width": 900,
      "height": 50,
      "zIndex": 72,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "15 · 레이저 포인터",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-74",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10020,
      "width": 900,
      "height": 50,
      "zIndex": 73,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "레이저",
      "fontSize": 17
    },
    {
      "id": "quickstart-ko-75",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10082,
      "width": 900,
      "height": 110,
      "zIndex": 74,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "도구 모음/더 보기에서 선택하고 현재 레이저를 다시 클릭해 점, 짧은 자취, 선, 색, 지름, 굵기, 사라지는 시간, 흰 중심을 설정합니다. 화면 캔버스에도 있습니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-76",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10204,
      "width": 900,
      "height": 170,
      "zIndex": 75,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "레이저는 일시적인 안내이며 저장 개체나 실행 취소 작업을 만들지 않습니다. 궤적은 부드러운 연속 윤곽, 가늘어지는 꼬리와 은은한 빛으로 표시됩니다. 광점은 약 0.3초, 짧은 궤적은 0.2–0.8초 후 사라지고 선 모드는 설정 시간을 따릅니다. 캔버스를 벗어나면 궤적이 끊어져 다시 들어올 때 멀리 떨어진 위치가 연결되지 않습니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-77",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10442,
      "width": 900,
      "height": 50,
      "zIndex": 76,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "16 · 계산기와 타이머",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-78",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10504,
      "width": 900,
      "height": 50,
      "zIndex": 77,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "계산기 · 타이머 및 스톱워치",
      "fontSize": 17
    },
    {
      "id": "quickstart-ko-79",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10566,
      "width": 900,
      "height": 110,
      "zIndex": 78,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "위 +에서 열고 제목을 끌어 이동/접습니다. 계산기는 괄호, 과학 함수, π, e, Ans, 키보드/Enter를 지원하며 수식 삽입을 눌러야 글자 개체를 만듭니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-80",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10688,
      "width": 900,
      "height": 80,
      "zIndex": 79,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "타이머는 스톱워치, 5/15/25분, 사용자 지정 초를 지원합니다. 패널을 닫아도 계속 작동하고 알리며 다시 열면 상태를 유지합니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-81",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10836,
      "width": 900,
      "height": 50,
      "zIndex": 80,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "17 · 이미지, 캡처와 자르기",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-82",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10898,
      "width": 900,
      "height": 50,
      "zIndex": 81,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "이미지 가져오기 · 스크린샷",
      "fontSize": 17
    },
    {
      "id": "quickstart-ko-83",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10960,
      "width": 900,
      "height": 140,
      "zIndex": 82,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "+나 도구 모음에서 캡처를 선택해 영역을 끕니다. Esc/오른쪽 클릭, 작품/페이지 전환, 시간 초과는 취소합니다. 원래 비율 이미지가 현재 시야 중앙에 들어가며 별도 캡처 폴더에 저장하지 않습니다. Win+Shift+S 결과는 Ctrl+V로 붙입니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-84",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11112,
      "width": 900,
      "height": 140,
      "zIndex": 83,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "탐색기에서 PNG/JPG/BMP를 끌어 넣고 이동/크기/회전할 수 있습니다. 색 메뉴의 이미지 자르기/원본 복원에서 원본 픽셀 영역을 입력하면 원본을 보존합니다. 내장 캡처는 이번 결과만 쓰며 무관한 클립보드 이미지를 읽지 않습니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-85",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11320,
      "width": 900,
      "height": 50,
      "zIndex": 84,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "18 · 시점 핀과 색",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-86",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11382,
      "width": 900,
      "height": 50,
      "zIndex": 85,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "핀",
      "fontSize": 17
    },
    {
      "id": "quickstart-ko-87",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11444,
      "width": 900,
      "height": 110,
      "zIndex": 86,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "위 핀은 현재 시야 중심과 배율을 저장하고 목록에서 돌아갑니다. 핀이나 이름을 두 번 클릭해 바꾸고 Enter/다른 곳 클릭 저장, Esc 취소합니다. 이름 오른쪽 클릭도 가능하며 실행 취소됩니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-88",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11566,
      "width": 900,
      "height": 110,
      "zIndex": 87,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "핀과 글자 색 메뉴 또는 목록의 색으로 각각 바꿀 수 있습니다. Windows는 이 선택 필드를 저장하지만 이전 Mac 버전에서 다시 저장하면 사라질 수 있습니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-89",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11688,
      "width": 900,
      "height": 110,
      "zIndex": 88,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "핀 창은 새 핀 추가부터 표시하고 이름 입력에 초점을 둡니다. 검색과 기존 핀 목록은 그 아래에 있습니다. 목록은 캔버스와 같은 핀 그림 및 각 핀의 본체색과 글자색을 사용합니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-90",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11866,
      "width": 900,
      "height": 50,
      "zIndex": 89,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "19 · 화면 캔버스",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-91",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 11928,
      "width": 900,
      "height": 290,
      "zIndex": 90,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "홈, 화면 아이콘, 더 보기, Ctrl+Alt+A로 시작하며 작품 저장 후 메인 창을 숨깁니다. 실행 중인 바탕화면 위에 독립 투명 주석이 있습니다. 손잡이로 네 가장자리에 배치하고 스크롤바 없이 줄/열을 늘려 지우기/닫기를 표시합니다. 색, 레이어, 팔레트가 있고 채우기는 도형 메뉴에서 설정합니다. 지우개/레이저 재클릭으로 설정합니다. 지원되는 공통 도구는 일반 도구 모음의 표시 설정과 순서를 따릅니다. 핀과 보기 잠금은 제외됩니다. 도형 메뉴에는 동일한 9개 도형이 있습니다. 펜으로 거의 직선을 그리고 1초간 멈추면 직선으로 보정됩니다. 12pt 넘게 움직이면 자유 그리기 미리보기로 돌아옵니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-92",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12230,
      "width": 900,
      "height": 200,
      "zIndex": 91,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "그리기/조작 또는 Ctrl+Alt+D로 주석과 아래 앱 조작을 전환합니다. 개체 오른쪽 클릭으로 스타일, 복사, 복제, 삭제, 잠금, 순서를 바꾸고 이미 선택한 그룹을 유지합니다. 빈 곳 오른쪽 클릭은 미완료 동작만 취소합니다. Shift클릭/상자 선택으로 추가하며 방향은 포함/접촉 규칙입니다. 올가미는 닿은 개체를 선택합니다. 이동, 크기, 회전, 끝점과 Shift 수평/수직 선/화살표를 지원합니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-93",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12442,
      "width": 900,
      "height": 170,
      "zIndex": 92,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "T로 위치를 눌러 입력, Enter 줄바꿈, Ctrl+Enter/완료 확정, Esc 취소합니다. 글자 두 번 클릭이나 더 보기→선택 개체→글자 편집으로 수정합니다. 도구/모드 전환, 캡처, 내보내기, 종료 전에 초안을 확정합니다. 바뀐 필드만 잠기지 않은 개체에 적용하며 연속 슬라이더는 한 번에 실행 취소합니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-94",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12624,
      "width": 900,
      "height": 200,
      "zIndex": 93,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "캡처/Ctrl+Alt+S는 주석 포함 영역을 원래 화면 위치의 이미지로 만들며 별도 폴더를 만들지 않습니다. 더 보기→주석 내보내기는 투명 PNG/.heiban, 주석 저장은 수동 저장입니다. ×/Ctrl+Alt+Q는 독립 주석을 저장하고 메인 창으로 돌아오며 다음에 이어집니다. 휴지통/Ctrl+Alt+K는 추가 확인 없이 모두 지우고 실행 취소로 복원합니다. 키 충돌 시 도구 모음을 사용하세요. 주석은 주 작품에 자동 합치지 않습니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-95",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12892,
      "width": 900,
      "height": 50,
      "zIndex": 94,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "20 · 저장, 데이터와 내보내기",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-96",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12954,
      "width": 900,
      "height": 140,
      "zIndex": 95,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "홈 설정/더 보기→설정의 자동 저장은 기본 꺼짐이며 저장한 선택을 기억합니다. 켜면 일반 약15초, 화면 변경 중지 약1초 뒤 저장하고 동작 중이면 미룹니다. 끄면 정기 저장을 멈춥니다. Ctrl+S나 화면의 더 보기→주석 저장으로 수동 저장합니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-97",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13106,
      "width": 900,
      "height": 110,
      "zIndex": 96,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "홈 복귀, 작품/화면 전환, 정상 종료는 회전 표시와 함께 저장을 기다립니다. 실패하면 창과 내용을 유지합니다. 자동 저장을 끄면 충돌, 정전, 강제 종료로 미저장 변경을 잃을 수 있습니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-98",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13228,
      "width": 900,
      "height": 170,
      "zIndex": 97,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "현재 페이지 전체, 선택 개체, 현재 시야를 고른 후 .heiban/JSON/PNG/SVG/PDF/HTML로 내보냅니다. 원본/JSON은 모든 페이지를 유지합니다. PNG는 캔버스 렌더러, SVG는 벡터/이미지와 foreignObject(뷰어 지원 필요), PDF는 Edge WebView2와 원본 데이터, HTML은 오프라인 및 JSON입니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-99",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13410,
      "width": 900,
      "height": 140,
      "zIndex": 98,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "설치판은 %LOCALAPPDATA%\\HeiBan\\Windows\\, 포터블은 옆 Data/, Store는 앱 전용 데이터입니다. 이동 전 정상 종료하고 작품/휴지통/설정을 포함한 폴더 전체를 백업하세요. 포터블 폴더를 함께 유지하고 ZIP 안에서 실행하지 마세요.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-100",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13562,
      "width": 900,
      "height": 170,
      "zIndex": 99,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "홈의 가져오기에서 PDF, PPTX, PPT를 선택할 수 있습니다. 각 페이지는 별도 노트 페이지의 잠긴 배경 이미지가 되어 위에 주석을 쓸 수 있습니다. 범위를 지정하며 한 번에 200페이지와 렌더링 이미지 총 100 MB까지 지원합니다. 취소하면 미완성 작품을 만들지 않습니다. 원래 글자와 도형은 편집 가능한 요소가 아닙니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-101",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13744,
      "width": 900,
      "height": 200,
      "zIndex": 100,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "PPT/PPTX에는 데스크톱 PowerPoint가 필요합니다. 없으면 먼저 PDF로 변환하세요. 글꼴이 없으면 배치가 달라질 수 있습니다. 애니메이션, 영상, 전환, 상호 작용은 보존되지 않으며 암호화되거나 손상된 파일은 실패할 수 있습니다. 전체 노트를 PDF로 내보내려면 현재 페이지/전체 내용 범위에서 모든 페이지를 PDF로 내보내기를 켜세요. 선택 개체나 현재 보기 범위는 해당 범위만 내보냅니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-102",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14012,
      "width": 900,
      "height": 50,
      "zIndex": 101,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "21 · 단축키",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-103",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14074,
      "width": 900,
      "height": 50,
      "zIndex": 102,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "실행 취소 · 다시 실행 · 현재 페이지 지우기",
      "fontSize": 17
    },
    {
      "id": "quickstart-ko-104",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14136,
      "width": 900,
      "height": 110,
      "zIndex": 103,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Ctrl+S 저장, Ctrl+N 새 작품, Ctrl+Z/Ctrl+Y 실행 취소/다시 실행, Ctrl+C/Ctrl+V 복사/개체·이미지 붙이기, Delete 선택 삭제, Esc 동작/캡처/미완성 도형 취소.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-105",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14258,
      "width": 900,
      "height": 140,
      "zIndex": 104,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Space+끌기/가운데 끌기 이동, 휠/Ctrl+휠 확대, V/P/E/T 선택/펜/지우개/글자, Win+Shift+S 후 Ctrl+V 캡처 붙이기. 화면은 Ctrl+Alt에 A시작, D그리기/조작, S캡처, K지우기, Q종료입니다. 다른 앱과 충돌하면 도구 모음을 쓰세요.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-106",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14410,
      "width": 900,
      "height": 110,
      "zIndex": 105,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "실행 취소와 다시 실행은 편집 단계를 앞뒤로 이동합니다. 페이지 지우기는 확인 후 현재 페이지의 객체를 지우며 실행 취소할 수 있습니다. 다른 페이지는 유지됩니다. Delete는 선택한 객체를 삭제합니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-107",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14588,
      "width": 900,
      "height": 50,
      "zIndex": 106,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "22 · 앱 업데이트",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-108",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14650,
      "width": 900,
      "height": 140,
      "zIndex": 107,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "GitHub판은 홈→정보→업데이트 설정 또는 더 보기→업데이트 확인 및 설정입니다. 시작 약10초 뒤, 실행 중 매6시간 확인합니다. 자동/미리보기를 끄거나 수동 확인할 수 있으며 실행 중에만 확인합니다. 자동 저장과 별개입니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-109",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14802,
      "width": 900,
      "height": 140,
      "zIndex": 108,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "아키텍처/설치 종류와 크기/SHA-256을 확인합니다. 저장 성공 후 같은 설치의 모든 창이 닫히면 별도 업데이트 프로그램이 설치하고 다음 시작에 씁니다. 강제 종료/재시작하지 않습니다. 오프라인/중단/파일 점유는 현재 버전을 유지해 재시도하며 자동 업데이트 끄면 받은 업데이트도 적용하지 않습니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-110",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14954,
      "width": 900,
      "height": 200,
      "zIndex": 109,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "포터블은 Data/portable.dat/알 수 없는 파일을, 설치판은 데이터 위치를 보존하고 백업합니다. 결과/임시는 %LOCALAPPDATA%\\HeiBan\\Updates\\이며 작품은 전송하지 않습니다. 설치 중 드라이브 제거/전원 중단을 피하세요. Store판은 Store만 업데이트합니다. 해시는 Authenticode 서명이 아니므로 첫 설치 경고가 있을 수 있습니다. 이전 버전은 업데이트 기능을 얻으려 한 번 수동 업그레이드해야 합니다.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-111",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15222,
      "width": 900,
      "height": 50,
      "zIndex": 110,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "23 · 기능 범위와 제한",
      "fontSize": 28
    },
    {
      "id": "quickstart-ko-112",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15284,
      "width": 900,
      "height": 140,
      "zIndex": 111,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Windows 1.0.16는 제품 소유자의 동의를 받아 Microsoft Store 업데이트 패키지를 준비합니다. 실제 제공 여부는 Store 인증 및 게시 결과에 따릅니다. 장치 호환성과 알려진 제한은 개발 기록을 확인하세요.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ko-113",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15436,
      "width": 900,
      "height": 140,
      "zIndex": 112,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "클라우드/Google 동기화, 협업, 전용 마인드맵, 표, 수식, 프레임, 외부 PDF/SVG 원본 편집은 제공하지 않습니다. 알 수 없는 JSON 필드는 유지합니다. 작품 내용은 원래 언어이며 화면 언어 변경은 번역하지 않습니다.",
      "fontSize": 18
    },
