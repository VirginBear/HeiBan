    {
      "id": "quickstart-ko-16",
      "boardId": "heiban-windows-quickstart-v1",
      "pageId": "quickstart-2",
      "type": "text",
      "x": 32,
      "y": 455,
      "width": 890,
      "height": 140,
      "zIndex": 15,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "속성에는 선택한 개체에 맞는 설정만 나옵니다. 선 색/굵기, 가능한 채우기/그라데이션/불투명도, 글자와 기하 수치를 조정합니다. 실선, 파선, 점선, 일점쇄선은 견본을 보이고 도구 모음도 현재 스타일을 표시합니다. 그리기 전에 기본값을 설정할 수 있고 선택 개체의 변경은 다음 그리기 설정에도 적용됩니다.",
      "fontSize": 17
    },
