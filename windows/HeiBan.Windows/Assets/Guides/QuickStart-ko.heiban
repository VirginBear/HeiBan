    {
      "id": "quickstart-ko-11",
      "boardId": "heiban-windows-quickstart-v1",
      "pageId": "quickstart-1",
      "type": "text",
      "x": 32,
      "y": 475,
      "width": 890,
      "height": 140,
      "zIndex": 10,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "V로 선택, Ctrl+클릭으로 추가/해제, 올가미로 영역 선택합니다. 빈 곳에서 왼쪽→오른쪽은 파란 실선으로 완전히 포함된 개체만, 오른쪽→왼쪽은 녹색 점선으로 닿는 개체를 선택합니다. Ctrl/Shift+끌기로 추가하고 여러 개체를 함께 이동, 복사, 붙여넣기, 꾸미기, 삭제합니다.",
      "fontSize": 17
    },
