      "isLocked": false,
      "points": "[{\"x\":70,\"y\":13934.0,\"pressure\":1},{\"x\":80,\"y\":13937.711059388817,\"pressure\":1},{\"x\":90,\"y\":13941.191383079064,\"pressure\":1},{\"x\":100,\"y\":13944.22458140035,\"pressure\":1},{\"x\":110,\"y\":13946.622064772118,\"pressure\":1},{\"x\":120,\"y\":13948.234769290333,\"pressure\":1},{\"x\":130,\"y\":13948.962424799061,\"pressure\":1},{\"x\":140,\"y\":13948.75978920311,\"pressure\":1},{\"x\":150,\"y\":13947.639461402385,\"pressure\":1},{\"x\":160,\"y\":13945.671097953318,\"pressure\":1},{\"x\":170,\"y\":13942.97708216156,\"pressure\":1},{\"x\":180,\"y\":13939.724914880784,\"pressure\":1},{\"x\":190,\"y\":13936.116800120899,\"pressure\":1},{\"x\":200,\"y\":13932.377072982048,\"pressure\":1},{\"x\":210,\"y\":13928.738251584657,\"pressure\":1},{\"x\":220,\"y\":13925.426580218866,\"pressure\":1},{\"x\":230,\"y\":13922.647962570381,\"pressure\":1},{\"x\":240,\"y\":13920.57515962657,\"pressure\":1},{\"x\":250,\"y\":13919.337048235024,\"pressure\":1},{\"x\":260,\"y\":13919.010608165368,\"pressure\":1},{\"x\":270,\"y\":13919.616135880053,\"pressure\":1},{\"x\":280,\"y\":13921.115982598601,\"pressure\":1},{\"x\":290,\"y\":13923.416895116445,\"pressure\":1},{\"x\":300,\"y\":13926.37581383751,\"pressure\":1},{\"x\":310,\"y\":13929.808767527016,\"pressure\":1},{\"x\":320,\"y\":13933.502311751787,\"pressure\":1},{\"x\":330,\"y\":13937.226799821317,\"pressure\":1},{\"x\":340,\"y\":13940.75066110671,\"pressure\":1},{\"x\":350,\"y\":13943.854798980781,\"pressure\":1},{\"x\":360,\"y\":13946.346213185172,\"pressure\":1},{\"x\":370,\"y\":13948.069999651621,\"pressure\":1},{\"x\":380,\"y\":13948.918981686667,\"pressure\":1},{\"x\":390,\"y\":13948.840373699351,\"pressure\":1},{\"x\":400,\"y\":13947.83906315359,\"pressure\":1},{\"x\":410,\"y\":13945.977306689352,\"pressure\":1},{\"x\":420,\"y\":13943.370859306313,\"pressure\":1},{\"x\":430,\"y\":13940.181777278627,\"pressure\":1},{\"x\":440,\"y\":13936.608342280706,\"pressure\":1},{\"x\":450,\"y\":13932.872733193073,\"pressure\":1},{\"x\":460,\"y\":13929.207212095665,\"pressure\":1},{\"x\":470,\"y\":13925.839683336659,\"pressure\":1},{\"x\":480,\"y\":13922.979523543929,\"pressure\":1},{\"x\":490,\"y\":13920.804563600424,\"pressure\":1},{\"x\":500,\"y\":13919.45003198119,\"pressure\":1},{\"x\":510,\"y\":13919.000146901739,\"pressure\":1},{\"x\":520,\"y\":13919.48288003733,\"pressure\":1},{\"x\":530,\"y\":13920.868217379673,\"pressure\":1},{\"x\":540,\"y\":13923.070025362593,\"pressure\":1},{\"x\":550,\"y\":13925.951406229993,\"pressure\":1},{\"x\":560,\"y\":13929.333209675284,\"pressure\":1},{\"x\":570,\"y\":13933.005171539731,\"pressure\":1},{\"x\":580,\"y\":13936.738987019467,\"pressure\":1},{\"x\":590,\"y\":13940.3025055524,\"pressure\":1},{\"x\":600,\"y\":13943.474164815774,\"pressure\":1},{\"x\":610,\"y\":13946.056766398275,\"pressure\":1},{\"x\":620,\"y\":13947.88973664213,\"pressure\":1},{\"x\":630,\"y\":13948.859110335423,\"pressure\":1},{\"x\":640,\"y\":13948.904616516991,\"pressure\":1},{\"x\":650,\"y\":13948.023425832871,\"pressure\":1},{\"x\":660,\"y\":13946.27032645182,\"pressure\":1}]"
    },
    {
      "id": "quickstart-en-64",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "highlighter",
      "x": 700,
      "y": 13832,
      "width": 160,
      "height": 20,
      "zIndex": 63,
      "strokeColor": "#d9b927",
      "strokeWidth": 20,
      "fillColor": "none",
      "opacity": 0.45,
      "isLocked": false,
      "points": "[{\"x\": 710, \"y\": 13842}, {\"x\": 850, \"y\": 13842}]"
    },
    {
      "id": "quickstart-en-65",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14090,
      "width": 900,
      "height": 50,
      "zIndex": 64,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "13 · Ruler",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-66",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14152,
      "width": 900,
      "height": 50,
      "zIndex": 65,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Ruler",
      "fontSize": 17
    },
    {
      "id": "quickstart-en-67",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14214,
      "width": 900,
      "height": 230,
      "zIndex": 66,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Enable the ruler, drag its body to move it and drag endpoint handles to rotate. Move the gold pivot onto either drawing edge or either end; rotation stays around that pivot. Right-click the ruler, or use its settings, for the edge, 0–100% pivot position, 0.1° angle, opacity and length.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-68",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14456,
      "width": 900,
      "height": 170,
      "zIndex": 67,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Length is 20–150% of canvas width, initially 90%, and adapts to window size. A pen stroke started near an edge snaps along that edge for the whole stroke; drawing beyond the ruler still follows the same axis.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-69",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14694,
      "width": 900,
      "height": 50,
      "zIndex": 68,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "14 · Compass: prepare, lock, draw",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-70",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14756,
      "width": 900,
      "height": 50,
      "zIndex": 69,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Compass",
      "fontSize": 17
    },
    {
      "id": "quickstart-en-71",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14818,
      "width": 900,
      "height": 170,
      "zIndex": 70,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Prepare by dragging the center, radius handle and pen tip to position the circle and starting angle. These guides create no object. Click the center to turn it bright orange and lock center/radius.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-72",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15000,
      "width": 900,
      "height": 230,
      "zIndex": 71,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Drag the tip around the circumference to preview an oriented arc; crossing 0° remains continuous. Release to create one editable arc and one undo operation. A stationary click creates nothing. The arc has proportional resize/rotation controls and start/end angle handles.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-73",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15298,
      "width": 900,
      "height": 50,
      "zIndex": 72,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "15 · Laser pointer",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-74",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15360,
      "width": 900,
      "height": 50,
      "zIndex": 73,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Laser",
      "fontSize": 17
    },
    {
      "id": "quickstart-en-75",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15422,
      "width": 900,
      "height": 200,
      "zIndex": 74,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Choose Laser from the toolbar or More tools. Click the active laser again for settings; choose a dot, short trail or line, color, diameter, width, fade time and white core. The screen canvas also provides these settings.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-76",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15634,
      "width": 900,
      "height": 290,
      "zIndex": 75,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Laser marks are temporary pointers. They do not create saved objects or add undo operations. Trails have smooth continuous edges, a tapered tail and a soft glow. The point fades in about 0.3 seconds; short trails use 0.2–0.8 seconds; line mode uses the configured duration. Leaving the canvas breaks the trail so re-entry does not connect distant positions.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-77",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15992,
      "width": 900,
      "height": 50,
      "zIndex": 76,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "16 · Calculator and timer",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-78",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16054,
      "width": 900,
      "height": 50,
      "zIndex": 77,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Calculator · Timer and stopwatch",
      "fontSize": 17
    },
    {
      "id": "quickstart-en-79",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16116,
      "width": 900,
      "height": 200,
      "zIndex": 78,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Open Calculator or Timer from the upper + menu. Drag the title to move or collapse the panel. Calculator supports parentheses, scientific functions, π, e, Ans and keyboard/Enter; only Insert expression creates a text object.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-80",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16328,
      "width": 900,
      "height": 170,
      "zIndex": 79,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Timer offers a stopwatch, 5/15/25-minute countdowns and custom seconds. Closing its panel keeps it running and it notifies when time is up; reopening shows the current state.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-81",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16566,
      "width": 900,
      "height": 50,
      "zIndex": 80,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "17 · Images, screenshots and cropping",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-82",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16628,
      "width": 900,
      "height": 50,
      "zIndex": 81,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Import image · Screenshot",
      "fontSize": 17
    },
    {
      "id": "quickstart-en-83",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16690,
      "width": 900,
      "height": 260,
      "zIndex": 82,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Use Screenshot in + or the toolbar, then drag an area. Esc or right-click cancels; switching work/page or a timeout also cancels. The result becomes an image at the current view center with its original proportions; it is not saved into a separate screenshot folder. Win+Shift+S results can instead be pasted with Ctrl+V.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-84",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16962,
      "width": 900,
      "height": 260,
      "zIndex": 83,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Drag PNG/JPG/BMP files from Explorer onto the canvas. Images can move, resize and rotate. Select an image and use Crop image / Restore original in its color menu; enter a rectangle in original image pixels. Cropping preserves the source image. The built-in capture uses its own result, not unrelated clipboard images.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-85",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17290,
      "width": 900,
      "height": 50,
      "zIndex": 84,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "18 · View pins and colors",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-86",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17352,
      "width": 900,
      "height": 50,
      "zIndex": 85,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Pin",
      "fontSize": 17
    },
    {
      "id": "quickstart-en-87",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17414,
      "width": 900,
      "height": 200,
      "zIndex": 86,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "The upper pin control saves the current view center and zoom. Select an entry to return to it. Double-click a pin or its name to rename; Enter or clicking elsewhere saves, Esc cancels. Right-click names also offers rename, and edits support undo.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-88",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17626,
      "width": 900,
      "height": 170,
      "zIndex": 87,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Right-click a pin for Pin and text colors, or choose Colors in the pin list, to set each separately. Windows saves these optional colors; an older Mac version may remove them when resaving the work.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-89",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17808,
      "width": 900,
      "height": 170,
      "zIndex": 88,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "The pins dialog opens with Add and focuses the new name; search and existing pins follow below. The list draws the same pin as the canvas, using each pin’s body and text colors.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-90",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18046,
      "width": 900,
      "height": 50,
      "zIndex": 89,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "19 · Screen canvas",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-91",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18108,
      "width": 900,
      "height": 590,
      "zIndex": 90,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Start from the home sidebar, the screen icon or More tools; Ctrl+Alt+A also opens it. The current work saves and the main window hides. The desktop remains live beneath an independent transparent annotation canvas. Drag the toolbar grip to four edges; icon-only mode wraps without scrollbars, while labeled tabs stay in one row/column with arrow paging, keeping clear/close accessible. Color, layers and palette have entries; set shape fill in the Shapes menu. click Eraser or Laser again for settings. Supported shared tools follow the main toolbar visibility and order; pins and view lock are omitted. The Shapes menu contains the same nine shapes. With Pen, a nearly straight stroke snaps to a line after holding still for one second; moving more than 12 pt restores the freehand preview.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-92",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18710,
      "width": 900,
      "height": 410,
      "zIndex": 91,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Draw/Operate or Ctrl+Alt+D switches between annotation and passing input to the app below. Right-click an object to change style, copy, duplicate, delete, lock or reorder; clicking an already selected object preserves the group. Right-click empty space cancels only the unfinished gesture. Shift-click or box selection adds objects; box direction follows the same enclosed/touched rule. Lasso selects intersecting objects. Selection moves, resizes, rotates and adjusts endpoints. Shift constrains lines/arrows to horizontal/vertical.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-93",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19132,
      "width": 900,
      "height": 260,
      "zIndex": 92,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Choose T and click to type; Enter makes a new line, Ctrl+Enter/Done commits, Esc cancels. Double-click text or use More → Selected objects → Edit text. Switching tool/mode, capturing, exporting or ending commits a draft. Styles apply only changed values to unlocked selected objects and continuous slider edits undo together.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-94",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19404,
      "width": 900,
      "height": 440,
      "zIndex": 93,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Screenshot or Ctrl+Alt+S captures an area with annotations as an image at its original screen position, without a separate screenshot folder. More → Export annotations saves a transparent PNG or editable .heiban. More → Save annotations saves manually. × or Ctrl+Alt+Q saves the independent session and restores the main window; reopening resumes it. Trash or Ctrl+Alt+K clears all annotations without another prompt; Undo restores them. Shortcuts may be occupied by other apps; use the toolbar then. Screen annotations never automatically merge into the main work.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-95",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19912,
      "width": 900,
      "height": 50,
      "zIndex": 94,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "20 · Saving, data and export",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-96",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19974,
      "width": 900,
      "height": 290,
      "zIndex": 95,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Home Settings or More → Settings controls Auto-save, OFF by default. A saved choice persists. ON keeps regular canvas saves around every 15 seconds and screen saves about one second after changes stop; unfinished gestures postpone saving. OFF stops periodic work saves. Ctrl+S saves a regular work; More → Save annotations saves the screen canvas.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-97",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20276,
      "width": 900,
      "height": 200,
      "zIndex": 96,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Returning home, switching works/screen canvas and normal exit save and wait, showing a spinning progress indicator. A save failure keeps the window and content. With auto-save OFF, a crash, power failure or forced termination may lose unsaved changes.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-98",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20488,
      "width": 900,
      "height": 350,
      "zIndex": 97,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "For export, select all content on the current page, selected objects or the current view, then .heiban, JSON, PNG, SVG, PDF or HTML. Editable work/JSON always keeps all pages; images and reading formats follow the chosen scope. PNG uses the canvas renderer; SVG includes vectors/images and rich-text foreignObject (viewer support required). PDF needs Windows Edge WebView2 and includes editable source data; HTML reads offline and includes editable JSON.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-99",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20850,
      "width": 900,
      "height": 260,
      "zIndex": 98,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Installed builds store data under %LOCALAPPDATA%\\HeiBan\\Windows\\; portable builds use Data/ beside the app. Store builds use their own app data location. Close the app and back up the complete data folder, including works, trash and settings, before migration. Keep the portable folder together; do not run directly inside a ZIP.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-100",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 21122,
      "width": 900,
      "height": 260,
      "zIndex": 99,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Home → Import accepts PDF, PPTX and PPT. Each page becomes a locked background image on a separate notebook page for annotation. Choose a page range, up to 200 pages and 100 MB of rendered images per import. Cancelling creates no partial work. Original text and shapes do not become editable elements.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-101",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 21394,
      "width": 900,
      "height": 320,
      "zIndex": 100,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "PPT/PPTX needs desktop PowerPoint on this computer; otherwise convert to PDF first. Missing fonts can alter layout. Animation, video, transitions and interactivity are not preserved; encrypted or damaged files may fail. For a complete notebook PDF, choose current page/all content and enable Export all pages to PDF. Selected objects/current view continue to export only that scope.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-102",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 21782,
      "width": 900,
      "height": 50,
      "zIndex": 101,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "21 · Keyboard reference",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-103",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 21844,
      "width": 900,
      "height": 50,
      "zIndex": 102,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Undo · Redo · Clear this page",
      "fontSize": 17
    },
    {
      "id": "quickstart-en-104",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 21906,
      "width": 900,
      "height": 200,
      "zIndex": 103,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Ctrl+S — save; Ctrl+N — new work; Ctrl+Z / Ctrl+Y — undo/redo; Ctrl+C / Ctrl+V — copy selected objects / paste objects or clipboard images; Delete — delete selection; Esc — cancel a gesture/capture/unfinished shape.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-105",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 22118,
      "width": 900,
      "height": 260,
      "zIndex": 104,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Space+drag or middle-drag — pan; wheel or Ctrl+wheel — zoom; V / P / E / T — Selection / Pen / Eraser / Text; Win+Shift+S then Ctrl+V — Windows capture and paste. Screen: Ctrl+Alt+A — start; D — Draw/Operate; S — capture; K — clear; Q — end (each with Ctrl+Alt). Use toolbar controls if another app reserves a shortcut.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-106",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 22390,
      "width": 900,
      "height": 170,
      "zIndex": 105,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Undo and Redo step backward or forward through edits. Clear page asks for confirmation, removes objects on the current page and can be undone; other pages are unchanged. Delete removes selected objects.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-107",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 22628,
      "width": 900,
      "height": 50,
      "zIndex": 106,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "22 · App updates",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-108",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 22690,
      "width": 900,
      "height": 260,
      "zIndex": 107,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "GitHub builds offer update settings under Home → About → Update settings or More → Check for updates and update settings. Background checks begin about ten seconds after startup and repeat every six hours while the app runs. Disable automatic checks or preview versions, or check manually. This is separate from auto-save.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-109",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 22962,
      "width": 900,
      "height": 290,
      "zIndex": 108,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Downloads match architecture/install type and verify size/SHA-256. After saving succeeds and all windows of the installation close, a separate updater installs for the next launch, without forcing close or reopening. Interrupted/offline downloads or occupied files keep the current version for a later retry. Disabling auto-update also prevents a staged update from applying.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-110",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23264,
      "width": 900,
      "height": 410,
      "zIndex": 109,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Portable updates preserve Data, portable.dat and unknown files; installed updates keep the data location. Backups are retained. Update staging/results are under %LOCALAPPDATA%\\HeiBan\\Updates\\; works are not uploaded. Do not remove a drive or interrupt power during installation. Microsoft Store builds update through the Store, never by GitHub file replacement. Hash checks are not Authenticode signatures; Windows may still warn on first installation. Older builds need a one-time manual upgrade to gain the updater.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-111",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23742,
      "width": 900,
      "height": 50,
      "zIndex": 110,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "23 · Scope and known limits",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-112",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23804,
      "width": 900,
      "height": 200,
      "zIndex": 111,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Windows 1.0.16 is approved by the product owner for a Microsoft Store update package. Availability depends on Store certification and publication; consult the development records for device compatibility and known limitations.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-113",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24016,
      "width": 900,
      "height": 260,
      "zIndex": 112,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Cloud/Google sync, collaboration, dedicated mind maps, tables, formulas, frames and editing external PDF/SVG as original works are not delivered features. Unknown document JSON fields are retained. A shared .heiban can contain user text in its original language; changing the UI does not translate it.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-114",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24344,
      "width": 900,
      "height": 50,
      "zIndex": 113,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "24 · Background settings in practice",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-115",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24406,
      "width": 900,
      "height": 230,
      "zIndex": 114,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "For a new work, choose the canvas type before size and background. Infinite canvases do not need dimensions; bounded boards start at 16:9 but can be changed. Plain, ruled, dots, grid and music staff patterns can be selected at creation or later through Canvas background.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-116",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24648,
      "width": 900,
      "height": 170,
      "zIndex": 115,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "For an existing work, use Apply to commit or Cancel to keep the original; the change is undoable. Background settings change the paper, not the color of existing strokes or text.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-117",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24886,
      "width": 900,
      "height": 50,
      "zIndex": 116,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "25 · Layer order and editing feedback",
      "fontSize": 28
    },
    {
      "id": "quickstart-en-118",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24948,
      "width": 900,
      "height": 50,
      "zIndex": 117,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Object layers",
      "fontSize": 17
    },
    {
      "id": "quickstart-en-119",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 25010,
      "width": 900,
      "height": 320,
      "zIndex": 118,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Open Object layers from the toolbar or More. Top rows are in front. Drag the gray double bar to the left of an icon onto the upper/lower half of another row to insert above/below it. The original row fades, a name/icon preview follows the pointer and a green insertion line marks the drop location. Rename layers without changing object identity; an empty name restores automatic naming.",
      "fontSize": 18
    },
    {
      "id": "quickstart-en-120",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 25342,
      "width": 900,
      "height": 290,
      "zIndex": 119,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Hidden objects remain available in the panel; locked objects resist batch move/delete. Properties and Object layers are separate panels. Directional resize/rotation cursors, saved/pending indicators, checked multi-select circles and eraser range previews help explain the current action. Report unexpected behavior from this trial before a formal update is approved.",
      "fontSize": 18
    }
  ]
}