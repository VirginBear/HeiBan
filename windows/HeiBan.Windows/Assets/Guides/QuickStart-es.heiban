33193073,\"pressure\":1},{\"x\":460,\"y\":13239.207212095665,\"pressure\":1},{\"x\":470,\"y\":13235.839683336659,\"pressure\":1},{\"x\":480,\"y\":13232.979523543929,\"pressure\":1},{\"x\":490,\"y\":13230.804563600424,\"pressure\":1},{\"x\":500,\"y\":13229.45003198119,\"pressure\":1},{\"x\":510,\"y\":13229.000146901739,\"pressure\":1},{\"x\":520,\"y\":13229.48288003733,\"pressure\":1},{\"x\":530,\"y\":13230.868217379673,\"pressure\":1},{\"x\":540,\"y\":13233.070025362593,\"pressure\":1},{\"x\":550,\"y\":13235.951406229993,\"pressure\":1},{\"x\":560,\"y\":13239.333209675284,\"pressure\":1},{\"x\":570,\"y\":13243.005171539731,\"pressure\":1},{\"x\":580,\"y\":13246.738987019467,\"pressure\":1},{\"x\":590,\"y\":13250.3025055524,\"pressure\":1},{\"x\":600,\"y\":13253.474164815774,\"pressure\":1},{\"x\":610,\"y\":13256.056766398275,\"pressure\":1},{\"x\":620,\"y\":13257.88973664213,\"pressure\":1},{\"x\":630,\"y\":13258.859110335423,\"pressure\":1},{\"x\":640,\"y\":13258.904616516991,\"pressure\":1},{\"x\":650,\"y\":13258.023425832871,\"pressure\":1},{\"x\":660,\"y\":13256.27032645182,\"pressure\":1}]"
