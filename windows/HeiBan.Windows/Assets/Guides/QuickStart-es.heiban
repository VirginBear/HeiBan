      "points": "[{\"x\": 554, \"y\": 9178}, {\"x\": 474, \"y\": 9288}, {\"x\": 634, \"y\": 9288}]"
    },
    {
      "id": "quickstart-es-42",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "arrow",
      "x": 690,
      "y": 9178,
      "width": 150,
      "height": 100,
      "zIndex": 41,
      "strokeColor": "#ba652b",
