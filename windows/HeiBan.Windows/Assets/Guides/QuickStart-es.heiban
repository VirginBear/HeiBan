    },
    {
      "id": "quickstart-es-62",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 13169,
      "width": 610,
      "height": 42,
      "zIndex": 61,
      "strokeColor": "#4189c7",
      "strokeWidth": 6,
      "fillColor": "none",
