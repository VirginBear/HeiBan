    {
      "id": "quickstart-es-71",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "highlighter",
      "x": 700,
      "y": 15402,
      "width": 160,
      "height": 20,
      "zIndex": 70,
      "strokeColor": "#d9b927",
