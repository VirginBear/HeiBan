  "objects": [
    {
      "id": "quickstart-ar-1",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 28,
      "width": 900,
      "height": 50,
      "zIndex": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "دليل الاستخدام · جميع الأدوات",
      "fontSize": 32
    },
    {
      "id": "quickstart-ar-2",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 90,
      "width": 900,
      "height": 530,
      "zIndex": 1,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "يعرض الشريط الرموز مع النص افتراضيًا. الفرشاة ونمط الخط موجودان في المفضلة ويمكن تخصيصهما. عند الاستخدام الأول تضاف ملاحظة لا نهائية قابلة للتحرير بعنوان دليل الاستخدام · جميع الأدوات تتضمن شرح كل الأدوات وأمثلة. حرّك العرض بالزر الأوسط أو Space مع السحب وكبّر بالعجلة وانتقل إلى الفصول من قائمة الدبابيس. تبقى الأمثلة والأعمال السابقة محفوظة؛ لا يعاد إنشاء هذا الدليل عند كل تشغيل بعد تعديله أو حذفه. يظهر مسح الصفحة الحالية ضمن الشائعة افتراضيًا. يضيف التحديث هذا الخيار مع الحفاظ على اختياراتك الأخرى. تستخدم اللوحتان رموز المخطط نفسها وشبكة الأشكال ذات الأزرار التسعة. يبقى التحديد والليزر خارج جميع التبويبات. يضاف الليزر إلى الشائعة افتراضيًا دون زر مكرر. انقره مجددًا لفتح الإعدادات.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-3",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 632,
      "width": 900,
      "height": 470,
      "zIndex": 2,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "01 لغة الواجهة والدليل · 02 بدء الاستخدام · 03 الرئيسية ومكتبة الأعمال · 04 أنواع اللوحات والصفحات · 05 التحريك والتكبير وقفل العرض · 06 التنقل وأشرطة الأدوات · 07 القلم والفرش · 08 الخطوط والأسهم والأشكال والمنحنيات · 09 التحديد والتحويل · 10 الخصائص والألوان والأنماط · 11 النص والملاحظات اللاصقة · 12 الممحاة · 13 المسطرة · 14 الفرجار: إعداد وقفل ورسم · 15 مؤشر الليزر · 16 الحاسبة والمؤقت · 17 الصور واللقطات والقص · 18 دبابيس العرض والألوان · 19 لوحة الشاشة · 20 الحفظ والبيانات والتصدير · 21 اختصارات لوحة المفاتيح · 22 تحديث التطبيق · 23 النطاق والقيود · 24 نصائح الخلفية · 25 ترتيب الطبقات ومؤشرات العمل",
      "fontSize": 16
    },
    {
      "id": "quickstart-ar-4",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 1170,
      "width": 900,
      "height": 50,
      "zIndex": 3,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "01 · لغة الواجهة والدليل",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-5",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 1232,
      "width": 900,
      "height": 290,
      "zIndex": 4,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اختر اللغة أسفل الشريط الجانبي في الصفحة الرئيسية، أو رمز 文/A عند طيه. اللغات العشر هي الصينية التقليدية (الافتراضية)، الصينية المبسطة، الإنجليزية، اليابانية، الكورية، الإسبانية، الفرنسية، الألمانية، البرتغالية البرازيلية والعربية. يُطبّق الاختيار بعد حفظه فورًا ويُحفظ للتشغيل التالي. لا تُترجم أسماء الأعمال ونصوصها الحالية؛ تستخدم الأسماء الافتراضية الجديدة اللغة الحالية.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-6",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 1534,
      "width": 900,
      "height": 230,
      "zIndex": 5,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "يفتح الدليل بلغة الواجهة. يغيّر محدد اللغة هنا الدليل فقط ولا يغيّر إعداد التطبيق. تعمل الصفحات والتنقل والبحث دون اتصال. العربية من اليمين إلى اليسار دون عكس إحداثيات اللوحة. قد تستخدم نوافذ اختيار الملفات ورسائل الخطأ الأصلية لغة أخرى؛ وقد تحتاج بعض عناصر النظام إلى إعادة التشغيل.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-7",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 1832,
      "width": 900,
      "height": 50,
      "zIndex": 6,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "02 · بدء الاستخدام",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-8",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 1894,
      "width": 900,
      "height": 140,
      "zIndex": 7,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اضغط + في الرئيسية لإنشاء دفتر أو لوحة غير محدودة أو لوحة محدودة. أدخل الاسم واختر لون الخلفية ونمطها. ارسم بالقلم واستخدم التحديد (V) لتحريك العناصر وتعديلها.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-9",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 2046,
      "width": 900,
      "height": 140,
      "zIndex": 8,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "الحفظ التلقائي معطّل افتراضيًا. استخدم Ctrl+S للحفظ اليدوي؛ يحفظ التطبيق أيضًا عند مغادرة العمل أو الإغلاق العادي. صدّر .heiban لنسخة قابلة للتحرير.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-10",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 2254,
      "width": 900,
      "height": 50,
      "zIndex": 9,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "03 · الرئيسية ومكتبة الأعمال",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-11",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 2316,
      "width": 900,
      "height": 200,
      "zIndex": 10,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "نقرة واحدة تُبرز البطاقة دون شريط إجراءات جماعية. افتح بالنقر المزدوج أو بزر الفأرة الأيمن ثم فتح العمل. تتوفر أيضًا المفضلة وإعادة التسمية والتكرار وسلة المحذوفات. تحتفظ السلة بالأصل القابل للتحرير؛ انقر بطاقة فيها مرتين للاستعادة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-12",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 2528,
      "width": 900,
      "height": 560,
      "zIndex": 11,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "الدائرة المتقطعة بجانب الاستيراد تفتح التحديد المتعدد؛ الدائرة بعلامة صح تشير إلى المحدد. اختر النتائج كلها أو بطاقات منفردة ثم انقلها إلى السلة، واضغط تم للخروج. ابحث بالاسم وصفّ حسب النوع ورتّب بالتعديل أو الإنشاء أو الاسم، واختر صورًا مصغرة160/190/250 pt. استورد .heiban أو .blackboard.json؛ الشريط الجانبي يعرض الكل والمفضلة والسلة. يعرض الشريط الرموز مع النص افتراضيًا. الفرشاة ونمط الخط موجودان في المفضلة ويمكن تخصيصهما. عند الاستخدام الأول تضاف ملاحظة لا نهائية قابلة للتحرير بعنوان دليل الاستخدام · جميع الأدوات تتضمن شرح كل الأدوات وأمثلة. حرّك العرض بالزر الأوسط أو Space مع السحب وكبّر بالعجلة وانتقل إلى الفصول من قائمة الدبابيس. تبقى الأمثلة والأعمال السابقة محفوظة؛ لا يعاد إنشاء هذا الدليل عند كل تشغيل بعد تعديله أو حذفه.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-13",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 3156,
      "width": 900,
      "height": 50,
      "zIndex": 12,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "04 · أنواع اللوحات والصفحات",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-14",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 3218,
      "width": 900,
      "height": 170,
      "zIndex": 13,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "صفحات الدفتر مستقلة. الرقم والأسهم في الأسفل للتنقل و+ للإضافة. قائمة الصفحات للقفز وإعادة التسمية والتكرار والترتيب والحذف. اللوحة غير المحدودة تمتد بكل اتجاه، والمحدودة ذات حدود ثابتة للعروض والتنسيق.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-15",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 3400,
      "width": 900,
      "height": 230,
      "zIndex": 14,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "لا تحتاج غير المحدودة إلى اختيار الحجم. تبدأ المحدودة الجديدة بنسبة16:9 (1920×1080)، مع A4 عمودي/أفقي أو1:1. يتذكر الحوار الحجم لكل نوع. الإنشاء والخلفية يوفران سادة وخطوطًا ونقاطًا وشبكة ومدرجًا موسيقيًا ولونًا. تطبيق يغيّر الموجود؛ إلغاء يحافظ عليه؛ يمكن التراجع بخطوة واحدة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-16",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 3698,
      "width": 900,
      "height": 50,
      "zIndex": 15,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "05 · التحريك والتكبير وقفل العرض",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-17",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 3760,
      "width": 900,
      "height": 50,
      "zIndex": 16,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "قفل العرض: منع التحريك والتكبير",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-18",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 3822,
      "width": 900,
      "height": 170,
      "zIndex": 17,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "العجلة أو Ctrl+العجلة تكبّر حول المؤشر؛ العجلة الأفقية تحرّك. اسحب بالزر الأوسط أو مع Space والزر الأيسر. في القراءة اسحب بالأيسر. التحكم بالتكبير يوفر نسبًا جاهزة وملاءمة المحتوى وإعادة العرض.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-19",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 4004,
      "width": 900,
      "height": 200,
      "zIndex": 18,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "قفل العرض يمنع التحريك والتكبير بالعجلة. يتغير رمز القفل في الشريط والزاوية معًا؛ فكّه لتحريك العرض. أثناء التحريك مع الضغط على زر الفأرة الأوسط، يظهر مؤشر يد قابضة للدلالة على سحب اللوحة. يعود المؤشر العادي عند الإفلات.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-20",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 4272,
      "width": 900,
      "height": 50,
      "zIndex": 19,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "06 · التنقل وأشرطة الأدوات",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-21",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 4334,
      "width": 900,
      "height": 50,
      "zIndex": 20,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "موضع الإرساء",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-22",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 4396,
      "width": 900,
      "height": 170,
      "zIndex": 21,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "التنقل العلوي يجمع الرئيسية والقراءة/التحرير والدبابيس و+ والمزيد وحالة الحفظ والتثبيت. دون تثبيت يطوى عند مغادرة المؤشر. علامة صح تعني محفوظًا؛ الدائرة المتقطعة تعني انتظارًا أو حفظًا جاريًا أو غير مكتمل.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-23",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 4578,
      "width": 900,
      "height": 170,
      "zIndex": 22,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اسحب المقبض إلى أي حافة: أفقي أعلى/أسفل، عمودي على الجانبين. المزيد ← تخصيص الشريط يغيّر الظهور والترتيب؛ الأدوات المخفية تبقى في المزيد. طبقات العناصر لوحة منفصلة. يتكيف شريط الشاشة دون أشرطة تمرير.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-24",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 4760,
      "width": 900,
      "height": 380,
      "zIndex": 23,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "من إعدادات الصفحة الرئيسية أو المزيد ← تخصيص شريط الأدوات، اختر الرموز فقط أو تبويبات مع نص: الشائعة والرسم والإدراج والإدارة. تبقى أداة التحديد (V) ظاهرة. الأدوات في صف أو عمود واحد؛ تنقل الأسهم بين المجموعات عند ضيق المساحة. التحديد الأيسر يُظهر الأداة، وخيار الشائعة يضيفها إلى ذلك التبويب. تتوفر خيارات تحديد الكل والافتراضي والترتيب. تستخدم لوحات التطبيق وحواراته تصميم HeiBan بالأبيض الورقي والأخضر دون اتباع وضع Windows الفاتح/الداكن. يدير Windows منتقي الملفات الخاص بالنظام.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-25",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 5152,
      "width": 900,
      "height": 530,
      "zIndex": 24,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "يعرض الشريط الرموز مع النص افتراضيًا. الفرشاة ونمط الخط موجودان في المفضلة ويمكن تخصيصهما. عند الاستخدام الأول تضاف ملاحظة لا نهائية قابلة للتحرير بعنوان دليل الاستخدام · جميع الأدوات تتضمن شرح كل الأدوات وأمثلة. حرّك العرض بالزر الأوسط أو Space مع السحب وكبّر بالعجلة وانتقل إلى الفصول من قائمة الدبابيس. تبقى الأمثلة والأعمال السابقة محفوظة؛ لا يعاد إنشاء هذا الدليل عند كل تشغيل بعد تعديله أو حذفه. يظهر مسح الصفحة الحالية ضمن الشائعة افتراضيًا. يضيف التحديث هذا الخيار مع الحفاظ على اختياراتك الأخرى. تستخدم اللوحتان رموز المخطط نفسها وشبكة الأشكال ذات الأزرار التسعة. يبقى التحديد والليزر خارج جميع التبويبات. يضاف الليزر إلى الشائعة افتراضيًا دون زر مكرر. انقره مجددًا لفتح الإعدادات.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-26",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 5750,
      "width": 900,
      "height": 50,
      "zIndex": 25,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "07 · القلم والفرش",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-27",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 5812,
      "width": 900,
      "height": 80,
      "zIndex": 26,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "قلم · قلم تمييز · فرشاة طلاء · إعدادات الفرشاة والعناصر · شريط إخفاء الأسئلة",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-28",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 5904,
      "width": 900,
      "height": 380,
      "zIndex": 27,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اختر القلم أو قلم التمييز أو أداة رسم ثم الفرشاة لضبط اللون والعرض والعتامة. اضبط عجلة الألوان واضغط + في الألوان المحفوظة. انقر لونًا لتطبيقه؛ استخدم الإدارة أو قائمة السياق لإزالته أو استعد الألوان الافتراضية. تبقى اللوحة الفارغة فارغة بعد إعادة التشغيل. تشترك لوحتا الرسم العادية وعلى الشاشة في الألوان. تظهر أداة الرسم المحددة فقط خطًا بلون الضربة التالية. تحتوي لوحة الفرشاة على منطقة تمرير واحدة. أزيل محدد الأنواع الذي لا يملك تأثيرات مادية، مع الاحتفاظ بحقول المستندات القديمة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-29",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 6296,
      "width": 900,
      "height": 410,
      "zIndex": 28,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "بالقلم المتجهي ارسم قريبًا من المستقيم ثم أبقِ الضغط ثابتًا ثانية واحدة ليصبح مستقيمًا. حركة أكبر من12 pt تعيد المعاينة الأصلية؛ الإفلات يثبت عملية واحدة قابلة للتراجع. شريط إخفاء السؤال في المزيد يُظهر/يخفي بالنقر المزدوج أو الإعدادات ويدعم التراجع. لا تحدد ضربات القلم والتظليل والطلاء تلقائيًا ولا يظهر إطار بعد إنهائها. اضغط V وحدد العنصر لنقله أو تغيير حجمه أو تدويره؛ يفتح النقر المزدوج الخصائص التفصيلية. تحافظ ممحاة السبورة على زاويتها من أعلى اليسار إلى أسفل اليمين وسماكتها مع تقليل طولها بنسبة 20%.",
      "fontSize": 18
    },
