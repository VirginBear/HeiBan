    {
      "id": "quickstart-ar-42",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9456,
      "width": 900,
      "height": 50,
      "zIndex": 41,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "09 · الخطوط والأسهم والأشكال والمنحنيات",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-43",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9518,
      "width": 900,
      "height": 50,
      "zIndex": 42,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "أشكال · منحنى · المغناطيس",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-44",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9580,
      "width": 900,
      "height": 200,
      "zIndex": 43,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "أنشئ خطًا/سهمًا بالسحب أو النقر A ثم B. حرّك الجسم أو الطرفين منفصلين. الخصائص تختار مقطعًا أو امتدادًا نحو A/B أو الجانبين دون تغيير الطرفين الأصليين. طول رأس السهم وعرضه مستقلان؛ سُمك الخط يغيّر محيط الرأس أيضًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-45",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 9792,
      "width": 900,
      "height": 230,
      "zIndex": 44,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "المستطيل والدائرة والمعين والخماسي والنجمة بالسحب؛ المثلث والرباعي بالنقاط. المنحنى ثلاث نقاط: بدء المعاينة، الانحناء، التأكيد. التحديد يعدّل الرؤوس ونقاط التحكم؛ Esc يلغي الشكل غير المكتمل. اللون والخصائص يضبطان الخط والتعبئة والتدرج والعتامة المناسبة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-46",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 10034,
      "width": 900,
      "height": 620,
      "zIndex": 45,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تبقى أداة الرسم نشطة بعد الإنشاء. تعرض المثلثات والرباعيات مقاطع مستقيمة، والمنحنى وحده معاينة منحنية. تبدأ الدوائر والمعينات والخماسيات والنجوم من المركز، والمستطيلات من الزاوية. يعمل المغناطيس من النقطة الأولى بحلقة خضراء ضمن نحو 10 DIP على الشاشة. للمستطيل تسع نقاط: أربع زوايا وأربعة منتصفات ومركز؛ وللمثلث ثلاثة رؤوس وثلاثة منتصفات. تشمل المضلعات الأخرى منتصفات الأضلاع والخطوط والأسهم الطرفين والمنتصف. تشمل الدوائر وأقواس الفرجار المركز والنقاط الأربع الأساسية، والأقواس طرفيها أيضًا. تُستبعد العناصر المخفية وتبقى الأشكال المقفلة مراجع دون تحريكها. يقتصر جذب المغناطيس على نقاط إنشاء الأشكال الهندسية وتحديد موضع الفرجار. يحافظ القلم وقلم التمييز وفرشاة الطلاء على مسار الرسم الحر عند عبور الخطوط الموجودة، في اللوحة العادية ولوحة الشاشة. ويظل الإسقاط على المسطرة والتحويل إلى خط مستقيم بعد التوقف 0.8 ثانية وفق قواعدهما الخاصة.",
      "fontSize": 18
    },
