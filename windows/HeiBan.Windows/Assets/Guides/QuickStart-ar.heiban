    },
    {
      "id": "quickstart-ar-34",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 7014,
      "width": 900,
      "height": 50,
      "zIndex": 33,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "08 · الخطوط والأسهم والأشكال والمنحنيات",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-35",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 7076,
      "width": 900,
      "height": 50,
      "zIndex": 34,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "أشكال · منحنى · المغناطيس",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-36",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 7138,
      "width": 900,
      "height": 200,
      "zIndex": 35,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "أنشئ خطًا/سهمًا بالسحب أو النقر A ثم B. حرّك الجسم أو الطرفين منفصلين. الخصائص تختار مقطعًا أو امتدادًا نحو A/B أو الجانبين دون تغيير الطرفين الأصليين. طول رأس السهم وعرضه مستقلان؛ سُمك الخط يغيّر محيط الرأس أيضًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-37",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 7350,
      "width": 900,
      "height": 230,
      "zIndex": 36,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "المستطيل والدائرة والمعين والخماسي والنجمة بالسحب؛ المثلث والرباعي بالنقاط. المنحنى ثلاث نقاط: بدء المعاينة، الانحناء، التأكيد. التحديد يعدّل الرؤوس ونقاط التحكم؛ Esc يلغي الشكل غير المكتمل. اللون والخصائص يضبطان الخط والتعبئة والتدرج والعتامة المناسبة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-38",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 7592,
      "width": 900,
      "height": 620,
      "zIndex": 37,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تبقى أداة الرسم نشطة بعد الإنشاء. تعرض المثلثات والرباعيات مقاطع مستقيمة، والمنحنى وحده معاينة منحنية. تبدأ الدوائر والمعينات والخماسيات والنجوم من المركز، والمستطيلات من الزاوية. يعمل المغناطيس من النقطة الأولى بحلقة خضراء ضمن نحو 10 DIP على الشاشة. للمستطيل تسع نقاط: أربع زوايا وأربعة منتصفات ومركز؛ وللمثلث ثلاثة رؤوس وثلاثة منتصفات. تشمل المضلعات الأخرى منتصفات الأضلاع والخطوط والأسهم الطرفين والمنتصف. تشمل الدوائر وأقواس الفرجار المركز والنقاط الأربع الأساسية، والأقواس طرفيها أيضًا. تُستبعد العناصر المخفية وتبقى الأشكال المقفلة مراجع دون تحريكها. يقتصر جذب المغناطيس على نقاط إنشاء الأشكال الهندسية وتحديد موضع الفرجار. يحافظ القلم وقلم التمييز وفرشاة الطلاء على مسار الرسم الحر عند عبور الخطوط الموجودة، في اللوحة العادية ولوحة الشاشة. ويظل الإسقاط على المسطرة والتحويل إلى خط مستقيم بعد التوقف ثانية واحدة وفق قواعدهما الخاصة.",
      "fontSize": 18
    },
