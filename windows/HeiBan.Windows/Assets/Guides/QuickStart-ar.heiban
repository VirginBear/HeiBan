      "fontSize": 17
    },
    {
      "id": "quickstart-ar-67",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12054,
      "width": 900,
      "height": 170,
      "zIndex": 66,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اسحب الجسم للتحريك ومقابض الأطراف للدوران. انقل المحور الذهبي إلى أي حافة رسم أو طرف؛ يدور حوله. الزر الأيمن/الإعدادات يضبط الحافة وموضع0–100% وزاوية0.1° والعتامة والطول.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-68",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12236,
      "width": 900,
      "height": 140,
      "zIndex": 67,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "الطول20–150% من عرض اللوحة، افتراضي90%، ويتكيف مع النافذة. الخط الذي يبدأ قرب الحافة يلتزم محورها طوال الرسم حتى خارج طول المسطرة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-69",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12444,
      "width": 900,
      "height": 50,
      "zIndex": 68,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "14 · الفرجار: إعداد وقفل ورسم",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-70",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12506,
      "width": 900,
      "height": 50,
      "zIndex": 69,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "فرجار",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-71",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12568,
      "width": 900,
      "height": 110,
      "zIndex": 70,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "حرّك المركز ونصف القطر والطرف لتجهيز الموضع والزاوية دون عنصر. انقر المركز فيصبح برتقاليًا ويُقفل المركز ونصف القطر.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-72",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12690,
      "width": 900,
      "height": 170,
      "zIndex": 71,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اسحب الطرف على المحيط لمعاينة قوس موجه مستمر عند عبور0°. أفلت لإنشاء قوس قابل للتحرير وعملية تراجع واحدة. النقرة الساكنة لا تنشئ شيئًا. للقوس حجم متناسب ودوران ومقابض زوايا البداية والنهاية.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-73",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12928,
      "width": 900,
      "height": 50,
      "zIndex": 72,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "15 · مؤشر الليزر",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-74",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 12990,
      "width": 900,
      "height": 50,
      "zIndex": 73,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "ليزر",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-75",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13052,
      "width": 900,
      "height": 140,
      "zIndex": 74,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اختر من الشريط/المزيد وانقر الليزر النشط ثانية لضبط نقطة أو أثر قصير أو خط ولون وقطر وسُمك وزمن تلاشي وقلب أبيض. متاح أيضًا على الشاشة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-76",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13204,
      "width": 900,
      "height": 230,
      "zIndex": 75,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "الليزر مؤقت، ولا ينشئ عناصر محفوظة أو عمليات تراجع. يظهر أثر الليزر بحواف ناعمة متصلة وذيل متناقص ووهج لطيف. تتلاشى النقطة خلال نحو 0.3 ثانية، والأثر القصير خلال 0.2–0.8 ثانية، ويستخدم وضع الخط المدة المحددة. مغادرة اللوحة تقطع الأثر حتى لا يصل بين موضعين متباعدين عند العودة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-77",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13502,
      "width": 900,
      "height": 50,
      "zIndex": 76,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "16 · الحاسبة والمؤقت",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-78",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13564,
      "width": 900,
      "height": 50,
      "zIndex": 77,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "آلة حاسبة · المؤقت وساعة الإيقاف",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-79",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13626,
      "width": 900,
      "height": 140,
      "zIndex": 78,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "افتح من + واسحب العنوان أو اطوِ اللوحة. الحاسبة تدعم الأقواس والدوال العلمية وπ وe وAns ولوحة المفاتيح/Enter. إدراج التعبير فقط ينشئ عنصر نص.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-80",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13778,
      "width": 900,
      "height": 110,
      "zIndex": 79,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "المؤقت يدعم ساعة إيقاف و5/15/25 دقيقة وثواني مخصصة. إغلاق اللوحة لا يوقفه ويُشعرك عند الانتهاء؛ إعادة الفتح تحفظ الحالة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-81",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 13956,
      "width": 900,
      "height": 50,
      "zIndex": 80,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "17 · الصور واللقطات والقص",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-82",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14018,
      "width": 900,
      "height": 50,
      "zIndex": 81,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "استيراد صورة · لقطة شاشة",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-83",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14080,
      "width": 900,
      "height": 170,
      "zIndex": 82,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اختر اللقطة من +/الشريط واسحب منطقة. Esc/الزر الأيمن وتغيير العمل/الصفحة وانتهاء المهلة يلغي. تُدرج الصورة بنسبة أصلية في مركز العرض دون مجلد لقطات مستقل. ألصق Win+Shift+S عبر Ctrl+V.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-84",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14262,
      "width": 900,
      "height": 170,
      "zIndex": 83,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اسحب PNG/JPG/BMP من المستكشف ثم حرّك أو غيّر الحجم أو دوّر. قص الصورة/استعادة الأصل بقائمة اللون يستخدم مستطيلًا ببكسلات الأصل ويحافظ عليه. الالتقاط المدمج يستخدم نتيجته، لا صور الحافظة غير المرتبطة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-85",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14500,
      "width": 900,
      "height": 50,
      "zIndex": 84,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "18 · دبابيس العرض والألوان",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-86",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14562,
      "width": 900,
      "height": 50,
      "zIndex": 85,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "علامة",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-87",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14624,
      "width": 900,
      "height": 170,
      "zIndex": 86,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "الدبوس العلوي يحفظ المركز والتكبير؛ اختر من القائمة للعودة. نقرتان على الدبوس/الاسم لإعادة التسمية، Enter/نقرة خارجية للحفظ، Esc للإلغاء. الزر الأيمن للاسم يدعمها أيضًا والتراجع متاح.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-88",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14806,
      "width": 900,
      "height": 140,
      "zIndex": 87,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "ألوان الدبوس والنص بالزر الأيمن أو الألوان في القائمة يغيّر كلًا منفصلًا. يحفظ Windows الحقول الاختيارية؛ قد يزيلها Mac قديم عند إعادة الحفظ.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-89",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14958,
      "width": 900,
      "height": 140,
      "zIndex": 88,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تبدأ نافذة الدبابيس بالإضافة مع تركيز اسم الدبوس الجديد، ثم البحث والقائمة أدناه. تستخدم القائمة رسم الدبوس نفسه ولون الجسم والنص الخاصين بكل دبوس كما على اللوحة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-90",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15166,
      "width": 900,
      "height": 50,
      "zIndex": 89,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "19 · لوحة الشاشة",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-91",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15228,
      "width": 900,
      "height": 440,
      "zIndex": 90,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "افتح من الرئيسية أو الرمز أو المزيد أو Ctrl+Alt+A. يحفظ العمل ويخفي النافذة؛ يبقى سطح المكتب نشطًا تحت تعليقات شفافة مستقلة. ثبّت على الحواف الأربع؛ تزداد الصفوف/الأعمدة دون تمرير وتبقى أزرار المسح والإغلاق. توجد ألوان وطبقات ولوحة ألوان؛ استخدم قائمة الأشكال لضبط التعبئة. الممحاة/الليزر مرة ثانية للإعدادات. تتبع الأدوات المشتركة المدعومة ترتيب وإظهار/إخفاء الشريط الرئيسي؛ لا تتوفر الدبابيس وقفل العرض هنا. قائمة الأشكال تضم الأنواع التسعة نفسها. مع أداة القلم، يثبت الخط شبه المستقيم بعد التوقف لثانية؛ تحريك المؤشر أكثر من 12 نقطة يعيد معاينة الرسم الحر.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-92",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15680,
      "width": 900,
      "height": 290,
      "zIndex": 91,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "رسم/تشغيل أو Ctrl+Alt+D يبدّل للتطبيق أسفلها. الزر الأيمن يعدل النمط وينسخ ويكرر ويحذف ويقفل ويرتب مع حفظ المجموعة المحددة. الفراغ يلغي الإجراء غير المكتمل فقط. Shift+نقرة/إطار يضيف حسب قاعدة الاحتواء/الملامسة. ارسم تحديدًا حرًا لتحديد العناصر المتقاطعة. التحديد يحرّك ويحجّم ويدوّر ويعدل الأطراف؛ Shift يقيد الخط/السهم أفقيًا أو عموديًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-93",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15982,
      "width": 900,
      "height": 200,
      "zIndex": 92,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "T ثم انقر للكتابة؛ Enter سطر، Ctrl+Enter/تم تأكيد، Esc إلغاء. نقرتان أو المزيد ← العناصر المحددة ← تحرير النص للتعديل. تغيير الأداة/الوضع واللقطة والتصدير والإنهاء يؤكد المسودة. تطبق الحقول المعدلة على غير المقفل وتعديلات المنزلق المتصلة تُتراجع معًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-94",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16194,
      "width": 900,
      "height": 290,
      "zIndex": 93,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "لقطة/Ctrl+Alt+S تجعل المنطقة المشروحة صورة في موضعها الأصلي دون مجلد مستقل. المزيد ← تصدير التعليقات يحفظ PNG شفافًا/.heiban؛ حفظ التعليقات يدوي. ×/Ctrl+Alt+Q يحفظ الجلسة ويعيد الرئيسية، وتُستأنف لاحقًا. السلة/Ctrl+Alt+K يمسح الكل بلا سؤال إضافي، والتراجع يستعيده. عند تعارض المفاتيح استخدم الشريط. لا تندمج التعليقات تلقائيًا في العمل الرئيسي.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-95",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16552,
      "width": 900,
      "height": 50,
      "zIndex": 94,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "20 · الحفظ والبيانات والتصدير",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-96",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16614,
      "width": 900,
      "height": 200,
      "zIndex": 95,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "إعدادات الرئيسية/المزيد تتحكم بالتلقائي، معطّل افتراضيًا وتُحفظ الاختيارات. تشغيله يحفظ العادي كل نحو15 ثانية والشاشة بعد توقف التغيير بثانية، ويؤجل الإجراء الجاري. تعطيله يوقف الدوري. Ctrl+S أو المزيد ← حفظ التعليقات للحفظ اليدوي.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-97",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16826,
      "width": 900,
      "height": 170,
      "zIndex": 96,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "العودة وتغيير العمل/الشاشة والإغلاق العادي تنتظر الحفظ مع مؤشر دوران. الفشل يُبقي النافذة والمحتوى. دون التلقائي قد يفقد التعطل أو انقطاع الكهرباء أو الإنهاء القسري التغييرات.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-98",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17008,
      "width": 900,
      "height": 230,
      "zIndex": 97,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "صدّر الصفحة أو المحدد أو العرض إلى .heiban/JSON/PNG/SVG/PDF/HTML. الأصل/JSON يحتفظ بكل الصفحات. PNG يستخدم عارض اللوحة؛ SVG يحتفظ بالمتجهات والصور وforeignObject (يتطلب دعم القارئ). PDF يحتاج Edge WebView2 ويضم المصدر القابل للتحرير؛ HTML دون اتصال مع JSON.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-99",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17250,
      "width": 900,
      "height": 200,
      "zIndex": 98,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "المثبت: %LOCALAPPDATA%\\HeiBan\\Windows\\؛ المحمول: Data/ بجانبه؛ Store: بيانات التطبيق الخاصة. أغلق طبيعيًا وانسخ المجلد كاملًا بأعماله وسلته وإعداداته قبل النقل. حافظ على المجلد المحمول كاملًا ولا تشغّل داخل ZIP.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-100",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17462,
      "width": 900,
      "height": 230,
      "zIndex": 99,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تقبل الصفحة الرئيسية ← استيراد ملفات PDF وPPTX وPPT. تتحول كل صفحة إلى صورة خلفية مقفلة في صفحة دفتر مستقلة للكتابة فوقها. اختر نطاقًا يصل إلى 200 صفحة و100 ميغابايت من الصور لكل استيراد. لا ينشئ الإلغاء عملًا ناقصًا. لا يصبح النص والأشكال الأصلية عناصر قابلة للتحرير.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-101",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17704,
      "width": 900,
      "height": 290,
      "zIndex": 100,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "يتطلب PPT/PPTX برنامج PowerPoint لسطح المكتب؛ وإلا حوّل الملف إلى PDF أولًا. قد تغيّر الخطوط المفقودة التخطيط. لا تُحفظ الرسوم المتحركة أو الفيديو أو الانتقالات أو التفاعل؛ وقد تفشل الملفات المشفرة أو التالفة. لتصدير الدفتر كاملًا اختر الصفحة الحالية/كل المحتوى وفعّل تصدير كل الصفحات إلى PDF. يظل تصدير العناصر المحددة أو العرض الحالي ضمن نطاقه.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-102",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18062,
      "width": 900,
      "height": 50,
      "zIndex": 101,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "21 · اختصارات لوحة المفاتيح",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-103",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18124,
      "width": 900,
      "height": 50,
      "zIndex": 102,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تراجع · إعادة · مسح هذه الصفحة",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-104",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18186,
      "width": 900,
      "height": 110,
      "zIndex": 103,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Ctrl+S حفظ، Ctrl+N جديد، Ctrl+Z/Ctrl+Y تراجع/إعادة، Ctrl+C/Ctrl+V نسخ/لصق عناصر أو صور، Delete حذف، Esc إلغاء إجراء/لقطة/شكل.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-105",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18308,
      "width": 900,
      "height": 170,
      "zIndex": 104,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Space+سحب أو الأوسط تحريك، عجلة/Ctrl+عجلة تكبير، V/P/E/T تحديد/قلم/ممحاة/نص، Win+Shift+S ثم Ctrl+V التقاط ولصق. الشاشة مع Ctrl+Alt: Aبدء، Dرسم/تشغيل، Sلقطة، Kمسح، Qإنهاء. عند التعارض استخدم الشريط.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-106",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18490,
      "width": 900,
      "height": 140,
      "zIndex": 105,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "ينتقل التراجع والإعادة بين خطوات التحرير. يطلب مسح الصفحة التأكيد ويحذف كائنات الصفحة الحالية ويمكن التراجع عنه؛ لا تتغير الصفحات الأخرى. يحذف Delete الكائنات المحددة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-107",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18698,
      "width": 900,
      "height": 50,
      "zIndex": 106,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "22 · تحديث التطبيق",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-108",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18760,
      "width": 900,
      "height": 200,
      "zIndex": 107,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "GitHub: الرئيسية ← حول ← إعدادات التحديث أو المزيد ← فحص التحديث وإعداداته. الفحص بعد نحو10 ثوان من البدء وكل ست ساعات أثناء التشغيل. عطّل التلقائي/المعاينات أو افحص يدويًا، فقط حين يكون مفتوحًا وبشكل مستقل عن الحفظ.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-109",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18972,
      "width": 900,
      "height": 230,
      "zIndex": 108,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تُطابق البنية والنوع وتُفحص الحجم وSHA-256. بعد الحفظ وإغلاق جميع نوافذ التثبيت، يثبت محدّث منفصل للتشغيل القادم دون إجبار الإغلاق/إعادة الفتح. الانقطاع أو عدم الاتصال أو الملفات المشغولة تُبقي النسخة لإعادة المحاولة. تعطيل التلقائي يمنع تطبيق الحزمة الجاهزة أيضًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-110",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19214,
      "width": 900,
      "height": 290,
      "zIndex": 109,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "المحمول يحافظ على Data وportable.dat والمجهول؛ المثبت يحافظ على موضع البيانات مع نسخ احتياطية. النتائج/المؤقت في %LOCALAPPDATA%\\HeiBan\\Updates\\، ولا تُرفع الأعمال. لا تنزع القرص أو الكهرباء أثناء التثبيت. Store يحدّث عبر المتجر فقط. التجزئة ليست توقيع Authenticode وقد يظهر تحذير Windows أول مرة. القديم يحتاج ترقية يدوية واحدة للحصول على المحدّث.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-111",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19572,
      "width": 900,
      "height": 50,
      "zIndex": 110,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "23 · النطاق والقيود",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-112",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19634,
      "width": 900,
      "height": 140,
      "zIndex": 111,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "وافق مسؤول المنتج على إعداد حزمة تحديث Windows 1.0.17 لمتجر Microsoft Store. يعتمد التوفر على اعتماد المتجر والنشر؛ راجع سجلات التطوير لتوافق الأجهزة والقيود المعروفة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-113",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19786,
      "width": 900,
      "height": 170,
      "zIndex": 112,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "مزامنة السحابة/Google والتعاون والخرائط الذهنية المتخصصة والجداول والصيغ والإطارات وتحرير PDF/SVG خارجي كأصل غير مقدمة. تُحفظ حقول JSON المجهولة. نص العمل بلغته الأصلية؛ الواجهة لا تترجمه.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-114",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20024,
      "width": 900,
      "height": 50,
      "zIndex": 113,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "24 · نصائح الخلفية",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-115",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20086,
      "width": 900,
      "height": 140,
      "zIndex": 114,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اختر النوع ثم الحجم المناسب والخلفية. غير المحدودة دون أبعاد؛ المحدودة تبدأ16:9 ويمكن تغييرها. السادة والخطوط والنقاط والشبكة والمدرج عند الإنشاء أو في الخلفية لاحقًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-116",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20238,
      "width": 900,
      "height": 110,
      "zIndex": 115,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تطبيق يؤكد، إلغاء يحافظ، والتراجع يستعيد. تتغير الورقة فقط لا ألوان الخطوط والنصوص الحالية.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-117",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20416,
      "width": 900,
      "height": 50,
      "zIndex": 116,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "25 · ترتيب الطبقات ومؤشرات العمل",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-118",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20478,
      "width": 900,
      "height": 50,
      "zIndex": 117,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "طبقات العناصر",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-119",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20540,
      "width": 900,
      "height": 230,
      "zIndex": 118,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "افتح طبقات العناصر من الشريط/المزيد؛ الصف الأعلى في الأمام. اسحب الشريطين الرماديين يسار الرمز إلى النصف العلوي/السفلي من صف آخر للإدراج قبله/بعده. يتلاشى الأصلي ويتبع الاسم/الرمز المؤشر، والخط الأخضر يحدد الوجهة. التسمية لا تغير الهوية، والفارغة تعيد الاسم التلقائي.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-120",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20782,
      "width": 900,
      "height": 170,
      "zIndex": 119,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "المخفي يبقى متاحًا والقفل يمنع التحريك/الحذف الجماعي. الخصائص والطبقات لوحتان منفصلتان. مؤشرات الاتجاه/الدوران والحفظ والدوائر المختارة ونطاق الممحاة توضح الإجراء. أبلغ عن خلل التجربة قبل اعتماد تحديث رسمي.",
      "fontSize": 18
    }
  ]
}