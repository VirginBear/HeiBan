    {
      "id": "quickstart-ar-72",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "stroke",
      "x": 66,
      "y": 14715,
      "width": 610,
      "height": 42,
      "zIndex": 71,
      "strokeColor": "#4189c7",
      "strokeWidth": 6,
      "fillColor": "none",
