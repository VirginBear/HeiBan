    {
      "id": "quickstart-ar-75",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 14946,
      "width": 900,
      "height": 50,
      "zIndex": 74,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "14 · المسطرة",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-76",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15008,
      "width": 900,
      "height": 50,
      "zIndex": 75,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "مسطرة",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-77",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15070,
      "width": 900,
      "height": 170,
      "zIndex": 76,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اسحب الجسم للتحريك ومقابض الأطراف للدوران. انقل المحور الذهبي إلى أي حافة رسم أو طرف؛ يدور حوله. الزر الأيمن/الإعدادات يضبط الحافة وموضع0–100% وزاوية0.1° والعتامة والطول.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-78",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15252,
      "width": 900,
      "height": 140,
      "zIndex": 77,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "الطول20–150% من عرض اللوحة، افتراضي90%، ويتكيف مع النافذة. الخط الذي يبدأ قرب الحافة يلتزم محورها طوال الرسم حتى خارج طول المسطرة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-79",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15404,
      "width": 900,
      "height": 170,
      "zIndex": 78,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "طول مسطرة الشاشة الافتراضي 640. اسحب المركز للتحريك والحافتين للتمديد ومقبضي الطرفين للدوران. يمكن ضبط الطول والمحور والعتامة والزاوية. يبقى الخط المبدوء على الحافة مثبتًا بها، أما الخط البعيد فيبقى حرًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-80",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15642,
      "width": 900,
      "height": 50,
      "zIndex": 79,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "15 · الفرجار: إعداد وقفل ورسم",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-81",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15704,
      "width": 900,
      "height": 50,
      "zIndex": 80,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "فرجار",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-82",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15766,
      "width": 900,
      "height": 110,
      "zIndex": 81,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "حرّك المركز ونصف القطر والطرف لتجهيز الموضع والزاوية دون عنصر. انقر المركز فيصبح برتقاليًا ويُقفل المركز ونصف القطر.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-83",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 15888,
      "width": 900,
      "height": 170,
      "zIndex": 82,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اسحب الطرف على المحيط لمعاينة قوس موجه مستمر عند عبور0°. أفلت لإنشاء قوس قابل للتحرير وعملية تراجع واحدة. النقرة الساكنة لا تنشئ شيئًا. للقوس حجم متناسب ودوران ومقابض زوايا البداية والنهاية.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-84",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16070,
      "width": 900,
      "height": 140,
      "zIndex": 83,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تتيح إعدادات فرجار الشاشة التوسيط ونصف القطر والزوايا وقفل الرسم والدائرة الكاملة وإعادة الضبط. اسحب الطرف لمعاينة القوس واتركه لإنشاء عنصر قابل للتحرير.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-85",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16278,
      "width": 900,
      "height": 50,
      "zIndex": 84,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "16 · تنبيهات الدرس: الليزر والعصا",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-86",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16340,
      "width": 900,
      "height": 50,
      "zIndex": 85,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "ليزر · عصا راتان",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-87",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 16402,
      "width": 900,
      "height": 680,
      "zIndex": 86,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اختر من الشريط/المزيد وانقر الليزر النشط ثانية لضبط نقطة أو أثر قصير أو خط ولون وقطر وسُمك وزمن تلاشي وقلب أبيض. متاح أيضًا على الشاشة. اضغط باستمرار على زر الفأرة الأيسر لإظهار الليزر. يؤدي الإفلات أو الإلغاء أو مغادرة اللوحة إلى مسح النقطة والمسار؛ لا يصدر ضوء عند التحريك دون ضغط. لا يحدد وضع الليزر عناصر بالنقر المزدوج أو الأيمن أو من قائمة الطبقات. اختر التحديد (V) قبل التحرير. يشترك الليزر مع القلم في الألوان الشائعة: اضبط اللون واضغط + لحفظه، واستخدم الإدارة للحذف أو استعادة الافتراضي. تُحفظ اللوحة اللونية وتُشارك بين اللوحتين. يظل التحديد والليزر والعصا متجاورة في كل التبويبات ولا يمكن إخفاؤها أو فصلها. يحتفظ المزيد فقط بإظهار العصا لاختصارها السفلي، دون تكرار الأداة. انقر الاختصار لاختيار العصا أو بالزر الأيمن لإخفائه ثم أعده من المزيد. تتبع العصا المؤشر من المقبض السفلي الأيمن، وتستقر عند 45° وترتفع إلى 75° ثم تعود بارتداد خفيف. كل نقرة يسار تشغّل ضربة واحدة دون عناصر محفوظة أو خطوات تراجع.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-88",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17094,
      "width": 900,
      "height": 110,
      "zIndex": 87,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "أثناء الضغط يتلاشى المسار حسب الإعدادات، وتبقى النقطة الحالية ظاهرة عند الثبات. لا ينشئ الليزر عناصر محفوظة أو عمليات تراجع.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-89",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17216,
      "width": 900,
      "height": 140,
      "zIndex": 88,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "من المزيد ← كتم صوت العصا، أو قائمة العصا في أسفل اليمين، يمكنك إيقاف الصوت. تتشارك اللوحتان هذا الإعداد المحفوظ بعد إعادة التشغيل أيضًا. تستمر حركة العصا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-90",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17368,
      "width": 900,
      "height": 380,
      "zIndex": 89,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "حدد العصا ثم انقر زرها في شريط الأدوات مجددًا لفتح إعداد كتم الصوت. يعمل ذلك في كلتا اللوحتين. ثلاث نقرات بالعصا خلال 1.2 ثانية في منطقة الشاشة نفسها ضمن36 DIP تُظهر تشققًا مؤقتًا عند الطرف مع صوت تكسر. لا يتغير العمل. كتم العصا يكتم التكسر أيضًا. تغيير الأداة أو الوضع أو مغادرة اللوحة يعيد تسلسل النقرات. تستخدم الضربات المتتابعة صوتي هجوم ثم صوت تكسر في الضربة الثالثة مع الاحتفاظ بذيل التفتت. ترافق الشق الأصغر شظايا قليلة تدور وتسقط وتتلاشى؛ يبقى التأثير مؤقتًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-91",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17816,
      "width": 900,
      "height": 50,
      "zIndex": 90,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "17 · الحاسبة والمؤقت",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-92",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17878,
      "width": 900,
      "height": 50,
      "zIndex": 91,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "آلة حاسبة · المؤقت وساعة الإيقاف",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-93",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 17940,
      "width": 900,
      "height": 140,
      "zIndex": 92,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "افتح من + واسحب العنوان أو اطوِ اللوحة. الحاسبة تدعم الأقواس والدوال العلمية وπ وe وAns ولوحة المفاتيح/Enter. إدراج التعبير فقط ينشئ عنصر نص.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-94",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18092,
      "width": 900,
      "height": 110,
      "zIndex": 93,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "المؤقت يدعم ساعة إيقاف و5/15/25 دقيقة وثواني مخصصة. إغلاق اللوحة لا يوقفه ويُشعرك عند الانتهاء؛ إعادة الفتح تحفظ الحالة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-95",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18214,
      "width": 900,
      "height": 170,
      "zIndex": 94,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تستخدم الحاسبة والمؤقت نوافذ عائمة مستقلة. اسحب العنوان للتحريك واضغط − للطي والتوسيع و× للإغلاق. تُدرج المعادلة أو الوقت بعد اكتمال المسح مع خطوات تراجع مستقلة. تؤدي مغادرة لوحة الشاشة إلى إيقاف المؤقت مؤقتًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-96",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18452,
      "width": 900,
      "height": 50,
      "zIndex": 95,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "18 · الصور واللقطات والقص",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-97",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18514,
      "width": 900,
      "height": 80,
      "zIndex": 96,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "استيراد صورة · لقطة شاشة · التقاط منطقة اللوحة",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-98",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18606,
      "width": 900,
      "height": 170,
      "zIndex": 97,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اختر اللقطة من +/الشريط واسحب منطقة. Esc/الزر الأيمن وتغيير العمل/الصفحة وانتهاء المهلة يلغي. تُدرج الصورة بنسبة أصلية في مركز العرض دون مجلد لقطات مستقل. ألصق Win+Shift+S عبر Ctrl+V.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-99",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18788,
      "width": 900,
      "height": 170,
      "zIndex": 98,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اسحب PNG/JPG/BMP من المستكشف ثم حرّك أو غيّر الحجم أو دوّر. قص الصورة/استعادة الأصل بقائمة اللون يستخدم مستطيلًا ببكسلات الأصل ويحافظ عليه. الالتقاط المدمج يستخدم نتيجته، لا صور الحافظة غير المرتبطة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-100",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 18970,
      "width": 900,
      "height": 290,
      "zIndex": 99,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "ينسخ أمر التقاط منطقة اللوحة في إدارة صورة مباشرة. يلتقط كامل الصفحة الحالية في A4 واللوحات المحدودة حتى خارج العرض. في الملاحظات اللانهائية اسحب منطقة واترك الزر، وللإلغاء اضغط Esc أو الزر الأيمن. تتضمن الصورة الخلفية والشبكة وعناصر الصفحة الظاهرة دون شريط الأدوات أو إطار التحديد. الصقها في تطبيق آخر وأضف الأمر إلى المفضلة عند الحاجة. يظل إدراج لقطة سطح المكتب أمرًا منفصلًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-101",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19272,
      "width": 900,
      "height": 110,
      "zIndex": 100,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "بعد نسخ الصورة بنجاح تظهر «تم التقاط اللوحة» في الوسط لنحو ثانيتين دون حجب الإدخال. لا تظهر رسالة نجاح عند الإلغاء أو الفشل.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-102",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19450,
      "width": 900,
      "height": 50,
      "zIndex": 101,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "19 · دبابيس العرض والألوان",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-103",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19512,
      "width": 900,
      "height": 50,
      "zIndex": 102,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "علامة",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-104",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19574,
      "width": 900,
      "height": 170,
      "zIndex": 103,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "الدبوس العلوي يحفظ المركز والتكبير؛ اختر من القائمة للعودة. نقرتان على الدبوس/الاسم لإعادة التسمية، Enter/نقرة خارجية للحفظ، Esc للإلغاء. الزر الأيمن للاسم يدعمها أيضًا والتراجع متاح.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-105",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19756,
      "width": 900,
      "height": 140,
      "zIndex": 104,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "ألوان الدبوس والنص بالزر الأيمن أو الألوان في القائمة يغيّر كلًا منفصلًا. يحفظ Windows الحقول الاختيارية؛ قد يزيلها Mac قديم عند إعادة الحفظ.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-106",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 19908,
      "width": 900,
      "height": 140,
      "zIndex": 105,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تبدأ نافذة الدبابيس بالإضافة مع تركيز اسم الدبوس الجديد، ثم البحث والقائمة أدناه. تستخدم القائمة رسم الدبوس نفسه ولون الجسم والنص الخاصين بكل دبوس كما على اللوحة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-107",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20116,
      "width": 900,
      "height": 50,
      "zIndex": 106,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "20 · لوحة الشاشة",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-108",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20178,
      "width": 900,
      "height": 440,
      "zIndex": 107,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "افتح من الرئيسية أو الرمز أو المزيد أو Ctrl+Alt+A. يحفظ العمل ويخفي النافذة؛ يبقى سطح المكتب نشطًا تحت تعليقات شفافة مستقلة. ثبّت على الحواف الأربع؛ تزداد الصفوف/الأعمدة دون تمرير وتبقى أزرار المسح والإغلاق. توجد ألوان وطبقات ولوحة ألوان؛ استخدم قائمة الأشكال لضبط التعبئة. الممحاة/الليزر مرة ثانية للإعدادات. تتبع الأدوات المشتركة المدعومة ترتيب وإظهار/إخفاء الشريط الرئيسي؛ لا تتوفر الدبابيس وقفل العرض هنا. قائمة الأشكال تضم الأنواع التسعة نفسها. مع أداة القلم، يثبت الخط شبه المستقيم بعد التوقف لثانية؛ تحريك المؤشر أكثر من 12 نقطة يعيد معاينة الرسم الحر.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-109",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20630,
      "width": 900,
      "height": 290,
      "zIndex": 108,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "رسم/تشغيل أو Ctrl+Alt+D يبدّل للتطبيق أسفلها. الزر الأيمن يعدل النمط وينسخ ويكرر ويحذف ويقفل ويرتب مع حفظ المجموعة المحددة. الفراغ يلغي الإجراء غير المكتمل فقط. Shift+نقرة/إطار يضيف حسب قاعدة الاحتواء/الملامسة. ارسم تحديدًا حرًا لتحديد العناصر المتقاطعة. التحديد يحرّك ويحجّم ويدوّر ويعدل الأطراف؛ Shift يقيد الخط/السهم أفقيًا أو عموديًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-110",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 20932,
      "width": 900,
      "height": 200,
      "zIndex": 109,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "T ثم انقر للكتابة؛ Enter سطر، Ctrl+Enter/تم تأكيد، Esc إلغاء. نقرتان أو المزيد ← العناصر المحددة ← تحرير النص للتعديل. تغيير الأداة/الوضع واللقطة والتصدير والإنهاء يؤكد المسودة. تطبق الحقول المعدلة على غير المقفل وتعديلات المنزلق المتصلة تُتراجع معًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-111",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 21144,
      "width": 900,
      "height": 290,
      "zIndex": 110,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "لقطة/Ctrl+Alt+S تجعل المنطقة المشروحة صورة في موضعها الأصلي دون مجلد مستقل. المزيد ← تصدير التعليقات يحفظ PNG شفافًا/.heiban؛ حفظ التعليقات يدوي. ×/Ctrl+Alt+Q يحفظ الجلسة ويعيد الرئيسية، وتُستأنف لاحقًا. السلة/Ctrl+Alt+K يمسح الكل بلا سؤال إضافي، والتراجع يستعيده. عند تعارض المفاتيح استخدم الشريط. لا تندمج التعليقات تلقائيًا في العمل الرئيسي.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-112",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 21502,
      "width": 900,
      "height": 50,
      "zIndex": 111,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "21 · الحفظ والبيانات والتصدير",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-113",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 21564,
      "width": 900,
      "height": 200,
      "zIndex": 112,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "إعدادات الرئيسية/المزيد تتحكم بالتلقائي، معطّل افتراضيًا وتُحفظ الاختيارات. تشغيله يحفظ العادي كل نحو15 ثانية والشاشة بعد توقف التغيير بثانية، ويؤجل الإجراء الجاري. تعطيله يوقف الدوري. Ctrl+S أو المزيد ← حفظ التعليقات للحفظ اليدوي.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-114",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 21776,
      "width": 900,
      "height": 170,
      "zIndex": 113,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "العودة وتغيير العمل/الشاشة والإغلاق العادي تنتظر الحفظ مع مؤشر دوران. الفشل يُبقي النافذة والمحتوى. دون التلقائي قد يفقد التعطل أو انقطاع الكهرباء أو الإنهاء القسري التغييرات.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-115",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 21958,
      "width": 900,
      "height": 230,
      "zIndex": 114,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "صدّر الصفحة أو المحدد أو العرض إلى .heiban/JSON/PNG/SVG/PDF/HTML. الأصل/JSON يحتفظ بكل الصفحات. PNG يستخدم عارض اللوحة؛ SVG يحتفظ بالمتجهات والصور وforeignObject (يتطلب دعم القارئ). PDF يحتاج Edge WebView2 ويضم المصدر القابل للتحرير؛ HTML دون اتصال مع JSON.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-116",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 22200,
      "width": 900,
      "height": 200,
      "zIndex": 115,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "المثبت: %LOCALAPPDATA%\\HeiBan\\Windows\\؛ المحمول: Data/ بجانبه؛ Store: بيانات التطبيق الخاصة. أغلق طبيعيًا وانسخ المجلد كاملًا بأعماله وسلته وإعداداته قبل النقل. حافظ على المجلد المحمول كاملًا ولا تشغّل داخل ZIP.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-117",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 22412,
      "width": 900,
      "height": 230,
      "zIndex": 116,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تقبل الصفحة الرئيسية ← استيراد ملفات PDF وPPTX وPPT. تتحول كل صفحة إلى صورة خلفية مقفلة في صفحة دفتر مستقلة للكتابة فوقها. اختر نطاقًا يصل إلى 200 صفحة و100 ميغابايت من الصور لكل استيراد. لا ينشئ الإلغاء عملًا ناقصًا. لا يصبح النص والأشكال الأصلية عناصر قابلة للتحرير.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-118",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 22654,
      "width": 900,
      "height": 290,
      "zIndex": 117,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "يتطلب PPT/PPTX برنامج PowerPoint لسطح المكتب؛ وإلا حوّل الملف إلى PDF أولًا. قد تغيّر الخطوط المفقودة التخطيط. لا تُحفظ الرسوم المتحركة أو الفيديو أو الانتقالات أو التفاعل؛ وقد تفشل الملفات المشفرة أو التالفة. لتصدير الدفتر كاملًا اختر الصفحة الحالية/كل المحتوى وفعّل تصدير كل الصفحات إلى PDF. يظل تصدير العناصر المحددة أو العرض الحالي ضمن نطاقه.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-119",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23012,
      "width": 900,
      "height": 50,
      "zIndex": 118,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "22 · اختصارات لوحة المفاتيح",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-120",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23074,
      "width": 900,
      "height": 50,
      "zIndex": 119,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تراجع · إعادة · مسح هذه الصفحة",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-121",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23136,
      "width": 900,
      "height": 110,
      "zIndex": 120,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Ctrl+S حفظ، Ctrl+N جديد، Ctrl+Z/Ctrl+Y تراجع/إعادة، Ctrl+C/Ctrl+V نسخ/لصق عناصر أو صور، Delete حذف، Esc إلغاء إجراء/لقطة/شكل.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-122",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23258,
      "width": 900,
      "height": 170,
      "zIndex": 121,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "Space+سحب أو الأوسط تحريك، عجلة/Ctrl+عجلة تكبير، V/P/E/T تحديد/قلم/ممحاة/نص، Win+Shift+S ثم Ctrl+V التقاط ولصق. الشاشة مع Ctrl+Alt: Aبدء، Dرسم/تشغيل، Sلقطة، Kمسح، Qإنهاء. عند التعارض استخدم الشريط.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-123",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23440,
      "width": 900,
      "height": 140,
      "zIndex": 122,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "ينتقل التراجع والإعادة بين خطوات التحرير. يطلب مسح الصفحة التأكيد ويحذف كائنات الصفحة الحالية ويمكن التراجع عنه؛ لا تتغير الصفحات الأخرى. يحذف Delete الكائنات المحددة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-124",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23648,
      "width": 900,
      "height": 50,
      "zIndex": 123,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "23 · تحديث التطبيق",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-125",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23710,
      "width": 900,
      "height": 200,
      "zIndex": 124,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "GitHub: الرئيسية ← حول ← إعدادات التحديث أو المزيد ← فحص التحديث وإعداداته. الفحص بعد نحو10 ثوان من البدء وكل ست ساعات أثناء التشغيل. عطّل التلقائي/المعاينات أو افحص يدويًا، فقط حين يكون مفتوحًا وبشكل مستقل عن الحفظ.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-126",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 23922,
      "width": 900,
      "height": 230,
      "zIndex": 125,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تُطابق البنية والنوع وتُفحص الحجم وSHA-256. بعد الحفظ وإغلاق جميع نوافذ التثبيت، يثبت محدّث منفصل للتشغيل القادم دون إجبار الإغلاق/إعادة الفتح. الانقطاع أو عدم الاتصال أو الملفات المشغولة تُبقي النسخة لإعادة المحاولة. تعطيل التلقائي يمنع تطبيق الحزمة الجاهزة أيضًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-127",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24164,
      "width": 900,
      "height": 290,
      "zIndex": 126,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "المحمول يحافظ على Data وportable.dat والمجهول؛ المثبت يحافظ على موضع البيانات مع نسخ احتياطية. النتائج/المؤقت في %LOCALAPPDATA%\\HeiBan\\Updates\\، ولا تُرفع الأعمال. لا تنزع القرص أو الكهرباء أثناء التثبيت. Store يحدّث عبر المتجر فقط. التجزئة ليست توقيع Authenticode وقد يظهر تحذير Windows أول مرة. القديم يحتاج ترقية يدوية واحدة للحصول على المحدّث.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-128",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24522,
      "width": 900,
      "height": 50,
      "zIndex": 127,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "24 · النطاق والقيود",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-129",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24584,
      "width": 900,
      "height": 140,
      "zIndex": 128,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "وافق مسؤول المنتج على إعداد حزمة تحديث Windows 1.0.18 لمتجر Microsoft Store. يعتمد التوفر على اعتماد المتجر والنشر؛ راجع سجلات التطوير لتوافق الأجهزة والقيود المعروفة.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-130",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24736,
      "width": 900,
      "height": 170,
      "zIndex": 129,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "مزامنة السحابة/Google والتعاون والخرائط الذهنية المتخصصة والجداول والصيغ والإطارات وتحرير PDF/SVG خارجي كأصل غير مقدمة. تُحفظ حقول JSON المجهولة. نص العمل بلغته الأصلية؛ الواجهة لا تترجمه.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-131",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 24974,
      "width": 900,
      "height": 50,
      "zIndex": 130,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "25 · نصائح الخلفية",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-132",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 25036,
      "width": 900,
      "height": 140,
      "zIndex": 131,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "اختر النوع ثم الحجم المناسب والخلفية. غير المحدودة دون أبعاد؛ المحدودة تبدأ16:9 ويمكن تغييرها. السادة والخطوط والنقاط والشبكة والمدرج عند الإنشاء أو في الخلفية لاحقًا.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-133",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 25188,
      "width": 900,
      "height": 110,
      "zIndex": 132,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "تطبيق يؤكد، إلغاء يحافظ، والتراجع يستعيد. تتغير الورقة فقط لا ألوان الخطوط والنصوص الحالية.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-134",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 25366,
      "width": 900,
      "height": 50,
      "zIndex": 133,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "26 · ترتيب الطبقات ومؤشرات العمل",
      "fontSize": 28
    },
    {
      "id": "quickstart-ar-135",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 25428,
      "width": 900,
      "height": 50,
      "zIndex": 134,
      "strokeColor": "#57816c",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "طبقات العناصر",
      "fontSize": 17
    },
    {
      "id": "quickstart-ar-136",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 25490,
      "width": 900,
      "height": 230,
      "zIndex": 135,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "افتح طبقات العناصر من الشريط/المزيد؛ الصف الأعلى في الأمام. اسحب الشريطين الرماديين يسار الرمز إلى النصف العلوي/السفلي من صف آخر للإدراج قبله/بعده. يتلاشى الأصلي ويتبع الاسم/الرمز المؤشر، والخط الأخضر يحدد الوجهة. التسمية لا تغير الهوية، والفارغة تعيد الاسم التلقائي.",
      "fontSize": 18
    },
    {
      "id": "quickstart-ar-137",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "text",
      "x": 40,
      "y": 25732,
      "width": 900,
      "height": 170,
      "zIndex": 136,
      "strokeColor": "#24533d",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false,
      "text": "المخفي يبقى متاحًا والقفل يمنع التحريك/الحذف الجماعي. الخصائص والطبقات لوحتان منفصلتان. مؤشرات الاتجاه/الدوران والحفظ والدوائر المختارة ونطاق الممحاة توضح الإجراء. أبلغ عن خلل التجربة قبل اعتماد تحديث رسمي.",
      "fontSize": 18
    }
  ]
}