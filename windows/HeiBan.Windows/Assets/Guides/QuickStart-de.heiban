      "width": 110,
      "height": 110,
      "zIndex": 47,
      "strokeColor": "#4189c7",
      "strokeWidth": 4,
      "fillColor": "none",
      "opacity": 1,
      "isLocked": false
    },
    {
      "id": "quickstart-de-49",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
      "type": "triangle",
      "x": 474,
      "y": 12730,
      "width": 160,
