33193073,\"pressure\":1},{\"x\":460,\"y\":11155.207212095665,\"pressure\":1},{\"x\":470,\"y\":11151.839683336659,\"pressure\":1},{\"x\":480,\"y\":11148.979523543929,\"pressure\":1},{\"x\":490,\"y\":11146.804563600424,\"pressure\":1},{\"x\":500,\"y\":11145.45003198119,\"pressure\":1},{\"x\":510,\"y\":11145.000146901739,\"pressure\":1},{\"x\":520,\"y\":11145.48288003733,\"pressure\":1},{\"x\":530,\"y\":11146.868217379673,\"pressure\":1},{\"x\":540,\"y\":11149.070025362593,\"pressure\":1},{\"x\":550,\"y\":11151.951406229993,\"pressure\":1},{\"x\":560,\"y\":11155.333209675284,\"pressure\":1},{\"x\":570,\"y\":11159.005171539731,\"pressure\":1},{\"x\":580,\"y\":11162.738987019467,\"pressure\":1},{\"x\":590,\"y\":11166.3025055524,\"pressure\":1},{\"x\":600,\"y\":11169.474164815774,\"pressure\":1},{\"x\":610,\"y\":11172.056766398275,\"pressure\":1},{\"x\":620,\"y\":11173.88973664213,\"pressure\":1},{\"x\":630,\"y\":11174.859110335423,\"pressure\":1},{\"x\":640,\"y\":11174.904616516991,\"pressure\":1},{\"x\":650,\"y\":11174.023425832871,\"pressure\":1},{\"x\":660,\"y\":11172.27032645182,\"pressure\":1}]"
