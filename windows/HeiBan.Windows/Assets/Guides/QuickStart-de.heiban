      "points": "[{\"x\": 554, \"y\": 12730}, {\"x\": 474, \"y\": 12840}, {\"x\": 634, \"y\": 12840}]"
    },
    {
      "id": "quickstart-de-50",
      "boardId": "heiban-windows-quickstart-v2",
      "pageId": "quickstart-all-tools",
