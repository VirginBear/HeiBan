{
  "entities": {
    "board": {
      "title": "Board",
      "description": "A collaborative vector blackboard / whiteboard canvas document",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerPhoto": { "type": "string", "maxLength": 500 },
        "backgroundColor": { "type": "string", "maxLength": 30 },
        "gridStyle": { "type": "string", "enum": ["grid", "dots", "lines", "blank"] },
        "boardTheme": { "type": "string", "enum": ["blackboard", "dark", "whiteboard", "slate"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "ownerId", "backgroundColor", "gridStyle"]
    },
    "boardObject": {
      "title": "BoardObject",
      "description": "An individual vector stroke, shape, text, sticky note, or image element on the board",
      "type": "object",
      "properties": {
        "boardId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["stroke", "highlighter", "rect", "circle", "triangle", "diamond", "arrow", "line", "star", "text", "sticky", "image", "pin"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "points": { "type": "string", "maxLength": 50000 },
        "strokeColor": { "type": "string", "maxLength": 40 },
        "fillColor": { "type": "string", "maxLength": 40 },
        "strokeWidth": { "type": "number" },
        "opacity": { "type": "number" },
        "rotation": { "type": "number" },
        "zIndex": { "type": "number" },
        "text": { "type": "string", "maxLength": 5000 },
        "fontSize": { "type": "number" },
        "fontFamily": { "type": "string", "maxLength": 50 },
        "imageUrl": { "type": "string", "maxLength": 500000 },
        "isLocked": { "type": "boolean" },
        "isVisible": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["boardId", "type", "x", "y", "createdBy", "zIndex"]
    },
    "userPresence": {
      "title": "UserPresence",
      "description": "Live presence and real-time cursor coordinate tracking for board collaborators",
      "type": "object",
      "properties": {
        "boardId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "cursorX": { "type": "number" },
        "cursorY": { "type": "number" },
        "color": { "type": "string", "maxLength": 30 },
        "isDrawing": { "type": "boolean" },
        "currentTool": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["boardId", "userId", "displayName", "cursorX", "cursorY"]
    }
  },
  "firestore": {
    "/boards/{boardId}": {
      "schema": "board",
      "description": "Collaborative whiteboard canvas configurations and metadata"
    },
    "/boards/{boardId}/objects/{objectId}": {
      "schema": "boardObject",
      "description": "Movable, transformable vector elements and strokes belonging to a board"
    },
    "/boards/{boardId}/presences/{userId}": {
      "schema": "userPresence",
      "description": "Collaborator live presence and mouse tracking positions"
    }
  }
}
