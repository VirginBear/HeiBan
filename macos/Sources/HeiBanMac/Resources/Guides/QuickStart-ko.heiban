    {
      "id": "mac-guide-ko-59",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 13450,
      "width": 1200,
      "height": 100,
      "rotation": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 3,
      "fillColor": "none",
      "opacity": 1,
      "zIndex": 59,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "12 · 지우개",
      "fontSize": 34,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
    {
      "id": "mac-guide-ko-60",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 13570,
      "width": 1120,
      "height": 800,
      "rotation": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 3,
      "fillColor": "none",
      "opacity": 1,
      "zIndex": 60,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "지우개는 개체와 획 부분 지우기 및 누르기 전 범위 표시를 지원합니다. 그림·글·메모·잠긴 개체는 보호됩니다. 일반 캔버스의 기울어진 판 지우개는 그림과 같은 반전 윤곽으로 지웁니다. 우클릭으로 모드 변경·숨기기, 더 보기에서 다시 표시합니다. 한 드래그는 한 번의 실행 취소이며 Esc로 취소합니다. 이미지 픽셀 편집은 아닙니다.\n가이드를 열면 기존 연습을 유지합니다. 새 연습 만들기는 이전 내용을 보존하며 별도 작품을 만듭니다. 지우기는 드래그 중 미리 보기이며 손을 놓으면 한 번 확정됩니다. Esc, 도구 또는 작품 전환은 미완료 지우기를 취소합니다.",
      "fontSize": 20,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
    {
      "id": "mac-guide-ko-61",
