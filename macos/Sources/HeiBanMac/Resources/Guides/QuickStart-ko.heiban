    },
    {
      "id": "mac-guide-ko-5",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 1470,
      "width": 1120,
      "height": 800,
      "rotation": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 3,
      "fillColor": "none",
      "opacity": 1,
      "zIndex": 5,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "계정 및 설정에서 언어를 선택합니다. 도움말도 해당 언어로 열립니다. 이 페이지의 언어 선택은 앱 설정을 바꾸지 않으며 작품 이름과 본문은 번역하지 않습니다.",
      "fontSize": 20,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
