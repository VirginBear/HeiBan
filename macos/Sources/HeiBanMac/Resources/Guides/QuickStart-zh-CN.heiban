    },
    {
      "id": "mac-guide-zh-CN-85",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 19070,
      "width": 1120,
      "height": 800,
      "rotation": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 3,
      "fillColor": "none",
      "opacity": 1,
      "zIndex": 85,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "⌘V或拖入图片。导入.heiban/JSON、PDF、PPT/PPTX/Keynote；简报需Keynote与自动化授权，只转临时副本不改原档，亦可先转PDF。最多200页／图片100MB，可选范围及取消。外部文件变锁定图片，原文元素／动画影片不保留。PDF可出目前或全部页并附完整原稿（含其他页及隐藏对象），只分享可见内容请PNG；续编请留.heiban。正常退出等待保存。",
      "fontSize": 20,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
