    {
      "id": "mac-guide-zh-TW-124",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 27750,
      "width": 1200,
      "height": 100,
      "rotation": 0,
      "strokeColor": "#24533d",
