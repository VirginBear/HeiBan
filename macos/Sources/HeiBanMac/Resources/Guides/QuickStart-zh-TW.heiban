    {
      "id": "mac-guide-zh-TW-64",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 14550,
      "width": 1200,
      "height": 100,
      "rotation": 0,
      "strokeColor": "#24533d",
