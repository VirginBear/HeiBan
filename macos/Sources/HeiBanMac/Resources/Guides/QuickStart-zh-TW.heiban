    {
      "id": "mac-guide-zh-TW-2",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 210,
      "width": 1280,
      "height": 200,
      "rotation": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 3,
      "fillColor": "none",
      "opacity": 1,
      "zIndex": 2,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "一般開啟指南會保留上次練習；「建立新的操作指南練習」建立新作品，舊內容保留。橡皮擦拖曳只預覽，放開提交一次；Esc、切工具或切作品取消未完成的擦除。",
      "fontSize": 20,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
