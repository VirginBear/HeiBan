    {
      "id": "mac-guide-zh-TW-74",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 16750,
      "width": 1200,
      "height": 100,
      "rotation": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 3,
      "fillColor": "none",
      "opacity": 1,
      "zIndex": 74,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "15 · 雷射筆",
      "fontSize": 34,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
    {
      "id": "mac-guide-zh-TW-75",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 16870,
      "width": 1120,
      "height": 800,
      "rotation": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 3,
      "fillColor": "none",
      "opacity": 1,
      "zIndex": 75,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "點雷射筆啟用；移動滑鼠即可顯示光點與尾跡，按住拖曳也可以。\n再點一次雷射筆按鈕，開啟設定；右鍵也有設定入口。\n選光點、短尾跡或線條；光點模式刻意沒有尾跡。\n調整光點直徑、尾跡粗細、消退時間、色彩和白色亮芯。\n切換其他工具即可停止。\n光點以螢幕 pt 顯示，不因畫布縮放變大或變小。短尾跡最長 0.8 秒；線條可保留到設定的消退時間。設定保存在本機偏好。\n雷射是暫時演示效果，不加入作品、不作為永久筆畫匯出。螢幕截圖則會捕捉截圖當下仍可見的光點。\n雷射尾跡以連續平滑輪廓及柔光顯示；光點大小、尾跡寬度及淡出時間可分別調整。",
      "fontSize": 20,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
    {
      "id": "mac-guide-zh-TW-76",
