    {
      "id": "mac-guide-zh-TW-19",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 4650,
      "width": 1200,
      "height": 100,
      "rotation": 0,
      "strokeColor": "#24533d",
