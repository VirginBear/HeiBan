    {
      "id": "mac-guide-zh-TW-79",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 17850,
      "width": 1200,
      "height": 100,
      "rotation": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 3,
      "fillColor": "none",
      "opacity": 1,
      "zIndex": 79,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "16 · 計算機與計時器",
      "fontSize": 34,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
    {
      "id": "mac-guide-zh-TW-80",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 17970,
      "width": 1120,
      "height": 800,
      "rotation": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 3,
      "fillColor": "none",
      "opacity": 1,
      "zIndex": 80,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "遮題膠帶：工具列的眼睛遮蔽圖示可建立膠帶，拖曳覆蓋答案。閱讀模式點膠帶揭示／再次遮住，適合講課提問；編輯模式可選取調整範圍。\n計算機：上方＋ → 計算機。浮動面板提供一般／科學計算與歷史；拖標題移動，點按鍵操作。關閉後仍可再從＋呼叫。\n計時器：＋ → 計時器。選倒數／計時、輸入時間或選預設，按開始、暫停、重設；關閉後可再次叫回。計時狀態與面板顯示分開管理。\n移動面板請拖標題區；按輸入區或按鈕只操作內容，不會觸發整個面板的移動。",
      "fontSize": 20,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
