      "fillColor": "none",
      "opacity": 1,
      "zIndex": 64,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "13 · 尺規",
      "fontSize": 34,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
    {
      "id": "mac-guide-zh-TW-65",
      "boardId": "heiban-macos-quickstart-v3",
      "type": "text",
      "x": 100,
      "y": 14670,
      "width": 1120,
      "height": 800,
      "rotation": 0,
      "strokeColor": "#24533d",
      "strokeWidth": 3,
      "fillColor": "none",
      "opacity": 1,
      "zIndex": 65,
      "createdAt": "2026-10-23T00:00:00Z",
      "updatedAt": "2026-10-23T00:00:00Z",
      "isLocked": false,
      "text": "啟用尺規；拖尺身移動。\n拖旋轉把手調整角度；設定中亦可直接輸入角度，精度到小數點後一位。\n尺上有刻度；配色預設自適應背景，也可自行指定，亮底與暗底均需保持可讀。\n用畫筆沿尺邊繪製，尺規會約束線段方向。\n尺規設定可從工具按鈕的設定入口開啟；輔助尺是暫時工具，不會出現在匯出圖片中。",
      "fontSize": 20,
      "fontFamily": "PingFang TC",
      "align": "left"
    },
